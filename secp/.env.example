# secp — environment (12-factor; copy to .env and adjust)

# HTTP listen
PORT=8080
FMR_WORKERS=4
# FMR_SYNC=1            # single-threaded serve (debugging)

# JWT session secret (HS256) — REQUIRED in production
JWT_SECRET=change-me

# Postgres (default backend)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=bagatest
PGPASSWORD=pas+123
PGDATABASE=secp

# boilaDB backend (alternative): uncomment and point at boilaDB PG wire
# ORM_BACKEND=boila
# BOILA_PGHOST=127.0.0.1
# BOILA_PGPORT=6575
# BOILA_PGUSER=boila
# BOILA_TOKEN=
# BOILA_PGDATABASE=secp

# Content-addressed blobs (relative to the process cwd). Not the source tree.
SECP_DATA_ROOT=./storage
# Празен = blob-овете са открит текст (както до Фаза 7).
# 64 hex знака (32 байта): новите файлове са AES-GCM с ключ на пространство.
# SECP_MASTER_KEY=
# SECP_MAX_FILE_MB=100
# SECP_QUOTA_MB=1024
# SECP_VERSIONS_KEEP=20

# Търсене (Фаза 6): таван на извлечения за индекса текст, в KiB (0 = без таван)
# SECP_TEXT_MAX_KB=1024

# Scheduler (Фаза 6): интервал на tick-а в ms; 0 изключва фоновите задачи
# SECP_SCHED_MS=5000

# Realtime (Фаза 3). Празен SECP_WS_PORT = HTTP порт + 1. 0 изключва канала.
# SECP_WS_PORT=8086
# SECP_WS_POLL_MS=500
# SECP_WS_PING_MS=30000
# SECP_WS_MSG_MAX=4096
# SECP_WS_SUBS_MAX=50

# Поща (Фаза 6.3). Без SMTP_HOST пощата е изключена и приложението работи.
# SMTP_TLS: starttls (деф., порт 587) | tls (порт 465) | plain (порт 25)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2525
# SMTP_TLS=plain
# SMTP_FROM=no-reply@7x7.local
# SMTP_USER=
# SMTP_PASS=
# SMTP_HELO=
# SMTP_TIMEOUT_S=30
# SMTP_INSECURE=1        # приема самоподписан сертификат — САМО за dev

# Публичен адрес за линковете в писмата и за WOPI (reset, welcome, Collabora)
# SECP_PUBLIC_URL=http://127.0.0.1:3010
# Срок на WOPI токена, в минути (деф. 60)
# SECP_WOPI_TTL_MIN=60
# Срок на линка за смяна на паролата, в минути (деф. 60)
# SECP_RESET_TTL_MIN=60

# First-run admin seed (idempotent; skipped when the email exists)
SECP_ADMIN_EMAIL=admin@secp.local
SECP_ADMIN_PASSWORD=admin123
SECP_ADMIN_NAME=Admin

# PBKDF2-HMAC-SHA256 iterations for new password hashes (min 1000)
SECP_PASS_ITERS=10000
