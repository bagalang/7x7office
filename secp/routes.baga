// Route ids (stable; never reorder casually — OpenAPI operationIds use them)
fn RID_HEALTH() -> i64 { return 1 }
fn RID_READY() -> i64 { return 2 }
fn RID_META() -> i64 { return 3 }
fn RID_OPENAPI() -> i64 { return 4 }
fn RID_METRICS() -> i64 { return 5 }
fn RID_UI_HOME() -> i64 { return 6 }
fn RID_UI_LOGIN() -> i64 { return 7 }
fn RID_LOGIN() -> i64 { return 10 }
fn RID_LOGOUT() -> i64 { return 11 }
fn RID_ME() -> i64 { return 12 }
fn RID_FS_LIST() -> i64 { return 20 }
fn RID_FS_STAT() -> i64 { return 21 }
fn RID_FS_MKDIR() -> i64 { return 22 }
fn RID_FS_PUT() -> i64 { return 23 }
fn RID_FS_GET() -> i64 { return 24 }
fn RID_FS_DELETE() -> i64 { return 25 }
fn RID_FS_MOVE() -> i64 { return 26 }
fn RID_FS_THUMB() -> i64 { return 27 }
fn RID_FS_USAGE() -> i64 { return 28 }
fn RID_USERS_LIST() -> i64 { return 30 }
fn RID_USERS_CREATE() -> i64 { return 31 }
fn RID_FS_PREVIEW() -> i64 { return 32 }
fn RID_DOC_LOAD() -> i64 { return 33 }
fn RID_DOC_SAVE() -> i64 { return 34 }
fn RID_FS_VERSIONS() -> i64 { return 35 }
fn RID_FS_VERSION_GET() -> i64 { return 36 }
fn RID_FS_VERSION_RESTORE() -> i64 { return 37 }
fn RID_FS_ZIP_LIST() -> i64 { return 38 }
fn RID_FS_ZIP_GET() -> i64 { return 39 }
fn RID_SEARCH() -> i64 { return 40 }
fn RID_SEARCH_REINDEX() -> i64 { return 41 }
fn RID_FORGOT() -> i64 { return 42 }
fn RID_RESET() -> i64 { return 43 }
fn RID_WS_LIST() -> i64 { return 44 }
fn RID_WS_CREATE() -> i64 { return 45 }
fn RID_WS_UPDATE() -> i64 { return 46 }
fn RID_WS_DELETE() -> i64 { return 47 }
fn RID_WS_MEMBERS() -> i64 { return 48 }
fn RID_WS_MEMBER_ADD() -> i64 { return 49 }
fn RID_WS_MEMBER_UPDATE() -> i64 { return 50 }
fn RID_WS_MEMBER_REMOVE() -> i64 { return 51 }
fn RID_FS_ACL_LIST() -> i64 { return 52 }
fn RID_FS_ACL_SET() -> i64 { return 53 }
fn RID_FS_ACL_DELETE() -> i64 { return 54 }
fn RID_FS_SHARE_LIST() -> i64 { return 55 }
fn RID_FS_SHARE_CREATE() -> i64 { return 56 }
fn RID_FS_SHARE_REVOKE() -> i64 { return 57 }
fn RID_SHARE_META() -> i64 { return 58 }
fn RID_SHARE_UNLOCK() -> i64 { return 59 }
fn RID_SHARE_VIEW() -> i64 { return 60 }
fn RID_SHARE_DOWNLOAD() -> i64 { return 61 }
fn RID_SHARE_UPLOAD() -> i64 { return 62 }
fn RID_ACTIVITY() -> i64 { return 63 }
fn RID_CHAT_LIST() -> i64 { return 64 }
fn RID_CHAT_POST() -> i64 { return 65 }
fn RID_DAV() -> i64 { return 66 }
fn RID_REPORT_STORAGE() -> i64 { return 67 }
fn RID_REPORT_ACTIVITY() -> i64 { return 68 }
fn RID_WOPI_TOKEN() -> i64 { return 69 }
fn RID_WOPI_FILE() -> i64 { return 70 }
fn RID_WOPI_CONTENTS() -> i64 { return 71 }

fn fmr_build_app() -> FmrApp !IO {
    let cfg = fmr_config_load()?
    let mut app = fmr_app_new(cfg.title, cfg.version)
    app = fmr_app_with_config(app, cfg)
    app = fmr_route_meta(app, "GET", "/health", RID_HEALTH(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/ready", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/readyz", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/meta", RID_META(), "", "system", 1, "", "Meta", "200", "")
    app = fmr_route_meta(app, "GET", "/openapi.json", RID_OPENAPI(), "", "system", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/metrics", RID_METRICS(), "", "system", 0, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/", RID_UI_HOME(), "", "ui", 1, "", "HomePage", "200", "")
    app = fmr_route_meta(app, "GET", "/login", RID_UI_LOGIN(), "", "ui", 1, "", "LoginPage", "200", "error")
    app = fmr_route_meta(app, "POST", "/v1/auth/login", RID_LOGIN(), "", "auth", 1, "LoginRequest", "TokenResponse", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/logout", RID_LOGOUT(), "", "auth", 1, "", "-", "303", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/forgot", RID_FORGOT(), "", "auth", 1, "ForgotRequest", "Message", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/reset", RID_RESET(), "", "auth", 1, "ResetRequest", "Message", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/me", RID_ME(), "", "auth", 0, "", "Me", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/users", RID_USERS_LIST(), "", "idm", 0, "", "UserList", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/users", RID_USERS_CREATE(), "", "idm", 0, "UserCreate", "User", "201", "")
    app = fmr_route_meta(app, "GET", "/v1/workspaces", RID_WS_LIST(), "", "idm", 0, "", "WorkspaceList", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/workspaces", RID_WS_CREATE(), "", "idm", 0, "WorkspaceCreate", "Workspace", "201", "")
    app = fmr_route_meta(app, "PATCH", "/v1/workspaces", RID_WS_UPDATE(), "", "idm", 0, "WorkspaceUpdate", "Workspace", "200", "workspace_id")
    app = fmr_route_meta(app, "DELETE", "/v1/workspaces", RID_WS_DELETE(), "", "idm", 0, "", "-", "204", "workspace_id")
    app = fmr_route_meta(app, "GET", "/v1/workspaces/members", RID_WS_MEMBERS(), "", "idm", 0, "", "MemberList", "200", "workspace_id")
    app = fmr_route_meta(app, "POST", "/v1/workspaces/members", RID_WS_MEMBER_ADD(), "", "idm", 0, "MemberAdd", "Member", "201", "workspace_id")
    app = fmr_route_meta(app, "PATCH", "/v1/workspaces/members", RID_WS_MEMBER_UPDATE(), "", "idm", 0, "MemberUpdate", "Member", "200", "workspace_id,member_id")
    app = fmr_route_meta(app, "DELETE", "/v1/workspaces/members", RID_WS_MEMBER_REMOVE(), "", "idm", 0, "", "-", "204", "workspace_id,member_id")
    app = fmr_route_meta(app, "GET", "/v1/fs/list", RID_FS_LIST(), "", "fs", 0, "", "NodeList", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/stat", RID_FS_STAT(), "", "fs", 0, "", "Node", "200", "path")
    app = fmr_route_meta(app, "POST", "/v1/fs/mkdir", RID_FS_MKDIR(), "", "fs", 0, "", "Node", "201", "path")
    app = fmr_route_meta(app, "PUT", "/v1/fs/file", RID_FS_PUT(), "", "fs", 0, "bytes", "Node", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/file", RID_FS_GET(), "", "fs", 0, "", "bytes", "200", "path")
    app = fmr_route_meta(app, "DELETE", "/v1/fs/file", RID_FS_DELETE(), "", "fs", 0, "", "-", "204", "path")
    app = fmr_route_meta(app, "POST", "/v1/fs/move", RID_FS_MOVE(), "", "fs", 0, "", "Node", "200", "from,to")
    app = fmr_route_meta(app, "GET", "/v1/fs/thumb", RID_FS_THUMB(), "", "fs", 0, "", "bytes", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/usage", RID_FS_USAGE(), "", "fs", 0, "", "Usage", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/fs/preview", RID_FS_PREVIEW(), "", "fs", 0, "", "Preview", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/doc/load", RID_DOC_LOAD(), "", "doc", 0, "", "DocContent", "200", "path")
    app = fmr_route_meta(app, "PUT", "/v1/doc/save", RID_DOC_SAVE(), "", "doc", 0, "text", "Node", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/versions", RID_FS_VERSIONS(), "", "fs", 0, "", "VersionList", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/version/get", RID_FS_VERSION_GET(), "", "fs", 0, "", "bytes", "200", "path,version")
    app = fmr_route_meta(app, "POST", "/v1/fs/version/restore", RID_FS_VERSION_RESTORE(), "", "fs", 0, "", "Node", "200", "path,version")
    app = fmr_route_meta(app, "GET", "/v1/fs/zip/list", RID_FS_ZIP_LIST(), "", "fs", 0, "", "ZipList", "200", "path")
    app = fmr_route_meta(app, "GET", "/v1/fs/zip/get", RID_FS_ZIP_GET(), "", "fs", 0, "", "bytes", "200", "path,entry")
    app = fmr_route_meta(app, "GET", "/v1/search", RID_SEARCH(), "", "fs", 0, "", "SearchList", "200", "q")
    app = fmr_route_meta(app, "POST", "/v1/search/reindex", RID_SEARCH_REINDEX(), "", "fs", 0, "", "ReindexResult", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/fs/acl", RID_FS_ACL_LIST(), "", "fs", 0, "", "AclList", "200", "path")
    app = fmr_route_meta(app, "POST", "/v1/fs/acl", RID_FS_ACL_SET(), "", "fs", 0, "AclSet", "AclRow", "200", "workspace_id")
    app = fmr_route_meta(app, "DELETE", "/v1/fs/acl", RID_FS_ACL_DELETE(), "", "fs", 0, "", "-", "204", "acl_id")
    // Фаза 3: activity feed (само четене; пишат го самите действия).
    app = fmr_route_meta(app, "GET", "/v1/activity", RID_ACTIVITY(), "", "fs", 0, "", "ActivityList", "200", "limit,path,actor_id")
    app = fmr_route_meta(app, "GET", "/v1/reports/storage", RID_REPORT_STORAGE(), "", "reports", 0, "", "StorageReport", "200", "format,lang")
    app = fmr_route_meta(app, "GET", "/v1/reports/activity", RID_REPORT_ACTIVITY(), "", "reports", 0, "", "ActivityReport", "200", "format,lang")
    app = fmr_route_meta(app, "GET", "/v1/wopi/token", RID_WOPI_TOKEN(), "", "wopi", 0, "", "WopiToken", "200", "path")
    app = fmr_route_meta(app, "GET", "/wopi/files/{id}", RID_WOPI_FILE(), "", "wopi", 1, "", "CheckFileInfo", "200", "")
    app = fmr_route_meta(app, "POST", "/wopi/files/{id}", RID_WOPI_FILE(), "", "wopi", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/wopi/files/{id}/contents", RID_WOPI_CONTENTS(), "", "wopi", 1, "", "bytes", "200", "")
    app = fmr_route_meta(app, "POST", "/wopi/files/{id}/contents", RID_WOPI_CONTENTS(), "", "wopi", 1, "bytes", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/chat", RID_CHAT_LIST(), "", "chat", 0, "", "ChatList", "200", "limit")
    app = fmr_route_meta(app, "POST", "/v1/chat", RID_CHAT_POST(), "", "chat", 0, "ChatPost", "ChatMessage", "201", "")
    // WebDAV: един id, два шаблона (корен и {*path}). public=1 — Basic е в handler-а.
    app = fmr_route_meta(app, "OPTIONS", "/dav/{ws}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "OPTIONS", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "PROPFIND", "/dav/{ws}", RID_DAV(), "", "dav", 1, "", "-", "207", "")
    app = fmr_route_meta(app, "PROPFIND", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "207", "")
    app = fmr_route_meta(app, "GET", "/dav/{ws}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "HEAD", "/dav/{ws}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "HEAD", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "PUT", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "201", "")
    app = fmr_route_meta(app, "DELETE", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "204", "")
    app = fmr_route_meta(app, "MKCOL", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "201", "")
    app = fmr_route_meta(app, "COPY", "/dav/{ws}", RID_DAV(), "", "dav", 1, "", "-", "201", "")
    app = fmr_route_meta(app, "COPY", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "201", "")
    app = fmr_route_meta(app, "MOVE", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "201", "")
    app = fmr_route_meta(app, "PROPPATCH", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "405", "")
    app = fmr_route_meta(app, "LOCK", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "405", "")
    app = fmr_route_meta(app, "UNLOCK", "/dav/{ws}/{*path}", RID_DAV(), "", "dav", 1, "", "-", "405", "")
    // Фаза 3: собственик управлява линковете; публичните /s/* са без Bearer.
    app = fmr_route_meta(app, "GET", "/v1/fs/share", RID_FS_SHARE_LIST(), "", "fs", 0, "", "ShareList", "200", "path")
    app = fmr_route_meta(app, "POST", "/v1/fs/share", RID_FS_SHARE_CREATE(), "", "fs", 0, "ShareCreate", "ShareLink", "201", "workspace_id")
    app = fmr_route_meta(app, "DELETE", "/v1/fs/share", RID_FS_SHARE_REVOKE(), "", "fs", 0, "", "-", "204", "share_id")
    app = fmr_route_meta(app, "GET", "/s/{token}", RID_SHARE_META(), "", "share", 1, "", "ShareMeta", "200", "")
    app = fmr_route_meta(app, "POST", "/s/{token}/unlock", RID_SHARE_UNLOCK(), "", "share", 1, "ShareUnlock", "SharePass", "200", "")
    app = fmr_route_meta(app, "GET", "/s/{token}/view", RID_SHARE_VIEW(), "", "share", 1, "", "ShareView", "200", "path")
    app = fmr_route_meta(app, "GET", "/s/{token}/download", RID_SHARE_DOWNLOAD(), "", "share", 1, "", "bytes", "200", "path")
    app = fmr_route_meta(app, "PUT", "/s/{token}/upload", RID_SHARE_UPLOAD(), "", "share", 1, "bytes", "Node", "200", "path,name")
    return app
}

fn fmr_before(ctx: FmrCtx) -> DepResult {
    return dep_ok(ctx)
}

// secp has no gRPC surface yet — dual hook returns empty unimplemented.
fn fmr_grpc_handle(path: str, body: bytes, db: OrmDb) -> FmrOut !IO !Net !Time {
    let mut r = http_response_bytes(200, bytes_new(0))
    r = http_set_header(r, "Content-Type", "application/grpc")
    r = http_set_header(r, "grpc-status", "12")
    r = http_set_header(r, "grpc-message", "UNIMPLEMENTED")
    return fmr_out(r, db)
}

fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random !Time {
    let id = ctx.route_id
    if id == RID_HEALTH() { return act_health(ctx, db) }
    if id == RID_READY() { return act_ready(ctx, db)? }
    if id == RID_META() { return act_meta(ctx, db) }
    if id == RID_OPENAPI() { return act_openapi(ctx, db) }
    if id == RID_METRICS() { return act_metrics(ctx, db)? }
    if id == RID_UI_HOME() { return act_ui_home(ctx, db) }
    if id == RID_UI_LOGIN() { return act_ui_login(ctx, db) }
    if id == RID_LOGIN() { return act_login(ctx, db)? }
    if id == RID_LOGOUT() { return act_logout(ctx, db) }
    if id == RID_FORGOT() { return act_forgot(ctx, db)? }
    if id == RID_RESET() { return act_reset(ctx, db)? }
    if id == RID_ME() { return act_me(ctx, db)? }
    if id == RID_USERS_LIST() { return act_users_list(ctx, db)? }
    if id == RID_USERS_CREATE() { return act_users_create(ctx, db)? }
    if id == RID_WS_LIST() { return act_ws_list(ctx, db)? }
    if id == RID_WS_CREATE() { return act_ws_create(ctx, db)? }
    if id == RID_WS_UPDATE() { return act_ws_update(ctx, db)? }
    if id == RID_WS_DELETE() { return act_ws_delete(ctx, db)? }
    if id == RID_WS_MEMBERS() { return act_ws_members(ctx, db)? }
    if id == RID_WS_MEMBER_ADD() { return act_ws_member_add(ctx, db)? }
    if id == RID_WS_MEMBER_UPDATE() { return act_ws_member_update(ctx, db)? }
    if id == RID_WS_MEMBER_REMOVE() { return act_ws_member_remove(ctx, db)? }
    if id == RID_FS_LIST() { return act_fs_list(ctx, db)? }
    if id == RID_FS_STAT() { return act_fs_stat(ctx, db)? }
    if id == RID_FS_MKDIR() { return act_fs_mkdir(ctx, db)? }
    if id == RID_FS_PUT() { return act_fs_put(ctx, db)? }
    if id == RID_FS_GET() { return act_fs_get(ctx, db)? }
    if id == RID_FS_DELETE() { return act_fs_delete(ctx, db)? }
    if id == RID_FS_MOVE() { return act_fs_move(ctx, db)? }
    if id == RID_FS_THUMB() { return act_fs_thumb(ctx, db)? }
    if id == RID_FS_USAGE() { return act_fs_usage(ctx, db)? }
    if id == RID_FS_PREVIEW() { return act_fs_preview(ctx, db)? }
    if id == RID_DOC_LOAD() { return act_doc_load(ctx, db)? }
    if id == RID_DOC_SAVE() { return act_doc_save(ctx, db)? }
    if id == RID_FS_VERSIONS() { return act_fs_versions(ctx, db)? }
    if id == RID_FS_VERSION_GET() { return act_fs_version_get(ctx, db)? }
    if id == RID_FS_VERSION_RESTORE() { return act_fs_version_restore(ctx, db)? }
    if id == RID_FS_ZIP_LIST() { return act_fs_zip_list(ctx, db)? }
    if id == RID_FS_ZIP_GET() { return act_fs_zip_get(ctx, db)? }
    if id == RID_SEARCH() { return act_search(ctx, db)? }
    if id == RID_SEARCH_REINDEX() { return act_search_reindex(ctx, db)? }
    if id == RID_FS_ACL_LIST() { return act_fs_acl_list(ctx, db)? }
    if id == RID_FS_ACL_SET() { return act_fs_acl_set(ctx, db)? }
    if id == RID_FS_ACL_DELETE() { return act_fs_acl_delete(ctx, db)? }
    if id == RID_ACTIVITY() { return act_activity_list(ctx, db)? }
    if id == RID_REPORT_STORAGE() { return act_report_storage(ctx, db)? }
    if id == RID_REPORT_ACTIVITY() { return act_report_activity(ctx, db)? }
    if id == RID_WOPI_TOKEN() { return act_wopi_token(ctx, db)? }
    if id == RID_WOPI_FILE() { return act_wopi_file(ctx, db)? }
    if id == RID_WOPI_CONTENTS() { return act_wopi_contents(ctx, db)? }
    if id == RID_CHAT_LIST() { return act_chat_list(ctx, db)? }
    if id == RID_CHAT_POST() { return act_chat_post(ctx, db)? }
    if id == RID_DAV() { return act_dav(ctx, db)? }
    if id == RID_FS_SHARE_LIST() { return act_fs_share_list(ctx, db)? }
    if id == RID_FS_SHARE_CREATE() { return act_fs_share_create(ctx, db)? }
    if id == RID_FS_SHARE_REVOKE() { return act_fs_share_revoke(ctx, db)? }
    if id == RID_SHARE_META() { return act_share_meta(ctx, db)? }
    if id == RID_SHARE_UNLOCK() { return act_share_unlock(ctx, db)? }
    if id == RID_SHARE_VIEW() { return act_share_view(ctx, db)? }
    if id == RID_SHARE_DOWNLOAD() { return act_share_download(ctx, db)? }
    if id == RID_SHARE_UPLOAD() { return act_share_upload(ctx, db)? }
    return fmr_out(fmr_500("unhandled route"), db)
}
