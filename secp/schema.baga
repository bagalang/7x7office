// schema.baga — secp migrations (owned by the app, not the framework).
// Table names carry the module prefix (idm_*) — one owner per table, so the
// one owner module per table (README „Модулен монолит").
// Postgres set uses SERIAL; boila set is BoilaSQL-safe (explicit PK, no SERIAL).

import "ormbaga/migrate.baga"
import "std/os/os.baga"
import "schema_boila.baga"

fn secp_migrations() -> MigrationSet {
    let mut set = migrate_set_new()
    set = migrate_add(
        set,
        20260924001,
        "create_idm_users",
        "CREATE TABLE idm_users (id BIGSERIAL PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL DEFAULT '', pass_hash TEXT NOT NULL, pass_salt TEXT NOT NULL, pass_iters BIGINT NOT NULL DEFAULT 10000, is_admin BIGINT NOT NULL DEFAULT 0, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS idm_users"
    )
    set = migrate_add(
        set,
        20260924002,
        "create_idm_sessions",
        "CREATE TABLE idm_sessions (id BIGSERIAL PRIMARY KEY, user_id BIGINT NOT NULL REFERENCES idm_users(id) ON DELETE CASCADE, token_hash TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), expires_at TIMESTAMPTZ)",
        "DROP TABLE IF EXISTS idm_sessions"
    )
    set = migrate_add(
        set,
        20260924003,
        "index_idm_sessions_user_id",
        "CREATE INDEX index_idm_sessions_on_user_id ON idm_sessions (user_id)",
        "DROP INDEX IF EXISTS index_idm_sessions_on_user_id"
    )
    set = migrate_add(
        set,
        20260924004,
        "create_tree_nodes",
        "CREATE TABLE tree_nodes (id BIGSERIAL PRIMARY KEY, owner_id BIGINT NOT NULL REFERENCES idm_users(id) ON DELETE CASCADE, path TEXT NOT NULL, parent_path TEXT NOT NULL DEFAULT '/', name TEXT NOT NULL, is_dir BIGINT NOT NULL DEFAULT 0, size BIGINT NOT NULL DEFAULT 0, hash TEXT NOT NULL DEFAULT '', thumb_hash TEXT NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), UNIQUE (owner_id, path))",
        "DROP TABLE IF EXISTS tree_nodes"
    )
    set = migrate_add(
        set,
        20260924005,
        "index_tree_nodes_owner_parent",
        "CREATE INDEX index_tree_nodes_on_owner_parent ON tree_nodes (owner_id, parent_path)",
        "DROP INDEX IF EXISTS index_tree_nodes_on_owner_parent"
    )
    set = migrate_add(
        set,
        20260924006,
        "create_tree_versions",
        "CREATE TABLE tree_versions (id BIGSERIAL PRIMARY KEY, node_id BIGINT NOT NULL REFERENCES tree_nodes(id), owner_id BIGINT NOT NULL, path TEXT NOT NULL, size BIGINT NOT NULL DEFAULT 0, hash TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS tree_versions"
    )
    set = migrate_add(
        set,
        20260924007,
        "index_tree_versions_node",
        "CREATE INDEX index_tree_versions_on_node ON tree_versions (node_id)",
        "DROP INDEX IF EXISTS index_tree_versions_on_node"
    )
    // Фаза 6: извлечен текст за търсене. Отделен от tree_nodes, за да не
    // раздува метаданните; node_id е и PK (1:1 с файл). Трие се от модула
    // tree при триене на възел.
    set = migrate_add(
        set,
        20260924008,
        "create_tree_text",
        "CREATE TABLE tree_text (node_id BIGINT PRIMARY KEY, owner_id BIGINT NOT NULL, text TEXT NOT NULL DEFAULT '', updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS tree_text"
    )
    set = migrate_add(
        set,
        20260924009,
        "index_tree_text_owner",
        "CREATE INDEX index_tree_text_on_owner ON tree_text (owner_id)",
        "DROP INDEX IF EXISTS index_tree_text_on_owner"
    )
    // Фаза 6: фонови задачи (scheduler).
    set = migrate_add(
        set,
        20260924010,
        "create_ops_jobs",
        "CREATE TABLE ops_jobs (id BIGSERIAL PRIMARY KEY, kind TEXT NOT NULL, payload TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'pending', attempts BIGINT NOT NULL DEFAULT 0, run_at BIGINT NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS ops_jobs"
    )
    set = migrate_add(
        set,
        20260924011,
        "index_ops_jobs_status",
        "CREATE INDEX index_ops_jobs_on_status ON ops_jobs (status)",
        "DROP INDEX IF EXISTS index_ops_jobs_on_status"
    )
    // Фаза 6.3: reset на парола. Пази се САМО хешът на токена (SHA-256):
    // ако базата изтече, от хеша не може да се влезе. used_at прави
    // токена еднократен.
    set = migrate_add(
        set,
        20260924012,
        "create_idm_resets",
        "CREATE TABLE idm_resets (id BIGSERIAL PRIMARY KEY, user_id BIGINT NOT NULL REFERENCES idm_users(id) ON DELETE CASCADE, token_hash TEXT NOT NULL, expires_at TIMESTAMPTZ NOT NULL, used_at TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS idm_resets"
    )
    set = migrate_add(
        set,
        20260924013,
        "index_idm_resets_user_id",
        "CREATE INDEX index_idm_resets_on_user_id ON idm_resets (user_id)",
        "DROP INDEX IF EXISTS index_idm_resets_on_user_id"
    )
    // Фаза 2: workspaces + членство с роля. Personal workspace = един на
    // потребител (is_personal=1, slug `personal-<user_id>`), за да има всеки
    // „своя" контейнер още преди да е създал екипен. Ролята е фиксирана
    // тройка (owner/editor/viewer) — собствени роли са отделна стъпка.
    set = migrate_add(
        set,
        20260924014,
        "create_idm_workspaces",
        "CREATE TABLE idm_workspaces (id BIGSERIAL PRIMARY KEY, slug TEXT NOT NULL UNIQUE, label TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', is_personal BIGINT NOT NULL DEFAULT 0, owner_id BIGINT NOT NULL REFERENCES idm_users(id) ON DELETE CASCADE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS idm_workspaces"
    )
    set = migrate_add(
        set,
        20260924015,
        "create_idm_workspace_members",
        "CREATE TABLE idm_workspace_members (id BIGSERIAL PRIMARY KEY, workspace_id BIGINT NOT NULL REFERENCES idm_workspaces(id) ON DELETE CASCADE, user_id BIGINT NOT NULL REFERENCES idm_users(id) ON DELETE CASCADE, role TEXT NOT NULL DEFAULT 'viewer', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), UNIQUE (workspace_id, user_id))",
        "DROP TABLE IF EXISTS idm_workspace_members"
    )
    set = migrate_add(
        set,
        20260924016,
        "index_idm_workspace_members_user",
        "CREATE INDEX index_idm_workspace_members_on_user ON idm_workspace_members (user_id)",
        "DROP INDEX IF EXISTS index_idm_workspace_members_on_user"
    )
    // Фаза 2 (стъпка files): възлите вече принадлежат на workspace, не на
    // потребител. `owner_id` остава като „кой го е качил" (одит), но
    // СКОУПЪТ е workspace_id — иначе споделянето е само козметично.
    //
    // DEFAULT 0 е нарочно: старите редове получават 0, а backfill-ът при
    // boot ги мести в личния workspace на собственика. Не може да се
    // напише като SQL UPDATE…FROM, защото boilaDB няма INSERT/UPDATE със
    // SELECT (виж gaps) — затова е в кода, не в миграцията.
    set = migrate_add(
        set,
        20260924017,
        "add_tree_nodes_workspace_id",
        "ALTER TABLE tree_nodes ADD COLUMN workspace_id BIGINT NOT NULL DEFAULT 0",
        "ALTER TABLE tree_nodes DROP COLUMN workspace_id"
    )
    // Старият UNIQUE (owner_id, path) вече е ГРЕШЕН: един потребител може да
    // има едно и също име в личния си workspace и в екипен, а това са два
    // различни реда. Махаме го и слагаме индекса върху новия скоуп.
    set = migrate_add(
        set,
        20260924018,
        "drop_tree_nodes_owner_unique",
        "ALTER TABLE tree_nodes DROP CONSTRAINT IF EXISTS tree_nodes_owner_id_path_key",
        "ALTER TABLE tree_nodes ADD CONSTRAINT tree_nodes_owner_id_path_key UNIQUE (owner_id, path)"
    )
    set = migrate_add(
        set,
        20260924019,
        "index_tree_nodes_workspace_parent",
        "CREATE INDEX index_tree_nodes_on_workspace_parent ON tree_nodes (workspace_id, parent_path)",
        "DROP INDEX IF EXISTS index_tree_nodes_on_workspace_parent"
    )
    // Версиите и текстовият индекс са производни на възлите — те също
    // минават на workspace скоуп. Иначе версиите/търсенето на файлове от
    // екипен workspace остават „закачени" за потребител и се виждат
    // погрешно, когато членството се промени.
    set = migrate_add(
        set,
        20260924020,
        "add_tree_versions_workspace_id",
        "ALTER TABLE tree_versions ADD COLUMN workspace_id BIGINT NOT NULL DEFAULT 0",
        "ALTER TABLE tree_versions DROP COLUMN workspace_id"
    )
    set = migrate_add(
        set,
        20260924021,
        "add_tree_text_workspace_id",
        "ALTER TABLE tree_text ADD COLUMN workspace_id BIGINT NOT NULL DEFAULT 0",
        "ALTER TABLE tree_text DROP COLUMN workspace_id"
    )
    set = migrate_add(
        set,
        20260924022,
        "index_tree_text_workspace",
        "CREATE INDEX index_tree_text_on_workspace ON tree_text (workspace_id)",
        "DROP INDEX IF EXISTS index_tree_text_on_workspace"
    )
    // Фаза 2 (ACL): изрични права по ПЪТ. Ролята в пространството дава
    // базовото ниво; този ред го разширява или стеснява. `inherit=1` значи
    // „и за всичко под пътя". `kind` е 'user' или 'role' — subject-ът се
    // пази в две колони, за да е прост WHERE-ът (boila няма UNION в DML).
    //
    // ON DELETE CASCADE: изтрит workspace не бива да оставя права-духове,
    // които след преизползване на id-то (boila: MAX(id)+1) да важат за
    // друг. Правата на изтрит ВЪЗЕЛ се трият от кода (tree/acl_model.baga),
    // защото пътят не е FK.
    set = migrate_add(
        set,
        20260924023,
        "create_tree_acl",
        "CREATE TABLE tree_acl (id BIGSERIAL PRIMARY KEY, workspace_id BIGINT NOT NULL REFERENCES idm_workspaces(id) ON DELETE CASCADE, path TEXT NOT NULL, kind TEXT NOT NULL DEFAULT 'user', subject_user_id BIGINT NOT NULL DEFAULT 0, subject_role TEXT NOT NULL DEFAULT '', acl_level BIGINT NOT NULL DEFAULT 1, inherit BIGINT NOT NULL DEFAULT 1, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS tree_acl"
    )
    set = migrate_add(
        set,
        20260924024,
        "index_tree_acl_ws_path",
        "CREATE INDEX index_tree_acl_on_ws_path ON tree_acl (workspace_id, path)",
        "DROP INDEX IF EXISTS index_tree_acl_on_ws_path"
    )
    // Фаза 3 (share): публичен линк към възел. Пазим САМО хеша на токена
    // (като idm_resets — изтекъл dump не бива да дава достъп). `level`:
    // 1 = само четене/сваляне, 2 = качване/замяна в папката. Папката се
    // идентифицира по (workspace_id, path), а не по node_id, за да не
    // зависи линкът от преместване на възела; path-ът се проверява при
    // отваряне (изтрит възел → 404).
    set = migrate_add(
        set,
        20260924025,
        "create_share_links",
        "CREATE TABLE share_links (id BIGSERIAL PRIMARY KEY, token_hash TEXT NOT NULL, workspace_id BIGINT NOT NULL REFERENCES idm_workspaces(id) ON DELETE CASCADE, path TEXT NOT NULL, level BIGINT NOT NULL DEFAULT 1, expires_at BIGINT NOT NULL DEFAULT 0, pass_hash TEXT NOT NULL DEFAULT '', pass_salt TEXT NOT NULL DEFAULT '', pass_iters BIGINT NOT NULL DEFAULT 0, downloads BIGINT NOT NULL DEFAULT 0, max_downloads BIGINT NOT NULL DEFAULT 0, created_by BIGINT NOT NULL DEFAULT 0, revoked_at BIGINT NOT NULL DEFAULT 0, created_at BIGINT NOT NULL DEFAULT 0)",
        "DROP TABLE IF EXISTS share_links"
    )
    set = migrate_add(
        set,
        20260924026,
        "index_share_links_token",
        "CREATE UNIQUE INDEX index_share_links_on_token ON share_links (token_hash)",
        "DROP INDEX IF EXISTS index_share_links_on_token"
    )
    set = migrate_add(
        set,
        20260924027,
        "index_share_links_ws_path",
        "CREATE INDEX index_share_links_on_ws_path ON share_links (workspace_id, path)",
        "DROP INDEX IF EXISTS index_share_links_on_ws_path"
    )
    // Фаза 3 (activity feed): едно действие = един ред. APPEND-ONLY —
    // изтрит възел не трие историята си, иначе „кой изтри файла" изчезва
    // точно когато е най-нужно. Чисти се само с пространството.
    //
    // `ts` е epoch СЕКУНДИ (BIGINT), не TIMESTAMPTZ: подредбата трябва да е
    // еднаква на Postgres и BoilaDB, а последният няма NOW() в заявка (G23).
    // `path` е ДЕНОРМАЛИЗИРАН (не FK към tree_nodes): редът трябва да оцелее
    // след изтриването на възела, а преместването не бива да пренаписва
    // историята („беше в /a, сега е в /b" — това е смисълът на лога).
    set = migrate_add(
        set,
        20260924028,
        "create_activity",
        "CREATE TABLE activity (id BIGSERIAL PRIMARY KEY, workspace_id BIGINT NOT NULL, actor_id BIGINT NOT NULL DEFAULT 0, verb TEXT NOT NULL, node_id BIGINT NOT NULL DEFAULT 0, path TEXT NOT NULL DEFAULT '', meta TEXT NOT NULL DEFAULT '', ts BIGINT NOT NULL DEFAULT 0)",
        "DROP TABLE IF EXISTS activity"
    )
    set = migrate_add(
        set,
        20260924029,
        "index_activity_ws_ts",
        "CREATE INDEX index_activity_on_ws_ts ON activity (workspace_id, ts)",
        "DROP INDEX IF EXISTS index_activity_on_ws_ts"
    )
    set = migrate_add(
        set,
        20260924030,
        "index_activity_ws_path",
        "CREATE INDEX index_activity_on_ws_path ON activity (workspace_id, path)",
        "DROP INDEX IF EXISTS index_activity_on_ws_path"
    )
    // Фаза 3 (чат): една стая на пространство. ts е epoch секунди (G23).
    set = migrate_add(
        set,
        20260924031,
        "create_chat_messages",
        "CREATE TABLE chat_messages (id BIGSERIAL PRIMARY KEY, workspace_id BIGINT NOT NULL, author_id BIGINT NOT NULL, body TEXT NOT NULL, ts BIGINT NOT NULL DEFAULT 0)",
        "DROP TABLE IF EXISTS chat_messages"
    )
    set = migrate_add(
        set,
        20260924032,
        "index_chat_messages_ws_id",
        "CREATE INDEX index_chat_messages_on_ws_id ON chat_messages (workspace_id, id)",
        "DROP INDEX IF EXISTS index_chat_messages_on_ws_id"
    )
    // Фаза 4: WebDAV клас 2. expires_at е epoch секунди.
    set = migrate_add(
        set,
        20260925033,
        "create_dav_locks",
        "CREATE TABLE dav_locks (id BIGSERIAL PRIMARY KEY, workspace_id BIGINT NOT NULL, path TEXT NOT NULL, token TEXT NOT NULL, owner_id BIGINT NOT NULL, depth BIGINT NOT NULL, expires_at BIGINT NOT NULL, owner_xml TEXT NOT NULL DEFAULT '')",
        "DROP TABLE IF EXISTS dav_locks"
    )
    set = migrate_add(
        set,
        20260925034,
        "index_dav_locks_ws",
        "CREATE INDEX index_dav_locks_on_ws ON dav_locks (workspace_id, path)",
        "DROP INDEX IF EXISTS index_dav_locks_on_ws"
    )
    // Фаза 7: ключ на пространство. Суровият ключ не се пази — само пликът.
    set = migrate_add(
        set,
        20260925035,
        "create_data_keys",
        "CREATE TABLE data_keys (workspace_id BIGINT PRIMARY KEY, wrapped TEXT NOT NULL)",
        "DROP TABLE IF EXISTS data_keys"
    )
    set = migrate_add(
        set,
        20260925036,
        "create_wopi_locks",
        "CREATE TABLE wopi_locks (file_id BIGINT PRIMARY KEY, lock_id TEXT NOT NULL, expires_at BIGINT NOT NULL)",
        "DROP TABLE IF EXISTS wopi_locks"
    )
    // Глобални настройки (SMTP, S3). skey е уникален; празна стойност е
    // валидна. Флаговете smtp.saved и s3.saved казват, че секцията е от админа.
    set = migrate_add(
        set,
        20260926037,
        "create_sys_settings",
        "CREATE TABLE sys_settings (id BIGSERIAL PRIMARY KEY, skey TEXT NOT NULL UNIQUE, sval TEXT NOT NULL DEFAULT '')",
        "DROP TABLE IF EXISTS sys_settings"
    )
    set = migrate_add(
        set,
        20260926038,
        "index_sys_settings_skey",
        "CREATE INDEX index_sys_settings_on_skey ON sys_settings (skey)",
        "DROP INDEX IF EXISTS index_sys_settings_on_skey"
    )
    return set
}


fn secp_backend_is_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Pick migration set for the configured backend.
fn secp_migrations_auto() -> MigrationSet !IO {
    if secp_backend_is_boila()? == 1 {
        return secp_boila_migrations()
    }
    return secp_migrations()
}

