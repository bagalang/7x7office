// data/bakdump.baga — логически SQL dump на живата база и качване в S3.
//
// Като bagabuch: не се тарват LSM файловете. Тук редовете минават през
// SELECT, защото orm няма COPY TO STDOUT. Файловете на диска не влизат.

import "baklive.baga"
import "bufbaga/buf.baga"
import "s3baga/s3.baga"
import "ormbaga/orm.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn bak_ident(s: str) -> i64 {
    let n = len(s)
    if n < 1 || n > 63 {
        return 0
    }
    let c0 = char_at(s, 0)
    if c0 != 95 && (c0 < 65 || c0 > 90) && (c0 < 97 || c0 > 122) {
        return 0
    }
    let mut i: i64 = 1
    while i < n {
        let c = char_at(s, i)
        if c != 95 && (c < 48 || c > 57) && (c < 65 || c > 90) && (c < 97 || c > 122) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn bak_2(n: i64) -> str {
    if n < 10 {
        return concat("0", int_to_str(n))
    }
    return int_to_str(n)
}

// UTC от unix секунди. civil_from_days (Hinnant), само за неотрицателни дни.
fn bak_stamp_at(sec: i64) -> str {
    let days = sec / 86400
    let sod = sec % 86400
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let mut y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let mut m = mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    let hh = sod / 3600
    let mm = (sod % 3600) / 60
    let ss = sod % 60
    let mut b = buf_from(int_to_str(y))
    b = buf_push(b, bak_2(m))
    b = buf_push(b, bak_2(d))
    b = buf_push(b, "_")
    b = buf_push(b, bak_2(hh))
    b = buf_push(b, bak_2(mm))
    b = buf_push(b, bak_2(ss))
    return buf_str(b)
}

fn bak_stamp() -> str !Time {
    return bak_stamp_at(time_now_ms() / 1000)
}

fn bak_quote(s: str) -> str {
    let mut b = buf_from("'")
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        let c = char_at(s, i)
        if c == 39 {
            b = buf_push(b, "''")
        } else {
            b = buf_push_chr(b, c)
        }
        i = i + 1
    }
    b = buf_push(b, "'")
    return buf_str(b)
}

fn bak_row_sql(q: OrmQuery, row: i64, table: str) -> str {
    let nc = orm_ncols(q)
    let mut b = buf_from("INSERT INTO ")
    b = buf_push(b, table)
    b = buf_push(b, " (")
    let mut c: i64 = 0
    while c < nc {
        if c > 0 {
            b = buf_push(b, ", ")
        }
        b = buf_push(b, orm_colname(q, c))
        c = c + 1
    }
    b = buf_push(b, ") VALUES (")
    c = 0
    while c < nc {
        if c > 0 {
            b = buf_push(b, ", ")
        }
        if orm_isnull(q, row, c) == 1 {
            b = buf_push(b, "NULL")
        } else {
            b = buf_push(b, bak_quote(orm_cell(q, row, c)))
        }
        c = c + 1
    }
    b = buf_push(b, ");\n")
    return buf_str(b)
}

struct BakPiece {
    ok: i64,
    db: OrmDb,
    err: str,
    buf: StrBuf,
    rows: i64
}

fn bak_one_table(db: OrmDb, b: StrBuf, table: str) -> BakPiece !IO !Net {
    if bak_ident(table) == 0 {
        return BakPiece { ok: 1, db: db, err: "", buf: b, rows: 0 }
    }
    let mut out = b
    let create = orm_query(db, concat("SHOW CREATE TABLE ", table))?
    if orm_ok_q(create) == 0 {
        return BakPiece { ok: 0, db: orm_db_q(create), err: orm_err_q(create), buf: out, rows: 0 }
    }
    out = buf_push(out, "-- ")
    out = buf_push(out, table)
    out = buf_push(out, "\n")
    if orm_nrows(create) > 0 && orm_ncols(create) > 1 {
        let ddl = orm_cell(create, 0, 1)
        if ddl != "" {
            out = buf_push(out, ddl)
            if char_at(ddl, len(ddl) - 1) != 59 {
                out = buf_push(out, ";")
            }
            out = buf_push(out, "\n")
        }
    }
    let rows = orm_query(orm_db_q(create), concat("SELECT * FROM ", table))?
    if orm_ok_q(rows) == 0 {
        return BakPiece { ok: 0, db: orm_db_q(rows), err: orm_err_q(rows), buf: out, rows: 0 }
    }
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < orm_nrows(rows) {
        out = buf_push(out, bak_row_sql(rows, i, table))
        n = n + 1
        i = i + 1
    }
    out = buf_push(out, "\n")
    return BakPiece { ok: 1, db: orm_db_q(rows), err: "", buf: out, rows: n }
}

struct BakSql {
    ok: i64,
    db: OrmDb,
    err: str,
    sql: str,
    tables: i64,
    rows: i64
}

fn bak_sql(db: OrmDb) -> BakSql !IO !Net !Time {
    let q = orm_query(db, "SHOW TABLES")?
    if orm_ok_q(q) == 0 {
        return BakSql { ok: 0, db: orm_db_q(q), err: orm_err_q(q), sql: "", tables: 0, rows: 0 }
    }
    let mut names = vec_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        vec_push(names, orm_cell(q, i, 0))
        i = i + 1
    }
    let mut b = buf_from("-- 7x7office логически dump\n")
    b = buf_push(b, "-- ")
    b = buf_push(b, bak_stamp()?)
    b = buf_push(b, " UTC\n")
    b = buf_push(b, "-- Редовете са INSERT. Файловете на диска не са в този архив.\n\n")
    let mut d = orm_db_q(q)
    let mut tables: i64 = 0
    let mut rows: i64 = 0
    i = 0
    while i < vec_len(names) {
        let name = vec_get(names, i)
        let piece = bak_one_table(d, b, name)?
        if piece.ok == 0 {
            return BakSql { ok: 0, db: piece.db, err: piece.err, sql: "", tables: tables, rows: rows }
        }
        d = piece.db
        b = piece.buf
        if bak_ident(name) == 1 {
            tables = tables + 1
            rows = rows + piece.rows
        }
        i = i + 1
    }
    return BakSql { ok: 1, db: d, err: "", sql: buf_str(b), tables: tables, rows: rows }
}

struct BakUp {
    ok: i64,
    db: OrmDb,
    err: str,
    key: str,
    bytes: i64,
    tables: i64,
    rows: i64
}

fn bak_object_key(prefix: str, stamp: str) -> str {
    return concat(concat(concat(prefix, "/"), "7x7office_backup_"), concat(stamp, ".sql"))
}

// В кофата остават толкова последни архива. По-старите се трият след качване.
fn bak_keep() -> i64 {
    return 20
}

fn bak_find_from(s: str, needle: str, from: i64) -> i64 {
    if from < 0 || from > len(s) {
        return 0 - 1
    }
    let rest = substr(s, from, len(s))
    let i = str_find(rest, needle)
    if i < 0 {
        return 0 - 1
    }
    return from + i
}

fn bak_replace(s: str, a: str, b: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let rest = substr(s, i, len(s))
        if str_starts_with(rest, a) == 1 {
            out = concat(out, b)
            i = i + len(a)
        } else {
            out = concat(out, chr(char_at(s, i)))
            i = i + 1
        }
    }
    return out
}

fn bak_xml_unescape(s: str) -> str {
    let a = bak_replace(s, "&amp;", "&")
    let b = bak_replace(a, "&lt;", "<")
    let c = bak_replace(b, "&gt;", ">")
    let d = bak_replace(c, "&quot;", "\"")
    return bak_replace(d, "&apos;", "'")
}

fn bak_is_archive(prefix: str, key: str) -> i64 {
    let head = concat(concat(prefix, "/"), "7x7office_backup_")
    if str_starts_with(key, head) == 0 {
        return 0
    }
    if str_ends_with(key, ".sql") == 0 {
        return 0
    }
    return 1
}

// -1 ако a е по-стар от b, 0 равни, 1 ако a е по-нов. Печатът в името расте с времето.
fn bak_cmp(a: str, b: str) -> i64 {
    let mut n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let mut i: i64 = 0
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb {
            return 0 - 1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if len(a) < len(b) {
        return 0 - 1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}

fn bak_insert_desc(out: Vec<str>, cur: str) -> Vec<str> {
    let next = vec_new()
    let mut i: i64 = 0
    let mut placed: i64 = 0
    while i < vec_len(out) {
        if placed == 0 {
            if bak_cmp(cur, vec_get(out, i)) > 0 {
                vec_push(next, cur)
                placed = 1
            }
        }
        vec_push(next, vec_get(out, i))
        i = i + 1
    }
    if placed == 0 {
        vec_push(next, cur)
    }
    return next
}

fn bak_sort_desc(keys: Vec<str>) -> Vec<str> {
    let mut out = vec_new()
    let mut i: i64 = 0
    while i < vec_len(keys) {
        out = bak_insert_desc(out, vec_get(keys, i))
        i = i + 1
    }
    return out
}

fn bak_collect_keys(xml: str, prefix: str, keys: Vec<str>) -> Vec<str> {
    let mut from: i64 = 0
    let mut going: i64 = 1
    while going == 1 {
        let at = bak_find_from(xml, "<Key>", from)
        if at < 0 {
            going = 0
        } else {
            let start = at + 5
            let end = bak_find_from(xml, "</Key>", start)
            if end < 0 {
                going = 0
            } else {
                let key = bak_xml_unescape(substr(xml, start, end))
                if bak_is_archive(prefix, key) == 1 {
                    vec_push(keys, key)
                }
                from = end + 6
            }
        }
    }
    return keys
}

fn bak_xml_tag(xml: str, open: str, close: str) -> str {
    let at = str_find(xml, open)
    if at < 0 {
        return ""
    }
    let start = at + len(open)
    let end = bak_find_from(xml, close, start)
    if end < 0 {
        return ""
    }
    return bak_xml_unescape(substr(xml, start, end))
}

fn bak_prune(cfg: S3Cfg, prefix: str) -> i64 !Net !IO !Random !Time {
    let mut keys = vec_new()
    let mut token = ""
    let mut page: i64 = 0
    let mut going: i64 = 1
    while going == 1 && page < 20 {
        let listed = s3_list_cfg(cfg, concat(prefix, "/"), token)?
        if listed.ok == 0 || listed.status != 200 {
            let mut why = listed.err
            if why == "" {
                why = concat("status ", int_to_str(listed.status))
            }
            eprintln(concat("backup prune list failed: ", why))
            return 0
        }
        let xml = str_of_bytes(listed.body)
        keys = bak_collect_keys(xml, prefix, keys)
        if str_find(xml, "<IsTruncated>true</IsTruncated>") < 0 {
            going = 0
        } else {
            token = bak_xml_tag(xml, "<NextContinuationToken>", "</NextContinuationToken>")
            if token == "" {
                going = 0
            }
        }
        page = page + 1
    }
    let sorted = bak_sort_desc(keys)
    let mut dropped: i64 = 0
    let mut i = bak_keep()
    while i < vec_len(sorted) {
        let key = vec_get(sorted, i)
        let del = s3_delete_cfg(cfg, key)?
        if del.ok == 0 {
            eprintln(concat("backup prune delete failed: ", del.err))
        } else {
            dropped = dropped + 1
        }
        i = i + 1
    }
    if dropped > 0 {
        eprintln(concat("backup prune dropped ", int_to_str(dropped)))
    }
    return dropped
}

fn bak_upload(db: OrmDb) -> BakUp !IO !Net !Random !Time {
    let view = bak_view(db)?
    if view.ok == 0 {
        return BakUp { ok: 0, db: view.db, err: view.err, key: "", bytes: 0, tables: 0, rows: 0 }
    }
    if view.on == 0 || view.endpoint == "" || view.bucket == "" || view.access == "" || view.secret == "" {
        return BakUp { ok: 0, db: view.db, err: "backup storage is off", key: "", bytes: 0, tables: 0, rows: 0 }
    }
    let dump = bak_sql(view.db)?
    if dump.ok == 0 {
        return BakUp { ok: 0, db: dump.db, err: dump.err, key: "", bytes: 0, tables: 0, rows: 0 }
    }
    let body = bytes_of_str(dump.sql)
    let key = bak_object_key(view.prefix, bak_stamp()?)
    let put = s3_put_cfg(view.cfg, key, body)?
    if put.ok == 0 {
        let mut why = put.err
        if why == "" {
            why = concat("backup upload ", int_to_str(put.status))
        }
        return BakUp { ok: 0, db: dump.db, err: why, key: "", bytes: 0, tables: dump.tables, rows: dump.rows }
    }
    let pruned = bak_prune(view.cfg, view.prefix)?
    if pruned < 0 {
        return BakUp { ok: 0, db: dump.db, err: "backup prune failed", key: "", bytes: 0, tables: dump.tables, rows: dump.rows }
    }
    return BakUp {
        ok: 1,
        db: dump.db,
        err: "",
        key: key,
        bytes: bytes_len(body),
        tables: dump.tables,
        rows: dump.rows
    }
}
