// data/store_for.baga — коя кофа държи blob-овете на едно пространство.
//
// Личната кофа на собственика печели. Без нея остава общата настройка
// (или дискът). Така файловете на човек не минават през чужда кофа.

import "s3live.baga"
import "../idm/ws_model.baga"
import "../idm/storage_model.baga"
import "s3baga/s3.baga"
import "ormbaga/orm.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn data_s3_timeout() -> i64 !IO {
    let raw = str_trim(env("S3_TIMEOUT_S")?)
    let n = parse_int(raw)
    if n < 1 {
        return 30
    }
    return n
}

fn data_store_user(row: UserS3) -> S3View !IO {
    let mut region = row.region
    if region == "" {
        region = "us-east-1"
    }
    let timeout = data_s3_timeout()?
    return S3View {
        ok: 1,
        db: row.db,
        err: "",
        source: "user",
        on: 1,
        endpoint: row.endpoint,
        bucket: row.bucket,
        access: row.access,
        secret: row.secret,
        region: region,
        timeout_s: int_to_str(timeout),
        cfg: s3_cfg(row.endpoint, row.bucket, row.access, row.secret, region, timeout)
    }
}

fn data_store_for(db: OrmDb, ws: i64) -> S3View !IO !Net {
    if ws < 1 {
        return data_s3_view(db)?
    }
    let q = ws_find(db, ws)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return data_s3_view(orm_db_q(q))?
    }
    let owner = orm_cell_by_i64(q, 0, "owner_id")
    let row = user_s3_load(orm_db_q(q), owner)?
    if row.err != "" || row.found == 0 || row.enabled == 0 {
        return data_s3_view(row.db)?
    }
    if row.endpoint == "" || row.bucket == "" || row.access == "" || row.secret == "" {
        return data_s3_view(row.db)?
    }
    return data_store_user(row)?
}
