// system/site.baga — публичният адрес на приложението.
//
// В настройките се пише домейн: сега 127.0.0.1, на VPS после
// office.example.com или https://office.example.com. Локалният
// адрес става http://127.0.0.1:3010, за да съвпада с Collabora.
// site.saved=1 печели пред SECP_PUBLIC_URL.

import "settings.baga"
import "ormbaga/orm.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn site_local() -> str {
    return "http://127.0.0.1:3010"
}

fn site_trim_slash(u: str) -> str {
    let n = len(u)
    if n > 0 && char_at(u, n - 1) == 47 {
        return substr(u, 0, n - 1)
    }
    return u
}

fn site_is_local(h: str) -> i64 {
    if h == "127.0.0.1" {
        return 1
    }
    if h == "localhost" {
        return 1
    }
    if h == "http://127.0.0.1" {
        return 1
    }
    if h == "http://localhost" {
        return 1
    }
    return 0
}

// Празен и 127.0.0.1 не са грешка. Интервал в адреса е.
fn site_bad(raw: str) -> i64 {
    if len(raw) > 200 {
        return 1
    }
    if str_find(raw, " ") >= 0 {
        return 1
    }
    return 0
}

fn site_norm(raw: str) -> str {
    let t = site_trim_slash(str_trim(raw))
    if t == "" {
        return site_local()
    }
    if site_is_local(t) == 1 {
        return site_local()
    }
    if str_starts_with(t, "http://") {
        return t
    }
    if str_starts_with(t, "https://") {
        return t
    }
    if str_find(t, ":") >= 0 {
        return concat("http://", t)
    }
    return concat("https://", t)
}

struct SiteUrl {
    ok: i64,
    db: OrmDb,
    err: str,
    url: str,
    source: str
}

fn site_public(db: OrmDb) -> SiteUrl !IO !Net {
    let q = set_all(db)?
    if orm_ok_q(q) == 0 {
        return SiteUrl { ok: 0, db: orm_db_q(q), err: orm_err_q(q), url: "", source: "" }
    }
    let saved = set_saved(q, "site.saved")
    let mut source = "env"
    if saved == 1 {
        source = "db"
    }
    let raw = set_pick(saved, set_get(q, "site.url"), env("SECP_PUBLIC_URL")?)
    return SiteUrl {
        ok: 1,
        db: orm_db_q(q),
        err: "",
        url: site_norm(raw),
        source: source
    }
}
