fn secp_id_known(id: i64) -> i64 {
    let ids = secp_ids()
    let mut i: i64 = 0
    while i < vec_len(ids) {
        if vec_get(ids, i) == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn secp_id_mounted(r: Router, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(r.ids) {
        if vec_get(r.ids, i) == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// 1, когато всяко монтирано id е от списъка и всяко id от списъка е монтирано.
fn secp_ids_ok(r: Router) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(r.ids) {
        if secp_id_known(vec_get(r.ids, i)) == 0 {
            return 0
        }
        i = i + 1
    }
    let ids = secp_ids()
    i = 0
    while i < vec_len(ids) {
        if secp_id_mounted(r, vec_get(ids, i)) == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// 1, когато всеки public е 0 или 1. -1 би пуснал евристиката на fmr.
fn secp_publics_set(r: Router) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(r.publics) {
        let p = vec_get(r.publics, i)
        if p != 0 {
            if p != 1 {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}

// Точният шаблон. -2, ако метод+шаблон липсват.
fn secp_flag(r: Router, method: str, pattern: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(r.ids) {
        if vec_get(r.methods, i) == method {
            if vec_get(r.patterns, i) == pattern {
                return vec_get(r.publics, i)
            }
        }
        i = i + 1
    }
    return 0 - 2
}

fn secp_hit(r: Router, method: str, path: str) -> i64 {
    let m = router_match(r, method, path)
    if m.ok == 0 {
        return 0
    }
    return m.id
}

fn secp_matched_pattern(r: Router, method: str, path: str) -> str {
    let mut i: i64 = 0
    while i < vec_len(r.ids) {
        let m = route_match_one(method, path, vec_get(r.methods, i), vec_get(r.patterns, i), vec_get(r.ids, i))
        if m.ok == 1 {
            return vec_get(r.patterns, i)
        }
        i = i + 1
    }
    return ""
}

fn secp_param(r: Router, method: str, path: str, name: str) -> str {
    let m = router_match(r, method, path)
    if m.ok == 0 {
        return ""
    }
    let mut i: i64 = 0
    while i < vec_len(m.pnames) {
        if vec_get(m.pnames, i) == name {
            return vec_get(m.pvals, i)
        }
        i = i + 1
    }
    return ""
}
