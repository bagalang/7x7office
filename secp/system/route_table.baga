// Всяко id, което dispatch-ът трябва да поеме. Нов маршрут се добавя и тук.
fn secp_ids() -> Vec<i64> {
    let v = vec_new()
    vec_push(v, RID_HEALTH())
    vec_push(v, RID_READY())
    vec_push(v, RID_META())
