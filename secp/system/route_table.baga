    vec_push(v, RID_FS_VERSION_RESTORE())
    vec_push(v, RID_FS_ZIP_LIST())
    vec_push(v, RID_FS_ZIP_GET())
    vec_push(v, RID_SEARCH())
    vec_push(v, RID_SEARCH_REINDEX())
    vec_push(v, RID_FORGOT())
    vec_push(v, RID_RESET())
    vec_push(v, RID_WS_LIST())
    vec_push(v, RID_WS_CREATE())
    vec_push(v, RID_WS_UPDATE())
    vec_push(v, RID_WS_DELETE())
    vec_push(v, RID_WS_MEMBERS())
    vec_push(v, RID_WS_MEMBER_ADD())
    vec_push(v, RID_WS_MEMBER_UPDATE())
    vec_push(v, RID_WS_MEMBER_REMOVE())
    vec_push(v, RID_FS_ACL_LIST())
    vec_push(v, RID_FS_ACL_SET())
    vec_push(v, RID_FS_ACL_DELETE())
