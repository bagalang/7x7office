// system/ws_gateway_serve.baga — стартиране на WS gateway-а (входна точка).
//
// Влиза се от `start.baga` след миграциите. Ако портът е зает, нишката
// отпечатва и излиза — стартът на приложението не бива да блокира заради
// канала (същият принцип като scheduler-а).
//
// Портът по подразбиране е HTTP портът + 1 (SECP_PORT / PORT). Ако
// SECP_WS_PORT е зададен изрично, той печели; 0 = каналът е изключен.

import "ws_gateway.baga"
import "ws_gateway_loop.baga"
import "ws_gateway_pump.baga"
import "fmrbaga/app.baga"
import "fmrbaga/config.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

// Портът на канала. Изнесен, за да се тества без сокет и за да е ясно, че
// „0" значи „изключен" — различно от „липсва" (тогава HTTP+1).
fn wsg_port_of(ws_env: str, http_port: i64) -> i64 {
    if ws_env != "" {
        let n = parse_int(ws_env)
        if n < 0 {
            return 0
        }
        if n > 65535 {
            return 0
        }
        return n
    }
    if http_port < 1 || http_port >= 65535 {
        return 0
    }
    return http_port + 1
}

fn wsg_start() -> i64 !Par !IO !Net !Random !Time {
    let cfg = fmr_config_load()?
    let port = wsg_port_of(env("SECP_WS_PORT")?, cfg.port)
    if port < 1 {
        return 0
    }
    go_bg(wsg_serve, port)
    return 0
}

// Основният цикъл на нишката. Тук е и JWT тайната: `fmr_config_load` я чете
// веднъж, вместо всяка нова връзка да пипа средата.
fn wsg_serve(port: i64) -> i64 !IO !Net !Par !Time !Random {
    let cfg = fmr_config_load()?
    let listener = tcp_listen(port)?
    if listener < 0 {
        eprintln(concat("wsg: не мога да слушам на :", int_to_str(port)))
        return 1
    }
    eprintln(concat(concat("wsg: каналът слуша на :", int_to_str(port)), " (/ws)"))
    let mut hub = wsg_hub_new(listener, cfg.jwt_secret)
    let poll_ms = wsg_poll_ms()?
    let mut ticks: i64 = 0
    while true {
        hub = wsg_step(hub, poll_ms)?
        // Излъчването е извън poll-а: зависи от часовника, не от мрежата.
        // Така събитие, записано между два чита, пак стига до клиента.
        hub = wsg_pump(hub)?.hub
        ticks = ticks + 1
        // Ping-ът е по-рядко от tick-а: той е за откриване на мъртви връзки,
        // а не за трафик. 20 tick-а ≈ 10 s при подразбираните 500 ms.
        if ticks >= 20 {
            ticks = 0
            hub = wsg_ping_due(hub)?
        }
    }
    return 0
}
