// system/flows_run.baga — едно действие на поток върху един файл.

import "flows.baga"
import "../tree/model.baga"
import "../tree/mutate.baga"
import "../tree/store.baga"
import "../data/crypt.baga"
import "mail_jobs.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

struct FlowJob {
    ok: i64,
    db: OrmDb,
    err: str
}

fn flow_job_bad(db: OrmDb, err: str) -> FlowJob {
    return FlowJob { ok: 0, db: db, err: err }
}

fn flow_dest_path(folder: str, file_path: str) -> str {
    let dir = flow_dir(folder)
    let name = tree_name_of(file_path)
    if dir == "/" {
        return concat("/", name)
    }
    return concat(concat(dir, "/"), name)
}

fn flow_apply(db: OrmDb, ws: i64, owner: i64, path: str, action: str, arg: str) -> FlowJob !IO !Net !Time !Random {
    if action == "mail" {
        let body = concat("7x7office: ", path)
        let job = ops_enqueue_mail(db, arg, "Поток: нов файл", body)?
        if orm_ok(job) == 0 {
            return flow_job_bad(orm_db_exec(job), orm_err_exec(job))
        }
        return FlowJob { ok: 1, db: orm_db_exec(job), err: "" }
    }
    let dest = flow_dest_path(arg, path)
    if dest == path {
        return FlowJob { ok: 1, db: db, err: "" }
    }
    if action == "move" {
        let out = tree_relocate(db, ws, owner, path, dest)?
        if out.resp.status >= 400 {
            return flow_job_bad(out.db, "move failed")
        }
        return FlowJob { ok: 1, db: out.db, err: "" }
    }
    if action == "copy" {
        let q = tree_find(db, ws, path)?
        if orm_ok_q(q) == 0 {
            return flow_job_bad(orm_db_q(q), orm_err_q(q))
        }
        if orm_nrows(q) < 1 {
            return FlowJob { ok: 1, db: orm_db_q(q), err: "" }
        }
        let hash = orm_cell_by(q, 0, "hash")
        let got = data_open(orm_db_q(q), ws, hash)?
        if got.err != "" {
            return flow_job_bad(got.db, got.err)
        }
        let stored = tree_store_file(got.db, ws, owner, dest, got.body, 0)?
        if stored.resp.status >= 400 {
            return flow_job_bad(stored.db, "copy failed")
        }
        return FlowJob { ok: 1, db: stored.db, err: "" }
    }
    return flow_job_bad(db, "unknown action")
}

fn flow_run(db: OrmDb, payload: str) -> FlowJob !IO !Net !Time !Random {
    let parsed = jbody_parse_str(payload)
    if parsed.ok == 0 {
        return flow_job_bad(db, parsed.err)
    }
    let b = jbody_require_object(parsed)
    if b.ok == 0 {
        return flow_job_bad(db, b.err)
    }
    let idf = jreq_i64(b.doc, b.root, "id")
    if idf.ok == 0 {
        return flow_job_bad(db, idf.err)
    }
    let pathf = jreq_str(b.doc, b.root, "path")
    if pathf.ok == 0 {
        return flow_job_bad(db, pathf.err)
    }
    let wsf = jreq_i64(b.doc, b.root, "ws")
    if wsf.ok == 0 {
        return flow_job_bad(db, wsf.err)
    }
    let ownerf = jreq_i64(b.doc, b.root, "owner")
    if ownerf.ok == 0 {
        return flow_job_bad(db, ownerf.err)
    }
    let q = flow_one(db, idf.num)?
    if orm_ok_q(q) == 0 {
        return flow_job_bad(orm_db_q(q), orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return FlowJob { ok: 1, db: orm_db_q(q), err: "" }
    }
    if orm_cell_by_i64(q, 0, "enabled") != 1 {
        return FlowJob { ok: 1, db: orm_db_q(q), err: "" }
    }
    return flow_apply(orm_db_q(q), wsf.num, ownerf.num, pathf.val, orm_cell_by(q, 0, "action"), orm_cell_by(q, 0, "arg"))?
}

// Ръчно: до 40 файла, които минават филтъра.
fn flow_enqueue_manual(db: OrmDb, id: i64) -> FlowJob !IO !Net {
    let q = flow_one(db, id)?
    if orm_ok_q(q) == 0 {
        return flow_job_bad(orm_db_q(q), orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return flow_job_bad(orm_db_q(q), "flow not found")
    }
    let prefix = orm_cell_by(q, 0, "path_prefix")
    let ext = orm_cell_by(q, 0, "ext")
    let action = orm_cell_by(q, 0, "action")
    let arg = orm_cell_by(q, 0, "arg")
    let files = orm_query(orm_db_q(q), "SELECT workspace_id, owner_id, path, is_dir FROM tree_nodes")?
    if orm_ok_q(files) == 0 {
        return flow_job_bad(orm_db_q(files), orm_err_q(files))
    }
    let mut d = orm_db_q(files)
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < orm_nrows(files) {
        if n >= 40 {
            i = orm_nrows(files)
        } else {
            if orm_cell_by_i64(files, i, "is_dir") == 0 {
                let path = orm_cell_by(files, i, "path")
                if flow_match(path, prefix, ext) == 1 {
                    if flow_in_dest(path, action, arg) == 0 {
                        let ws = orm_cell_by_i64(files, i, "workspace_id")
                        let owner = orm_cell_by_i64(files, i, "owner_id")
                        let job = ops_enqueue(d, "flow-run", flow_payload(id, ws, owner, path))?
                        if orm_ok(job) == 0 {
                            return flow_job_bad(orm_db_exec(job), orm_err_exec(job))
                        }
                        d = orm_db_exec(job)
                        n = n + 1
                    }
                }
            }
            i = i + 1
        }
    }
    return FlowJob { ok: 1, db: d, err: int_to_str(n) }
}
