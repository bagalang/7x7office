// system/chat_model.baga — история на чата по пространство (Фаза 3).
//
// Стаята е самото пространство: една клетка, една стая. Няма втора таблица
// „cell" — членовете и ролите вече са в idm_workspaces (Фаза 2).
//
// ts е epoch секунди, както activity: еднакъв ред на Postgres и boilaDB.

import "chatbaga/chat_room.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn chat_table() -> str {
    return "chat_messages"
}

fn chat_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn chat_now_s() -> i64 !Time {
    return time_now_ms() / 1000
}

fn chat_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM chat_messages")?
}

fn chat_max_id(db: OrmDb, ws: i64) -> OrmCount !IO !Net {
    let sql = concat("SELECT MAX(id) AS count FROM chat_messages WHERE workspace_id = ", int_to_str(ws))
    return orm_count_sql(db, sql)?
}

// Редове + автори, слято в кода. boilaSQL не решава квалифицирани колони в
// WHERE, а `id` е двусмислена при JOIN с idm_users (Postgres я отказва),
// затова съобщенията се четат без JOIN, а авторите — с IN заявка после.
struct ChatRows {
    db: OrmDb,
    err: str,
    n: i64,
    ids: Vec<i64>,
    ws_ids: Vec<i64>,
    authors: Vec<i64>,
    bodies: Vec<str>,
    tss: Vec<i64>,
    emails: Vec<str>,
    names: Vec<str>
}

fn chat_rows_fail(db: OrmDb, err: str) -> ChatRows {
    return ChatRows { db: db, err: err, n: 0, ids: vec_new(), ws_ids: vec_new(), authors: vec_new(), bodies: vec_new(), tss: vec_new(), emails: vec_new(), names: vec_new() }
}

fn chat_id_in_list(ids: Vec<i64>, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(ids) {
        if vec_get(ids, i) == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// email/name за всяка реплика по author_id. Една IN заявка за всички автори;
// липсващ потребител (изтрит) дава празни полета — както LEFT JOIN NULL-а.
fn chat_attach_authors(db: OrmDb, q: OrmQuery) -> ChatRows !IO !Net {
    let mut rows = ChatRows { db: db, err: "", n: orm_nrows(q), ids: vec_new(), ws_ids: vec_new(), authors: vec_new(), bodies: vec_new(), tss: vec_new(), emails: vec_new(), names: vec_new() }
    let uniq: Vec<i64> = vec_new()
    let mut in_list = ""
    let mut i: i64 = 0
    while i < rows.n {
        let aid = orm_cell_by_i64(q, i, "author_id")
        vec_push(rows.ids, orm_cell_by_i64(q, i, "id"))
        vec_push(rows.ws_ids, orm_cell_by_i64(q, i, "workspace_id"))
        vec_push(rows.authors, aid)
        vec_push(rows.bodies, orm_cell_by(q, i, "body"))
        vec_push(rows.tss, orm_cell_by_i64(q, i, "ts"))
        vec_push(rows.emails, "")
        vec_push(rows.names, "")
        if aid > 0 && chat_id_in_list(uniq, aid) == 0 {
            vec_push(uniq, aid)
            if in_list != "" {
                in_list = concat(in_list, ",")
            }
            in_list = concat(in_list, int_to_str(aid))
        }
        i = i + 1
    }
    let mut d = orm_db_q(q)
    if in_list == "" {
        rows.db = d
        return rows
    }
    let uq = orm_query_params_str(d, concat("SELECT id, email, name FROM idm_users WHERE id IN (", concat(in_list, ")")), vec_new())?
    if orm_ok_q(uq) == 0 {
        return chat_rows_fail(orm_db_q(uq), orm_err_q(uq))
    }
    d = orm_db_q(uq)
    let mut r: i64 = 0
    while r < rows.n {
        let aid = vec_get(rows.authors, r)
        let mut j: i64 = 0
        while j < orm_nrows(uq) {
            if orm_cell_by_i64(uq, j, "id") == aid {
                vec_set(rows.emails, r, orm_cell_by(uq, j, "email"))
                vec_set(rows.names, r, orm_cell_by(uq, j, "name"))
            }
            j = j + 1
        }
        r = r + 1
    }
    rows.db = d
    return rows
}

fn chat_read(db: OrmDb, sql: str, vals: Vec<str>) -> ChatRows !IO !Net {
    let q = orm_query_params_str(db, sql, vals)?
    if orm_ok_q(q) == 0 {
        return chat_rows_fail(orm_db_q(q), orm_err_q(q))
    }
    return chat_attach_authors(orm_db_q(q), q)?
}

// Най-новите първи. Викащият ги обръща, за да ги покаже от стари към нови.
fn chat_list(db: OrmDb, ws: i64, limit: i64) -> ChatRows !IO !Net {
    let n = int_to_str(chat_history_clamp(limit))
    let sql = concat("SELECT id, workspace_id, author_id, body, ts FROM chat_messages WHERE workspace_id = $1 ORDER BY id DESC LIMIT ", n)
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    return chat_read(db, sql, vals)?
}

fn chat_tail(db: OrmDb, ws: i64, after: i64, limit: i64) -> ChatRows !IO !Net {
    let n = int_to_str(chat_history_clamp(limit))
    let sql = concat("SELECT id, workspace_id, author_id, body, ts FROM chat_messages WHERE workspace_id = $1 AND id > $2 ORDER BY id ASC LIMIT ", n)
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    vec_push(vals, int_to_str(after))
    return chat_read(db, sql, vals)?
}

fn chat_by_id(db: OrmDb, id: i64) -> ChatRows !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(id))
    return chat_read(db, "SELECT id, workspace_id, author_id, body, ts FROM chat_messages WHERE id = $1", vals)?
}

fn chat_to_json(rows: ChatRows, row: i64) -> JObj {
    let mut o = jobj_new()
    let ws = vec_get(rows.ws_ids, row)
    o = jobj_i64(o, "id", vec_get(rows.ids, row))
    o = jobj_i64(o, "workspace_id", ws)
    o = jobj_str(o, "room", chat_room_key(ws))
    o = jobj_i64(o, "author_id", vec_get(rows.authors, row))
    o = jobj_str(o, "author_email", vec_get(rows.emails, row))
    o = jobj_str(o, "author_name", vec_get(rows.names, row))
    o = jobj_str(o, "text", vec_get(rows.bodies, row))
    o = jobj_i64(o, "ts", vec_get(rows.tss, row))
    return o
}

// Хронологично: заявката е DESC, масивът тръгва от най-стария в страницата.
fn chat_rows_chrono(rows: ChatRows) -> str {
    let mut arr = jarr_new()
    let mut i = rows.n - 1
    while i >= 0 {
        arr = jarr_obj(arr, chat_to_json(rows, i))
        i = i - 1
    }
    return jarr_encode(arr)
}

fn chat_insert(db: OrmDb, ws: i64, author: i64, body: str, ts: i64) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "workspace_id")
    vec_push(cols, "author_id")
    vec_push(cols, "body")
    vec_push(cols, "ts")
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    vec_push(vals, int_to_str(author))
    vec_push(vals, body)
    vec_push(vals, int_to_str(ts))
    if chat_backend_boila()? == 1 {
        let c = chat_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmQErr(OrmQueryFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let cols2 = vec_new()
        vec_push(cols2, "id")
        let mut vals2 = vec_new()
        vec_push(vals2, int_to_str(orm_count_n(c) + 1))
        let mut i: i64 = 0
        while i < vec_len(cols) {
            vec_push(cols2, vec_get(cols, i))
            vec_push(vals2, vec_get(vals, i))
            i = i + 1
        }
        return orm_insert_returning_strs(orm_db_c(c), chat_table(), cols2, vals2)?
    }
    return orm_insert_returning_strs(db, chat_table(), cols, vals)?
}

fn chat_purge_ws(db: OrmDb, ws: i64) -> OrmExec !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    return orm_exec_params_str(db, "DELETE FROM chat_messages WHERE workspace_id = $1", vals)?
}
