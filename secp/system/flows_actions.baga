// system/flows_actions.baga — админ API за потоците.

import "flows.baga"
import "flows_run.baga"
import "../idm/user_actions.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

fn flow_action_ok(action: str) -> i64 {
    if action == "move" {
        return 1
    }
    if action == "copy" {
        return 1
    }
    if action == "mail" {
        return 1
    }
    return 0
}

fn flow_trigger_ok(trigger: str) -> i64 {
    if trigger == "upload" {
        return 1
    }
    if trigger == "manual" {
        return 1
    }
    return 0
}

fn act_flows_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let q = flow_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), flow_list_json(q))
}

fn act_flows_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name_f = jreq_str(b.doc, b.root, "name")
    if name_f.ok == 0 {
        return act_err(db, 400, name_f.err)
    }
    let name = str_trim(name_f.val)
    if name == "" {
        return act_err(db, 400, "name required")
    }
    let trigger_f = jreq_str(b.doc, b.root, "trigger")
    if trigger_f.ok == 0 {
        return act_err(db, 400, trigger_f.err)
    }
    let trigger = str_trim(trigger_f.val)
    if flow_trigger_ok(trigger) == 0 {
        return act_err(db, 400, "trigger must be upload or manual")
    }
    let action_f = jreq_str(b.doc, b.root, "action")
    if action_f.ok == 0 {
        return act_err(db, 400, action_f.err)
    }
    let action = str_trim(action_f.val)
    if flow_action_ok(action) == 0 {
        return act_err(db, 400, "action must be move, copy or mail")
    }
    let prefix_f = jopt_str(b.doc, b.root, "path_prefix", "")
    if prefix_f.ok == 0 {
        return act_err(db, 400, prefix_f.err)
    }
    let ext_f = jopt_str(b.doc, b.root, "ext", "")
    if ext_f.ok == 0 {
        return act_err(db, 400, ext_f.err)
    }
    let arg_f = jopt_str(b.doc, b.root, "arg", "")
    if arg_f.ok == 0 {
        return act_err(db, 400, arg_f.err)
    }
    let arg = str_trim(arg_f.val)
    if arg == "" {
        return act_err(db, 400, "arg required")
    }
    if action == "mail" {
        if str_find(arg, "@") < 1 {
            return act_err(db, 400, "mail needs an address")
        }
    }
    let mut prefix = ""
    if str_trim(prefix_f.val) != "" {
        prefix = flow_dir(prefix_f.val)
    }
    let ext = flow_norm_ext(ext_f.val)
    let mut stored_arg = arg
    if action != "mail" {
        stored_arg = flow_dir(arg)
    }
    let w = flow_insert(db, name, trigger, prefix, ext, action, stored_arg)?
    if w.ok == 0 {
        return act_err(w.db, 500, w.err)
    }
    let q = flow_all(w.db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_created(orm_db_q(q), flow_list_json(q))
}

fn act_flows_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let id = parse_int(fmr_query(ctx, "id"))
    if id < 1 {
        return act_err(db, 400, "id required")
    }
    let sql = "DELETE FROM ops_flows WHERE id = $1"
    let vals = vec_new()
    vec_push(vals, int_to_str(id))
    let nulls = vec_new()
    vec_push(nulls, 0)
    let ex = orm_exec_params(db, sql, vals, nulls)?
    if orm_ok(ex) == 0 {
        return act_err(orm_db_exec(ex), 500, orm_err_exec(ex))
    }
    return act_no_content(orm_db_exec(ex))
}

fn act_flows_run(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let id = parse_int(fmr_query(ctx, "id"))
    if id < 1 {
        return act_err(db, 400, "id required")
    }
    let ran = flow_enqueue_manual(db, id)?
    if ran.ok == 0 {
        return act_err(ran.db, 400, ran.err)
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "queued", parse_int(ran.err))
    return act_ok(ran.db, o)
}
