// idm/dav_key_model.baga — дълъг ключ за WebDAV, по един на потребител.
//
// В базата стои само SHA-256. Самият ключ се връща веднъж при издаване.
// Паролата за вход не отваря папката: тя може да е къса и да заобиколи 2FA.

import "user_model.baga"
import "ormbaga/orm.baga"
import "std/crypto/sha256.baga"
import "std/bytes/bytes.baga"
import "std/random/random.baga"
import "std/str/str.baga"
import "std/time/time.baga"

struct DavKey {
    db: OrmDb,
    found: i64,
    hash: str,
    prefix: str,
    created: i64,
    err: str
}

fn dav_key_none(db: OrmDb) -> DavKey {
    return DavKey { db: db, found: 0, hash: "", prefix: "", created: 0, err: "" }
}

fn dav_key_bad(db: OrmDb, err: str) -> DavKey {
    return DavKey { db: db, found: 0, hash: "", prefix: "", created: 0, err: err }
}

fn dav_key_hash(secret: str) -> str {
    return sha256_b_hex(bytes_of_str(secret))
}

fn dav_key_prefix(secret: str) -> str {
    if len(secret) < 12 {
        return secret
    }
    return substr(secret, 0, 12)
}

// 32 случайни байта, 64 hex знака, с префикс dav_.
fn dav_key_mint() -> str !Random {
    return concat("dav_", bytes_to_hex(random_bytes(32)))
}

fn dav_key_load(db: OrmDb, user_id: i64) -> DavKey !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    let q = orm_query_params_str(db, "SELECT key_hash, prefix, created_at FROM idm_dav_keys WHERE user_id = $1", vals)?
    if orm_ok_q(q) == 0 {
        return dav_key_bad(orm_db_q(q), orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return dav_key_none(orm_db_q(q))
    }
    return DavKey {
        db: orm_db_q(q),
        found: 1,
        hash: orm_cell_by(q, 0, "key_hash"),
        prefix: orm_cell_by(q, 0, "prefix"),
        created: orm_cell_by_i64(q, 0, "created_at"),
        err: ""
    }
}

fn dav_key_save(db: OrmDb, user_id: i64, secret: str) -> DavKey !IO !Net !Time {
    let cur = dav_key_load(db, user_id)?
    if cur.err != "" {
        return cur
    }
    let hash = dav_key_hash(secret)
    let prefix = dav_key_prefix(secret)
    let now = time_now_ms()? / 1000
    if cur.found == 1 {
        let vals = vec_new()
        vec_push(vals, hash)
        vec_push(vals, prefix)
        vec_push(vals, int_to_str(now))
        vec_push(vals, int_to_str(user_id))
        let up = orm_exec_params_str(cur.db, "UPDATE idm_dav_keys SET key_hash = $1, prefix = $2, created_at = $3 WHERE user_id = $4", vals)?
        if orm_ok(up) == 0 {
            return dav_key_bad(orm_db_exec(up), orm_err_exec(up))
        }
        return DavKey { db: orm_db_exec(up), found: 1, hash: hash, prefix: prefix, created: now, err: "" }
    }
    let cols = vec_new()
    vec_push(cols, "user_id")
    vec_push(cols, "key_hash")
    vec_push(cols, "prefix")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    vec_push(vals, hash)
    vec_push(vals, prefix)
    vec_push(vals, int_to_str(now))
    let ins = orm_insert_strs(cur.db, "idm_dav_keys", cols, vals)?
    if orm_ok(ins) == 0 {
        return dav_key_bad(orm_db_exec(ins), orm_err_exec(ins))
    }
    return DavKey { db: orm_db_exec(ins), found: 1, hash: hash, prefix: prefix, created: now, err: "" }
}

// Basic паролата е ключът, не паролата за вход.
fn dav_key_auth(db: OrmDb, email: str, secret: str) -> IdmAuth !IO !Net {
    let q = idm_user_find_by_email(db, to_lower(str_trim(email)))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return idm_auth_bad()
    }
    let uid = orm_cell_by_i64(q, 0, "id")
    let mail = orm_cell_by(q, 0, "email")
    let name = orm_cell_by(q, 0, "name")
    let admin = orm_cell_by_i64(q, 0, "is_admin")
    let row = dav_key_load(orm_db_q(q), uid)?
    if row.err != "" || row.found == 0 {
        return idm_auth_bad()
    }
    if dav_key_hash(secret) != row.hash {
        return idm_auth_bad()
    }
    return IdmAuth { ok: 1, id: uid, email: mail, name: name, is_admin: admin }
}
