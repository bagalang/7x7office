// idm/auth_actions.baga — login / logout / me.
// JWT (HS256, fmr_issue_token) is the session; the browser flow also sets an
// HttpOnly cookie so the tplbaga UI works without JS.

import "user_model.baga"
import "totp_actions.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/deps.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "querybaga/query.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn secp_cookie_name() -> str {
    return "secp_token"
}

// Extract login fields from JSON body or form-urlencoded body.
struct LoginForm {
    ok: i64,
    is_form: i64,
    email: str,
    password: str,
    err: str
}

fn login_form_bad(err: str) -> LoginForm {
    return LoginForm { ok: 0, is_form: 0, email: "", password: "", err: err }
}

fn login_form_parse(ctx: FmrCtx) -> LoginForm {
    let body = fmr_body(ctx)
    if body == "" {
        return login_form_bad("empty body")
    }
    if str_starts_with(str_trim(body), "{") {
        let parsed = jbody_parse_str(body)
        if parsed.ok == 0 {
            return login_form_bad(parsed.err)
        }
        let b = jbody_require_object(parsed)
        if b.ok == 0 {
            return login_form_bad(b.err)
        }
        let email = jreq_str(b.doc, b.root, "email")
        if email.ok == 0 {
            return login_form_bad("email field required")
        }
        let password = jreq_str(b.doc, b.root, "password")
        if password.ok == 0 {
            return login_form_bad("password field required")
        }
        return LoginForm { ok: 1, is_form: 0, email: email.val, password: password.val, err: "" }
    }
    let q = query_parse(body)
    let email = query_get(q, "email")
    let password = query_get(q, "password")
    if email == "" || password == "" {
        return login_form_bad("email and password required")
    }
    return LoginForm { ok: 1, is_form: 1, email: email, password: password, err: "" }
}

fn secp_cookie_set(token: str) -> str {
    let mut c = concat(secp_cookie_name(), "=")
    c = concat(c, token)
    return concat(c, "; Path=/; HttpOnly; SameSite=Lax")
}

fn secp_cookie_clear() -> str {
    return concat(secp_cookie_name(), "=; Path=/; HttpOnly; Max-Age=0")
}

fn act_login(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let form = login_form_parse(ctx)
    if form.ok == 0 {
        return act_err(db, 400, form.err)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let auth = idm_user_authenticate(db, form.email, form.password)?
    if auth.ok == 0 {
        return act_err(db, 401, "invalid email or password")
    }
    let uq = idm_user_find_by_email(db, auth.email)?
    if orm_ok_q(uq) == 0 {
        return act_err(orm_db_q(uq), 500, orm_err_q(uq))
    }
    let mut totp: i64 = 0
    if orm_nrows(uq) > 0 {
        totp = orm_cell_by_i64(uq, 0, "totp_enabled")
    }
    let dbu = orm_db_q(uq)
    if totp == 1 {
        if form.is_form == 1 {
            return act_err(dbu, 401, "2FA required")
        }
        return act_login_mfa(ctx, dbu, auth.email)?
    }
    let mut extra = "\"uid\":"
    extra = concat(extra, int_to_str(auth.id))
    if auth.is_admin == 1 {
        extra = concat(extra, ",\"admin\":true")
    }
    let token = fmr_issue_token(ctx.jwt_secret, auth.email, extra)
    if form.is_form == 1 {
        // Browser flow: cookie + redirect to home.
        let mut r = http_response(303, "")
        r = http_set_header(r, "Location", "/")
        r = http_set_header(r, "Set-Cookie", secp_cookie_set(token))
        return fmr_out(r, dbu)
    }
    let mut o = jobj_new()
    o = jobj_str(o, "access_token", token)
    o = jobj_str(o, "token_type", "bearer")
    o = jobj_str(o, "sub", auth.email)
    o = jobj_i64(o, "uid", auth.id)
    let mut r = fmr_ok_obj(o)
    r = http_set_header(r, "Set-Cookie", secp_cookie_set(token))
    return fmr_out(r, dbu)
}

fn act_logout(ctx: FmrCtx, db: OrmDb) -> FmrOut {
    // Stateless JWT: revocation lands with idm_sessions in a later phase.
    let mut r = http_response(303, "")
    r = http_set_header(r, "Location", "/login")
    r = http_set_header(r, "Set-Cookie", secp_cookie_clear())
    return fmr_out(r, db)
}

fn act_me(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let q = idm_user_find_by_email(db, to_lower(str_trim(auth.ctx.user_sub)))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 401, "unknown user")
    }
    let mut o = idm_user_to_json(q, 0)
    o = jobj_str(o, "sub", orm_cell_by(q, 0, "email"))
    o = jobj_i64(o, "totp_enabled", orm_cell_by_i64(q, 0, "totp_enabled"))
    return act_ok(orm_db_q(q), o)
}
