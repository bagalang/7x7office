// idm/user_actions.baga — admin user list and create.
// Passwords are hashed here (PBKDF2); the JSON never returns the hash.

import "user_model.baga"
import "../lib/pass.baga"
import "../lib/mail_welcome.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "std/str/str.baga"

struct IdmCaller {
    ok: i64,
    id: i64,
    email: str,
    is_admin: i64,
    out: FmrOut
}

fn idm_caller_bad(out: FmrOut) -> IdmCaller {
    return IdmCaller { ok: 0, id: 0, email: "", is_admin: 0, out: out }
}

fn idm_caller(ctx: FmrCtx, db: OrmDb) -> IdmCaller !IO !Net {
    let a = act_require_auth(ctx, db)
    if a.ok == 0 {
        return idm_caller_bad(a.out)
    }
    let q = idm_user_find_by_email(db, to_lower(str_trim(a.ctx.user_sub)))?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        let mut d = db
        if orm_ok_q(q) == 1 {
            d = orm_db_q(q)
        }
        return idm_caller_bad(act_err(d, 401, "unknown user"))
    }
    return IdmCaller {
        ok: 1,
        id: orm_cell_by_i64(q, 0, "id"),
        email: orm_cell_by(q, 0, "email"),
        is_admin: orm_cell_by_i64(q, 0, "is_admin"),
        out: fmr_out(http_response(200, ""), orm_db_q(q))
    }
}

fn idm_require_admin(ctx: FmrCtx, db: OrmDb) -> IdmCaller !IO !Net {
    let c = idm_caller(ctx, db)?
    if c.ok == 0 {
        return c
    }
    if c.is_admin != 1 {
        return idm_caller_bad(act_err(db, 403, "admin required"))
    }
    return c
}

fn idm_email_ok(email: str) -> i64 {
    if len(email) < 3 {
        return 0
    }
    if str_find(email, "@") < 1 {
        return 0
    }
    if str_find(email, " ") >= 0 {
        return 0
    }
    return 1
}

fn act_users_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let q = idm_user_list(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, idm_user_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return act_ok(orm_db_q(q), o)
}

fn act_users_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random {
    let c = idm_require_admin(ctx, db)?
    if c.ok == 0 {
        return c.out
    }
    let parsed = jbody_parse_str(fmr_body(ctx))
    if parsed.ok == 0 {
        return act_err(db, 400, parsed.err)
    }
    let b = jbody_require_object(parsed)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let email_f = jreq_str(b.doc, b.root, "email")
    if email_f.ok == 0 {
        return act_err(db, 400, email_f.err)
    }
    let email = to_lower(str_trim(email_f.val))
    if idm_email_ok(email) == 0 {
        return act_err(db, 400, "invalid email")
    }
    let password = jreq_str(b.doc, b.root, "password")
    if password.ok == 0 {
        return act_err(db, 400, password.err)
    }
    if len(password.val) < 8 {
        return act_err(db, 400, "password must be at least 8 characters")
    }
    let name_f = jopt_str(b.doc, b.root, "name", "")
    if name_f.ok == 0 {
        return act_err(db, 400, name_f.err)
    }
    let mut is_admin: i64 = 0
    let flag = jreq_bool(b.doc, b.root, "is_admin")
    if flag.present == 1 {
        if flag.ok == 0 {
            return act_err(db, 400, flag.err)
        }
        is_admin = flag.num
    }
    let existing = idm_user_find_by_email(db, email)?
    if orm_ok_q(existing) == 0 {
        return act_err(orm_db_q(existing), 500, orm_err_q(existing))
    }
    if orm_nrows(existing) > 0 {
        return act_err(orm_db_q(existing), 409, "email already exists")
    }
    let mut d = orm_db_q(existing)
    let iters = pass_iters_cfg()?
    let salt = pass_new_salt()?
    let hash = pass_make(password.val, salt, iters)
    let ins = idm_user_create(d, email, str_trim(name_f.val), hash, salt, iters, is_admin)?
    if orm_ok(ins) == 0 {
        return act_err(orm_db_exec(ins), 500, orm_err_exec(ins))
    }
    d = orm_db_exec(ins)
    let q = idm_user_find_by_email(d, email)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(d, 500, "create ok but user missing")
    }
    // Welcome писмо (ако пощата е включена). Не се чака и не може да
    // провали създаването — то вече е станало.
    let d2 = mw_enqueue(orm_db_q(q), email, str_trim(name_f.val))?
    return act_created(d2, idm_user_to_json(q, 0))
}
