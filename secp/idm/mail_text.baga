// idm/mail_text.baga — текстовете на писмата (Фаза 6.3).
//
// Нарочно чист модул: БЕЗ база, БЕЗ scheduler, БЕЗ HTTP. Защо — иначе
// всеки, който иска да провери/преведе текста, тегли целия приложен
// стек със себе си (scheduler → fmrbaga → routes). Отделянето държи
// тестовете леки и прави текстовете на едно място за превод.
//
// Език: текстовете са на български, защото писмото се праща от
// сървъра, който не знае езика на получателя (той е избран в браузъра,
// не в акаунта). Ако това стане нужно, тук се подава lang.

import "std/str/str.baga"

// Писмо за смяна на забравена парола. link е пълният URL с токена.
fn mt_reset_text(link: str, ttl_min: i64) -> str {
    let mut t = "Здравейте,\n\n"
    t = concat(t, "Получихме заявка за смяна на паролата за вашия акаунт в 7x7office.\n\n")
    t = concat(t, concat("Отворете този линк: ", link))
    t = concat(t, "\n\n")
    t = concat(t, concat("Линкът е валиден ", concat(int_to_str(ttl_min), " минути и може да се използва само веднъж.\n\n")))
    t = concat(t, "Ако не сте заявили смяна, просто игнорирайте това писмо — паролата остава непроменена.\n")
    return t
}

// Welcome писмо. Паролата НЕ се праща по поща (имейлът не е тайна
// връзка) — праща се линк за вход, а паролата се дава отделно.
fn mt_welcome_text(email: str, link: str) -> str {
    let mut t = "Здравейте,\n\n"
    t = concat(t, "Създаден е акаунт за вас в 7x7office.\n\n")
    t = concat(t, concat("Потребител: ", email))
    t = concat(t, "\n\n")
    t = concat(t, concat("Влезте оттук: ", link))
    t = concat(t, "\n\n")
    t = concat(t, "Ако не сте очаквали това писмо, кажете на администратора.\n")
    return t
}
