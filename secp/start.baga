// start.baga — secp entrypoint: migrate → seed admin → fmr_run.
// Domain schema and routes belong to the app; fmrbaga stays universal.

import "routes.baga"
import "schema.baga"
import "lib/pass.baga"
import "idm/user_model.baga"
import "system/scheduler.baga"
import "system/ws_gateway_serve.baga"
import "tree/backfill.baga"
import "fmrbaga/app.baga"
import "ormbaga/orm.baga"
import "ormbaga/migrate.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn boot_migrate() -> i64 !Net !IO !Random {
    let app = fmr_build_app()?
    let db = fmr_open_db(app)?
    if orm_ok_db(db) == 0 {
        print(concat("migrate: db connect failed: ", orm_err_db(db)))
        return 1
    }
    // secp_migrations_auto: Postgres SERIAL/FK or boila BoilaSQL (ORM_BACKEND=).
    let set = secp_migrations_auto()?
    let up = migrate_up(db, set)?
    if migrate_is_ok(up) == 0 {
        print(concat("migrate failed: ", migrate_err_str(up)))
        orm_close(migrate_db(up))?
        return 1
    }
    print(concat("migrate applied=", int_to_str(migrate_applied_n(up))))
    let rc0 = boot_backfill_tree(migrate_db(up))?
    if rc0 != 0 {
        orm_close(migrate_db(up))?
        return rc0
    }
    let rc = boot_seed_admin(migrate_db(up))?
    orm_close(migrate_db(up))?
    return rc
}

// Връзва старите възли (owner-ски, отпреди Фаза 2) към личния workspace на
// собственика. Идемпотентно: след първото пускане няма какво да мести.
// Провалът НЕ спира стартирането — приложението работи и без него, само
// старите файлове остават невидими до следващия рестарт. Затова е warn+0.
//
// ВАЖНО: връзката НЕ се затваря тук — тя е на викащия (migrate/seed я
// ползват след това). Затварянето ѝ тук оставяше seed-а без връзка.
fn boot_backfill_tree(db: OrmDb) -> i64 !Net !IO {
    let r = tree_backfill(db)?
    if r.err != "" {
        eprintln(concat("tree backfill: ", r.err))
        return 0
    }
    if r.nodes > 0 {
        print(concat("tree backfill: вързани ", concat(int_to_str(r.nodes), " възела към личните пространства")))
    }
    return 0
}

// First-run installer: SECP_ADMIN_EMAIL + SECP_ADMIN_PASSWORD → admin user.
// Idempotent — skips when the email already exists.
fn boot_seed_admin(db: OrmDb) -> i64 !Net !IO !Random {
    let email = env("SECP_ADMIN_EMAIL")?
    let password = env("SECP_ADMIN_PASSWORD")?
    if email == "" || password == "" {
        return 0
    }
    let q = idm_user_find_by_email(db, email)?
    if orm_ok_q(q) == 1 && orm_nrows(q) > 0 {
        return 0
    }
    let mut name = env("SECP_ADMIN_NAME")?
    if name == "" {
        name = "Admin"
    }
    let iters = pass_iters_cfg()?
    let salt = pass_new_salt()?
    let hash = pass_make(password, salt, iters)
    let ins = idm_user_create(orm_db_q(q), email, name, hash, salt, iters, 1)?
    if orm_ok(ins) == 0 {
        print(concat("seed admin failed: ", orm_err_exec(ins)))
        return 1
    }
    print(concat("seed admin: ", email))
    return 0
}

fn main() -> i64 !Net !IO !Par !Random !Time {
    let rc = boot_migrate()?
    if rc != 0 {
        return rc
    }
    // Фонови задачи (Фаза 6). SECP_SCHED_MS=0 ги изключва — нужно за
    // тестове и за `--check`, където не искаме безкраен worker.
    let tick = ops_tick_ms()?
    if tick > 0 {
        ops_start(tick)?
    }
    // Realtime канал (Фаза 3): един poll worker за WS. SECP_WS_PORT=0 го
    // изключва (тестове, `--check`); без променлива слуша на HTTP порт + 1.
    wsg_start()?
    return fmr_run()?
}
