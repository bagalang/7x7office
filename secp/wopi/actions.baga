// wopi/actions.baga — WOPI host за Collabora/OnlyOffice.
// Токенът се издава от влезлия потребител. Самото четене/запис
// носи access_token и минава през същите права като REST.

import "locks.baga"
import "../tree/auth.baga"
import "../tree/model.baga"
import "../tree/store.baga"
import "../tree/acl_model.baga"
import "../idm/user_model.baga"
import "../idm/ws_model.baga"
import "../idm/ws_roles.baga"
import "../data/crypt.baga"
import "wopibaga/wopi.baga"
import "jwtbaga/jwt.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "querybaga/query.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/time/time.baga"

struct WopiWho {
    ok: i64,
    db: OrmDb,
    user_id: i64,
    file_id: i64,
    ws: i64,
    path: str,
    name: str,
    size: i64,
    hash: str,
    owner_id: i64,
    friendly: str,
    can_write: i64,
    out: FmrOut
}

fn wopi_who_bad(db: OrmDb, out: FmrOut) -> WopiWho {
    return WopiWho {
        ok: 0, db: db, user_id: 0, file_id: 0, ws: 0, path: "", name: "",
        size: 0, hash: "", owner_id: 0, friendly: "", can_write: 0, out: out
    }
}

fn wopi_now() -> i64 !Time {
    return time_now_ms() / 1000
}

fn wopi_ttl_s() -> i64 !IO {
    let raw = env("SECP_WOPI_TTL_MIN")?
    if raw == "" {
        return 3600
    }
    let n = parse_int(raw)
    if n < 1 {
        return 3600
    }
    return n * 60
}

fn wopi_reply(db: OrmDb, status: i64, lock: str, version: str) -> FmrOut {
    let mut r = http_response(status, "")
    r = http_set_header(r, "X-WOPI-Lock", lock)
    if version != "" {
        r = http_set_header(r, "X-WOPI-ItemVersion", version)
    }
    return fmr_out(r, db)
}

fn wopi_open(ctx: FmrCtx, db: OrmDb) -> WopiWho !IO !Net !Time {
    let tok = query_decode_val(fmr_query(ctx, "access_token"))
    if tok == "" {
        return wopi_who_bad(db, act_err(db, 401, "no token"))
    }
    if jwt_verify_hs256(ctx.jwt_secret, tok) == 0 {
        return wopi_who_bad(db, act_err(db, 401, "bad token"))
    }
    let now = wopi_now()
    if jwt_claim_int(tok, "exp") < now {
        return wopi_who_bad(db, act_err(db, 401, "expired"))
    }
    let uid = jwt_claim_int(tok, "sub")
    let fid = jwt_claim_int(tok, "fid")
    let url_id = fmr_param_i64(ctx, "id")
    if uid < 1 || fid < 1 || fid != url_id {
        return wopi_who_bad(db, act_err(db, 404, "not found"))
    }
    let uq = idm_user_find(db, uid)?
    if orm_ok_q(uq) == 0 {
        return wopi_who_bad(orm_db_q(uq), act_err(orm_db_q(uq), 500, orm_err_q(uq)))
    }
    if orm_nrows(uq) < 1 {
        return wopi_who_bad(orm_db_q(uq), act_err(orm_db_q(uq), 401, "unknown user"))
    }
    let friendly = orm_cell_by(uq, 0, "name")
    let mut shown = friendly
    if shown == "" {
        shown = orm_cell_by(uq, 0, "email")
    }
    let is_admin = orm_cell_by_i64(uq, 0, "is_admin")
    let nq = tree_find_id(orm_db_q(uq), fid)?
    if orm_ok_q(nq) == 0 {
        return wopi_who_bad(orm_db_q(nq), act_err(orm_db_q(nq), 500, orm_err_q(nq)))
    }
    if orm_nrows(nq) < 1 {
        return wopi_who_bad(orm_db_q(nq), act_err(orm_db_q(nq), 404, "not found"))
    }
    if orm_cell_by_i64(nq, 0, "is_dir") == 1 {
        return wopi_who_bad(orm_db_q(nq), act_err(orm_db_q(nq), 404, "not found"))
    }
    let ws = orm_cell_by_i64(nq, 0, "workspace_id")
    let path = orm_cell_by(nq, 0, "path")
    let name = orm_cell_by(nq, 0, "name")
    let size = orm_cell_by_i64(nq, 0, "size")
    let hash = orm_cell_by(nq, 0, "hash")
    let owner_id = orm_cell_by_i64(nq, 0, "owner_id")
    let acc = ws_access(orm_db_q(nq), ws, uid, is_admin)?
    if acc.ok == 0 {
        return wopi_who_bad(acc.db, act_err(acc.db, 404, "not found"))
    }
    let mut protect: i64 = 0
    if acc.role == "admin" || acc.role == "owner" {
        protect = 1
    }
    let eff = tree_acl_effective_at(acc.db, ws, uid, acc.role, path, acc.level, protect)?
    if eff.err != "" {
        return wopi_who_bad(eff.db, act_err(eff.db, 500, eff.err))
    }
    if ws_level_allows(eff.level, ws_role_level_viewer()) == 0 {
        return wopi_who_bad(eff.db, act_err(eff.db, 404, "not found"))
    }
    let mut write: i64 = 0
    if ws_level_allows(eff.level, ws_role_level_editor()) == 1 {
        write = 1
    }
    return WopiWho {
        ok: 1, db: eff.db, user_id: uid, file_id: fid, ws: ws, path: path,
        name: name, size: size, hash: hash, owner_id: owner_id,
        friendly: shown, can_write: write, out: fmr_out(http_response(200, ""), eff.db)
    }
}

fn wopi_apply_lock(db: OrmDb, file_id: i64, op: str, requested: str) -> FmrOut !IO !Net !Time {
    let row = wopi_lock_load(db, file_id)?
    if row.err != "" {
        return act_err(row.db, 500, row.err)
    }
    let now = wopi_now()
    let act = wopi_apply(op, row.lock, row.exp, now, requested)
    if act.status != 200 {
        return wopi_reply(row.db, act.status, act.lock, "")
    }
    let mut d = row.db
    if act.clear == 1 {
        let del = wopi_lock_del(d, file_id)?
        if orm_ok(del) == 0 {
            return act_err(orm_db_exec(del), 500, orm_err_exec(del))
        }
        d = orm_db_exec(del)
    }
    if act.store == 1 {
        let saved = wopi_lock_save(d, file_id, act.new_lock, now + wopi_lock_ttl_s())?
        if saved.err != "" {
            return act_err(saved.db, 500, saved.err)
        }
        d = saved.db
    }
    return wopi_reply(d, 200, act.lock, "")
}

fn act_wopi_token(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let fid = orm_cell_by_i64(q, 0, "id")
    let mut write: i64 = 0
    if ws_level_allows(t.level, ws_role_level_editor()) == 1 {
        write = 1
    }
    let ttl = wopi_ttl_s()?
    let exp = wopi_now() + ttl
    let mut payload = "{\"sub\":"
    payload = concat(payload, int_to_str(t.owner))
    payload = concat(payload, ",\"fid\":")
    payload = concat(payload, int_to_str(fid))
    payload = concat(payload, ",\"w\":")
    payload = concat(payload, int_to_str(write))
    payload = concat(payload, ",\"exp\":")
    payload = concat(payload, int_to_str(exp))
    payload = concat(payload, "}")
    let token = jwt_encode(ctx.jwt_secret, payload)
    let base = str_trim(env("SECP_PUBLIC_URL")?)
    let mut src = concat("/wopi/files/", int_to_str(fid))
    if base != "" {
        src = concat(base, src)
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "file_id", fid)
    o = jobj_str(o, "access_token", token)
    o = jobj_str(o, "wopi_src", src)
    o = jobj_i64(o, "can_write", write)
    return act_ok(orm_db_q(q), o)
}

fn act_wopi_file(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let who = wopi_open(ctx, db)?
    if who.ok == 0 {
        return who.out
    }
    if fmr_method(ctx) == "GET" {
        let mut ver = who.hash
        if ver == "" {
            ver = "0"
        }
        let body = wopi_check_json(who.name, int_to_str(who.owner_id), who.size, int_to_str(who.user_id), ver, who.friendly, who.can_write)
        let mut r = http_response(200, body)
        r = http_set_header(r, "Content-Type", "application/json")
        r = http_set_header(r, "X-WOPI-ItemVersion", ver)
        return fmr_out(r, who.db)
    }
    let op = fmr_header(ctx, "X-WOPI-Override")
    if op == "" {
        return wopi_reply(who.db, 400, "", "")
    }
    return wopi_apply_lock(who.db, who.file_id, op, fmr_header(ctx, "X-WOPI-Lock"))?
}

fn act_wopi_contents(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time !Random {
    let who = wopi_open(ctx, db)?
    if who.ok == 0 {
        return who.out
    }
    if fmr_method(ctx) == "GET" {
        let got = data_open(who.db, who.ws, who.hash)?
        if got.err != "" {
            return act_err(got.db, 500, got.err)
        }
        if bytes_len(got.body) == 0 && who.size > 0 {
            return act_err(got.db, 500, "blob missing")
        }
        let mut ver = who.hash
        if ver == "" {
            ver = "0"
        }
        let mut r = http_response_bytes(200, got.body)
        r = http_set_header(r, "X-WOPI-ItemVersion", ver)
        return fmr_out(r, got.db)
    }
    if who.can_write == 0 {
        return act_err(who.db, 401, "read only")
    }
    let row = wopi_lock_load(who.db, who.file_id)?
    if row.err != "" {
        return act_err(row.db, 500, row.err)
    }
    let act = wopi_apply("PUT", row.lock, row.exp, wopi_now(), fmr_header(ctx, "X-WOPI-Lock"))
    if act.status != 200 {
        return wopi_reply(row.db, act.status, act.lock, "")
    }
    let stored = tree_store_file(row.db, who.ws, who.user_id, who.path, http_body_bytes(ctx.req), 0)?
    if stored.resp.status >= 400 {
        return stored
    }
    let q = tree_find(stored.db, who.ws, who.path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "write ok but node missing")
    }
    let ver = orm_cell_by(q, 0, "hash")
    return wopi_reply(orm_db_q(q), 200, act.lock, ver)
}
