// tree/search_actions.baga — REST за търсене (Фаза 6).
//   GET /v1/search?q=...&limit=25
// и поддръжката на текстовия индекс (tree_text), който търсенето ползва.

import "auth.baga"
import "acl_model.baga"
import "acl_roles.baga"
import "model.baga"
import "search.baga"
import "text.baga"
import "../idm/user_model.baga"
import "../system/scheduler.baga"
import "ormbaga/orm.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "querybaga/query.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// ---------- GET /v1/search ----------

fn act_search(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db, 1, "")?
    if t.ok == 0 {
        return t.out
    }
    let raw = query_decode_val(fmr_query(ctx, "q"))
    let q = str_trim(raw)
    if len(q) < 2 {
        return act_err(t.out.db, 400, "query too short (min 2 chars)")
    }
    let pat = concat(concat("%", tree_search_esc(q)), "%")
    let limit = tree_search_limit(fmr_query(ctx, "limit"))
    let nq = tree_search_nodes(t.out.db, t.ws, pat, limit)?
    if orm_ok_q(nq) == 0 {
        return act_err(orm_db_q(nq), 500, orm_err_q(nq))
    }
    let mut d = orm_db_q(nq)
    // Търсенето чете ИМЕНА и СЪДЪРЖАНИЕ — трябва да уважава изричните права
    // по път, иначе viewer научава за файлове, които не може да отвори.
    // Редовете се теглят веднъж и се филтрират в паметта (виж acl_model.baga).
    let mut protect: i64 = 0
    if t.role == "admin" || t.role == "owner" {
        protect = 1
    }
    let acl = tree_acl_subject_rows(d, t.ws, t.owner, t.role)?
    if acl.err != "" {
        return act_err(acl.db, 500, acl.err)
    }
    d = acl.db
    let mut arr = jarr_new()
    let mut i: i64 = 0
    let mut kept: i64 = 0
    while i < orm_nrows(nq) {
        let p = orm_cell_by(nq, i, "path")
        if acl_effective(acl.paths, acl.levels, acl.inherits, p, t.level, protect) >= acl_level_read() {
            arr = jarr_obj(arr, tree_search_json(nq, i))
            kept = kept + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "query", q)
    o = jobj_i64(o, "limit", limit)
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", kept)
    return act_ok(d, o)
}

// ---------- POST /v1/search/reindex (админ) ----------

// Планира extract-text за всички файлове, които още нямат текст в индекса.
// Нужно е веднъж след въвеждане на търсенето (файловете отпреди фаза 6).
// Идемпотентно: редовете с текст не се пипат; задачите вървят на партиди.
fn act_search_reindex(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let a = act_require_auth(ctx, db)
    if a.ok == 0 {
        return a.out
    }
    // само администратор: пипа индекса на всички, не само своите файлове
    let u = idm_user_find_by_email(db, a.ctx.user_sub)?
    if orm_ok_q(u) == 0 || orm_nrows(u) < 1 {
        return act_err(db, 401, "unknown user")
    }
    if orm_cell_by_i64(u, 0, "is_admin") != 1 {
        return act_err(orm_db_q(u), 403, "admin only")
    }
    let sql = "SELECT n.id FROM tree_nodes n LEFT JOIN tree_text t ON t.node_id = n.id WHERE n.is_dir = 0 AND t.node_id IS NULL ORDER BY n.id LIMIT 1000"
    let q = orm_query_params_str(orm_db_q(u), sql, vec_new())?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut d = orm_db_q(q)
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let nid = orm_cell_by_i64(q, i, "id")
        let e = ops_enqueue(d, "extract-text", int_to_str(nid))?
        if orm_ok(e) == 0 {
            return act_err(orm_db_exec(e), 500, orm_err_exec(e))
        }
        d = orm_db_exec(e)
        n = n + 1
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "enqueued", n)
    return act_ok(d, o)
}
