// tree/ws_cleanup.baga — изтриване на цялото дърво на workspace (Фаза 2).
//
// Вика се при DELETE /v1/workspaces. Без това възлите остават „сираци":
// workspace-ът го няма, но редовете и blob-овете продължават да заемат
// място и (по-лошо) hash-овете им пречат на GC-то да изчисти нищо.
//
// Тук, а не в idm/ws_actions.baga, защото idm вече се ползва от tree
// (auth → ws_access) и обратният импорт би направил цикъл. tree не вика
// idm оттук — само orm.
//
// Файловете са версионни: трием и tree_versions, и tree_text (те нямат
// FK на boila — виж gaps), и чак накрая GC-то на blob-овете.

import "model.baga"
import "acl_model.baga"
import "activity_model.baga"
import "../system/chat_model.baga"
import "dav_lock.baga"
import "share_model.baga"
import "versions.baga"
import "../data/blobs.baga"
import "../data/keys.baga"
import "../wopi/locks.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

struct TreeWsPurge {
    db: OrmDb,
    nodes: i64,
    err: str
}

fn tree_ws_purge_nodes(db: OrmDb, ws: i64) -> i64 !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    let e = orm_exec_params_str(db, "DELETE FROM tree_nodes WHERE workspace_id = $1", vals)?
    if orm_ok(e) == 0 {
        return -1
    }
    return 0
}

// Всички blob hash-ове, които workspace-ът държи жив (възли + версии).
// Събират се ПРЕДИ триенето — после няма откъде да се прочетат.
//
// boilaSQL няма UNION, затова са 3 отделни заявки (hash, thumb_hash от
// tree_nodes + hash от tree_versions), а дублираните се махат в кода.
struct WsHashes {
    db: OrmDb,
    err: str,
    n: i64,
    hashes: Vec<str>
}

fn ws_hash_in(hashes: Vec<str>, h: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(hashes) {
        if vec_get(hashes, i) == h {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Една колона hash → долепяне към списъка (без повторения).
fn ws_hashes_append(hs: WsHashes, q: OrmQuery) -> WsHashes {
    let mut out = hs
    out.db = orm_db_q(q)
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let h = orm_cell_by(q, i, "hash")
        if h != "" && ws_hash_in(out.hashes, h) == 0 {
            vec_push(out.hashes, h)
        }
        i = i + 1
    }
    out.n = vec_len(out.hashes)
    return out
}

fn tree_ws_purge_hashes(db: OrmDb, ws: i64) -> WsHashes !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    let mut hs = WsHashes { db: db, err: "", n: 0, hashes: vec_new() }
    let q1 = orm_query_params_str(db, "SELECT hash FROM tree_nodes WHERE workspace_id = $1 AND hash != ''", vals)?
    if orm_ok_q(q1) == 0 {
        return WsHashes { db: orm_db_q(q1), err: orm_err_q(q1), n: 0, hashes: vec_new() }
    }
    hs = ws_hashes_append(hs, q1)
    let q2 = orm_query_params_str(hs.db, "SELECT thumb_hash AS hash FROM tree_nodes WHERE workspace_id = $1 AND thumb_hash != ''", vals)?
    if orm_ok_q(q2) == 0 {
        return WsHashes { db: orm_db_q(q2), err: orm_err_q(q2), n: 0, hashes: vec_new() }
    }
    hs = ws_hashes_append(hs, q2)
    let q3 = orm_query_params_str(hs.db, "SELECT hash FROM tree_versions WHERE workspace_id = $1 AND hash != ''", vals)?
    if orm_ok_q(q3) == 0 {
        return WsHashes { db: orm_db_q(q3), err: orm_err_q(q3), n: 0, hashes: vec_new() }
    }
    hs = ws_hashes_append(hs, q3)
    return hs
}

// Пълен цикъл: hash-ове → версии → текст → възли → GC.
// best-effort за blob-овете: ако един GC се провали, останалите пак се
// чистят (иначе един заседнал blob би спрял цялото триене).
fn tree_ws_purge(db: OrmDb, ws: i64) -> TreeWsPurge !IO !Net !Time !Random {
    if ws < 1 {
        return TreeWsPurge { db: db, nodes: 0, err: "bad workspace id" }
    }
    let hq = tree_ws_purge_hashes(db, ws)?
    if hq.err != "" {
        return TreeWsPurge { db: hq.db, nodes: 0, err: hq.err }
    }
    let mut d = hq.db
    let n = hq.n
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    // ACL редовете нямат FK на boila — трият се ръчно, преди възлите (за
    // да не останат права към пътища, които вече ги няма).
    if tree_acl_purge_ws(d, ws) < 0 {
        return TreeWsPurge { db: d, nodes: 0, err: "delete acl failed" }
    }
    // Публичните линкове на пространството се отнемат (няма FK на boila).
    let sl = share_revoke_ws(d, ws, share_now_s())?
    if sl.err != "" {
        return TreeWsPurge { db: sl.db, nodes: 0, err: sl.err }
    }
    d = sl.db
    // текстът е по node_id, не по workspace_id в DELETE-а за подсигуровка:
    // редовете на вече изтрити възли нямаше как да се хванат иначе.
    let t = orm_exec_params_str(d, "DELETE FROM tree_text WHERE workspace_id = $1", vals)?
    if orm_ok(t) == 0 {
        return TreeWsPurge { db: orm_db_exec(t), nodes: 0, err: orm_err_exec(t) }
    }
    d = orm_db_exec(t)
    let v = orm_exec_params_str(d, "DELETE FROM tree_versions WHERE workspace_id = $1", vals)?
    if orm_ok(v) == 0 {
        return TreeWsPurge { db: orm_db_exec(v), nodes: 0, err: orm_err_exec(v) }
    }
    d = orm_db_exec(v)
    let wl = wopi_lock_purge_ws(d, ws)?
    if wl.err != "" {
        return TreeWsPurge { db: wl.db, nodes: 0, err: wl.err }
    }
    d = wl.db
    let nd = tree_ws_purge_nodes(d, ws)
    if nd < 0 {
        return TreeWsPurge { db: d, nodes: 0, err: "delete nodes failed" }
    }
    // Одитът върви с пространството: ред, който сочи към изтрит workspace,
    // е недостъпен и само обърква (няма FK на boila — трие се ръчно).
    if tree_activity_purge_ws(d, ws) < 0 {
        return TreeWsPurge { db: d, nodes: 0, err: "delete activity failed" }
    }
    let ce = chat_purge_ws(d, ws)?
    if orm_ok(ce) == 0 {
        return TreeWsPurge { db: orm_db_exec(ce), nodes: 0, err: "delete chat failed" }
    }
    d = orm_db_exec(ce)
    let dl = dav_lock_purge_ws(d, ws)?
    if orm_ok(dl) == 0 {
        return TreeWsPurge { db: orm_db_exec(dl), nodes: 0, err: "delete locks failed" }
    }
    d = orm_db_exec(dl)
    let kd = data_key_drop(d, ws)?
    if orm_ok(kd) == 0 {
        return TreeWsPurge { db: orm_db_exec(kd), nodes: 0, err: "delete key failed" }
    }
    d = orm_db_exec(kd)
    // GC: има ли още някой друг (друг workspace/версия), или blob-ът е за триене
    let mut i: i64 = 0
    while i < n {
        let h = vec_get(hq.hashes, i)
        if h != "" {
            tree_ver_gc(d, ws, h)?
        }
        i = i + 1
    }
    return TreeWsPurge { db: d, nodes: n, err: "" }
}
