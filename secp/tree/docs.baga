// tree/docs.baga — офис редактор: load / save на документи и таблици.
// Осчетоводяването на формата (md ↔ docx/odt/xlsx/ods) е в officebaga;
// тук е само протоколът на secp: намери реда, сглоби обратно, запиши.
//
// Изнесено от actions.baga (filesize gate).

import "auth.baga"
import "store.baga"
import "model.baga"
import "versions.baga"
import "../data/blobs.baga"
import "../data/crypt.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "officebaga/office.baga"
import "pathbaga/path.baga"
import "querybaga/query.baga"
import "std/crypto/sha256.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// Editable kinds. Legacy OLE (.doc/.xls) is read-only; empty = not editable.
fn tree_doc_kind(ext: str) -> str {
    if ext == "docx" || ext == "odt" || ext == "txt" || ext == "md" {
        return "doc"
    }
    if ext == "xlsx" || ext == "ods" || ext == "csv" {
        return "sheet"
    }
    if ext == "doc" || ext == "xls" {
        return "legacy"
    }
    return ""
}

fn tree_doc_title(name: str, ext: str) -> str {
    let cut = len(ext) + 1
    if len(name) <= cut {
        return name
    }
    return substr(name, 0, len(name) - cut)
}

// `/dir/name.conflict-<hash8>.ext` — concurrent edits land here (Cells-style
// conflict copies), never silently overwriting the other writer's content.
fn tree_conflict_path(path: str, hash: str) -> str {
    let dir = tree_parent_of(path)
    let name = tree_name_of(path)
    let ext = path_ext(path)
    let mut stem = name
    if len(ext) > 0 && len(name) > len(ext) {
        stem = substr(name, 0, len(name) - len(ext))
    }
    let mut p = concat(stem, ".conflict-")
    p = concat(p, substr(hash, 0, 8))
    p = concat(p, ext)
    if dir == "/" {
        return concat("/", p)
    }
    return concat(concat(dir, "/"), p)
}

fn act_doc_load(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random !Time {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let ext = tree_ext(path)
    let kind = tree_doc_kind(ext)
    if kind == "" {
        return act_err(orm_db_q(q), 400, "not an editable document")
    }
    let hash = orm_cell_by(q, 0, "hash")
    let size = orm_cell_by_i64(q, 0, "size")
    let got = data_open(orm_db_q(q), t.ws, hash)?
    if got.err != "" {
        return act_err(got.db, 500, got.err)
    }
    if bytes_len(got.body) == 0 && size > 0 {
        return act_err(got.db, 500, "blob missing")
    }
    let body = got.body
    let mut text = ""
    if ext == "txt" || ext == "md" || ext == "csv" {
        text = str_of_bytes(body)
    }
    if ext == "docx" || ext == "odt" || ext == "doc" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            if ext == "docx" {
                text = office_to_markdown_rich(opened.doc)
            } else {
                text = office_to_markdown(opened.doc)
            }
        }
    }
    if ext == "xlsx" || ext == "ods" || ext == "xls" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            text = office_plain_text(opened.doc)
        }
    }
    let mut o = jobj_new()
    o = jobj_str(o, "name", name)
    o = jobj_str(o, "path", path)
    o = jobj_str(o, "kind", kind)
    o = jobj_str(o, "format", ext)
    o = jobj_str(o, "etag", hash)
    o = jobj_str(o, "text", text)
    return act_ok(got.db, o)
}

fn act_doc_save(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time !Random {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 2, path)?
    if t.ok == 0 {
        return t.out
    }
    if path == "/" {
        return act_err(db, 400, "cannot overwrite root")
    }
    let ext = tree_ext(path)
    let kind = tree_doc_kind(ext)
    if kind == "" {
        return act_err(db, 400, "not an editable document")
    }
    if kind == "legacy" {
        return act_err(db, 400, "legacy format: convert to .docx/.xlsx first")
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 409, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let text = str_of_bytes(http_body_bytes(ctx.req))
    let title = tree_doc_title(name, ext)
    let mut out = bytes_of_str("")
    if ext == "docx" {
        out = office_md_to_docx_bytes(text)
    }
    if ext == "odt" {
        out = office_odt_bytes(title, office_md_to_plain(text))
    }
    if ext == "xlsx" {
        out = office_xlsx_bytes(text)
    }
    if ext == "ods" {
        out = office_ods_bytes(text)
    }
    if ext == "txt" || ext == "md" || ext == "csv" {
        out = bytes_of_str(text)
    }
    if bytes_len(out) < 1 {
        return act_err(orm_db_q(q), 500, "document conversion failed")
    }
    // ETag check: the editor sends the hash it loaded; a mismatch means
    // someone else saved meanwhile → conflict copy, not an overwrite.
    let want = query_decode_val(fmr_query(ctx, "etag"))
    if want != "" && want != orm_cell_by(q, 0, "hash") {
        let cpath = tree_conflict_path(path, sha256_b_hex(out))
        let stored = tree_store_file(orm_db_q(q), t.ws, t.owner, cpath, out, 0)?
        if stored.resp.status >= 200 && stored.resp.status < 300 {
            return act_err(stored.db, 409, concat("файлът е променен междувременно; записано като ", cpath))
        }
        return stored
    }
    return tree_store_file(orm_db_q(q), t.ws, t.owner, path, out, 0)?
}
