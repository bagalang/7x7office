// tree/auth.baga — bearer → owner id + query path decoding + mime таблица.
// Общи за всички файлови handler-и; изнесено от actions.baga (filesize gate).

import "../idm/user_model.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "ormbaga/orm.baga"
import "pathbaga/path.baga"
import "querybaga/query.baga"
import "std/str/str.baga"

// ---------- auth: bearer → owner id ----------

struct TreeAuth {
    ok: i64,
    owner: i64,
    out: FmrOut
}

// Query values arrive percent-encoded (Next encodes the path). httpdbaga
// returns them raw; decode here before tree_norm.
fn tree_qpath(ctx: FmrCtx, name: str) -> str {
    return tree_norm(query_decode_val(fmr_query(ctx, name)))
}

fn tree_auth(ctx: FmrCtx, db: OrmDb) -> TreeAuth !IO !Net {
    let a = act_require_auth(ctx, db)
    if a.ok == 0 {
        return TreeAuth { ok: 0, owner: 0, out: a.out }
    }
    let q = idm_user_find_by_email(db, a.ctx.user_sub)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        let mut d = db
        if orm_ok_q(q) == 1 {
            d = orm_db_q(q)
        }
        return TreeAuth { ok: 0, owner: 0, out: act_err(d, 401, "unknown user") }
    }
    return TreeAuth { ok: 1, owner: orm_cell_by_i64(q, 0, "id"), out: fmr_out(http_response(200, ""), orm_db_q(q)) }
}

// ---------- mime ----------

// path_ext keeps the leading dot (".docx"). Comparisons want "docx".
fn tree_ext(path: str) -> str {
    let mut ext = path_ext(path)
    if str_starts_with(ext, ".") {
        ext = substr(ext, 1, len(ext))
    }
    return to_lower(ext)
}

fn tree_mime(path: str) -> str {
    let ext = tree_ext(path)
    if ext == "png" { return "image/png" }
    if ext == "jpg" { return "image/jpeg" }
    if ext == "jpeg" { return "image/jpeg" }
    if ext == "gif" { return "image/gif" }
    if ext == "webp" { return "image/webp" }
    if ext == "bmp" { return "image/bmp" }
    if ext == "ico" { return "image/x-icon" }
    if ext == "svg" { return "image/svg+xml" }
    if ext == "pdf" { return "application/pdf" }
    if ext == "txt" { return "text/plain; charset=utf-8" }
    if ext == "md" { return "text/markdown; charset=utf-8" }
    if ext == "csv" { return "text/csv; charset=utf-8" }
    if ext == "json" { return "application/json" }
    if ext == "html" { return "text/html; charset=utf-8" }
    if ext == "zip" { return "application/zip" }
    if ext == "docx" { return "application/vnd.openxmlformats-officedocument.wordprocessingml.document" }
    if ext == "xlsx" { return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
    if ext == "odt" { return "application/vnd.oasis.opendocument.text" }
    if ext == "ods" { return "application/vnd.oasis.opendocument.spreadsheet" }
    return "application/octet-stream"
}

fn tree_mime_inline(mime: str) -> i64 {
    if str_starts_with(mime, "image/") { return 1 }
    if str_starts_with(mime, "text/") { return 1 }
    if mime == "application/pdf" { return 1 }
    return 0
}
