// tree/auth.baga — bearer → workspace scope + query path decoding + mime таблица.
// Общи за всички файлови handler-и; изнесено от actions.baga (filesize gate).
//
// Фаза 2: файловете са на WORKSPACE, не на потребител. Всеки handler казва
// какво ниво му трябва (`need`): 1 = четене (viewer), 2 = запис (editor).
// Без ?workspace_id= се работи в ЛИЧНИЯ workspace — така старите URL-и
// продължават да значат същото и никой клиент не се чупи.

import "../idm/user_model.baga"
import "../idm/ws_model.baga"
import "../idm/ws_roles.baga"
import "acl_model.baga"
import "acl_roles.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "ormbaga/orm.baga"
import "pathbaga/path.baga"
import "querybaga/query.baga"
import "std/str/str.baga"

// ---------- auth: bearer → workspace scope ----------

struct TreeAuth {
    ok: i64,
    ws: i64,
    owner: i64,
    level: i64,
    role: str,
    is_admin: i64,
    out: FmrOut
}

// Query values arrive percent-encoded (Next encodes the path). httpdbaga
// returns them raw; decode here before tree_norm.
fn tree_qpath(ctx: FmrCtx, name: str) -> str {
    return tree_norm(query_decode_val(fmr_query(ctx, name)))
}

// ?workspace_id= — липсващо/нечислово → 0, което значи „личният".
// Не ползваме parse_int директно: той приема и "-5"/"1x" и после
// отрицателно id тихо би минало за „няма достъп" вместо за грешка.
fn tree_qws(ctx: FmrCtx) -> i64 {
    let raw = str_trim(fmr_query(ctx, "workspace_id"))
    if raw == "" {
        return 0
    }
    let mut i: i64 = 0
    let n = len(raw)
    while i < n {
        let c = char_at(raw, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return parse_int(raw)
}

fn tree_auth_deny(db: OrmDb, out: FmrOut) -> TreeAuth {
    return TreeAuth { ok: 0, ws: 0, owner: 0, level: 0, role: "", is_admin: 0, out: out }
}

// need: 1 = може да чете, 2 = може да пише (виж ws_roles.baga).
// Чуждият workspace дава 404, не 403 — иначе по кода се разбира, че
// съществува (същото правило като в ws_actions.baga).
//
// `path`: ако е зададен, върху базовото ниво от ролята се прилагат и
// изричните ACL редове за този път (най-специфичният печели). Ако
// липсва (празен низ), важи само ролята — както досега.
fn tree_auth(ctx: FmrCtx, db: OrmDb, need: i64, path: str) -> TreeAuth !IO !Net {
    let a = act_require_auth(ctx, db)
    if a.ok == 0 {
        return tree_auth_deny(db, a.out)
    }
    let q = idm_user_find_by_email(db, a.ctx.user_sub)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        let mut d = db
        if orm_ok_q(q) == 1 {
            d = orm_db_q(q)
        }
        return tree_auth_deny(d, act_err(d, 401, "unknown user"))
    }
    let mut d = orm_db_q(q)
    let uid = orm_cell_by_i64(q, 0, "id")
    let is_admin = orm_cell_by_i64(q, 0, "is_admin")
    let mut ws = tree_qws(ctx)
    if ws == 0 {
        // Личният workspace се създава при нужда: файловете на стар
        // потребител трябва да имат къде да живеят още при първата заявка.
        let ens = ws_personal_ensure(d, uid)?
        if ens.err != "" {
            return tree_auth_deny(ens.db, act_err(ens.db, 500, ens.err))
        }
        ws = ens.id
        d = ens.db
    }
    if ws < 1 {
        return tree_auth_deny(d, act_404(d, "workspace not found"))
    }
    // Съществуването се проверява ПРЕДИ правата: админът иначе минава
    // директно (ws_access връща admin за всеки id) и „влиза" в
    // несъществуващ workspace, което обърква клиента с празен списък
    // вместо с 404.
    let wq = ws_find(d, ws)?
    if orm_ok_q(wq) == 0 {
        return tree_auth_deny(orm_db_q(wq), act_err(orm_db_q(wq), 500, orm_err_q(wq)))
    }
    if orm_nrows(wq) < 1 {
        return tree_auth_deny(orm_db_q(wq), act_404(orm_db_q(wq), "workspace not found"))
    }
    d = orm_db_q(wq)
    let acc = ws_access(d, ws, uid, is_admin)?
    if acc.ok == 0 {
        return tree_auth_deny(acc.db, act_404(acc.db, "workspace not found"))
    }
    let mut level = acc.level
    d = acc.db
    // Изричните права по път се прилагат върху ролята. owner/admin се
    // пазят от самозаключване (protect=1 — виж acl_roles.baga).
    if path != "" {
        let mut protect: i64 = 0
        if acc.role == "admin" || acc.role == "owner" {
            protect = 1
        }
        let eff = tree_acl_effective_at(d, ws, uid, acc.role, tree_norm(path), acc.level, protect)?
        if eff.err != "" {
            return tree_auth_deny(eff.db, act_err(eff.db, 500, eff.err))
        }
        level = eff.level
        d = eff.db
    }
    if ws_level_allows(level, need) == 0 {
        return tree_auth_deny(d, act_err(d, 403, "insufficient rights"))
    }
    return TreeAuth {
        ok: 1,
        ws: ws,
        owner: uid,
        level: level,
        role: acc.role,
        is_admin: is_admin,
        out: fmr_out(http_response(200, ""), d)
    }
}

// ---------- mime ----------

// path_ext keeps the leading dot (".docx"). Comparisons want "docx".
fn tree_ext(path: str) -> str {
    let mut ext = path_ext(path)
    if str_starts_with(ext, ".") {
        ext = substr(ext, 1, len(ext))
    }
    return to_lower(ext)
}

fn tree_mime(path: str) -> str {
    let ext = tree_ext(path)
    if ext == "png" { return "image/png" }
    if ext == "jpg" { return "image/jpeg" }
    if ext == "jpeg" { return "image/jpeg" }
    if ext == "gif" { return "image/gif" }
    if ext == "webp" { return "image/webp" }
    if ext == "bmp" { return "image/bmp" }
    if ext == "ico" { return "image/x-icon" }
    if ext == "svg" { return "image/svg+xml" }
    if ext == "pdf" { return "application/pdf" }
    if ext == "txt" { return "text/plain; charset=utf-8" }
    if ext == "md" { return "text/markdown; charset=utf-8" }
    if ext == "csv" { return "text/csv; charset=utf-8" }
    if ext == "json" { return "application/json" }
    if ext == "html" { return "text/html; charset=utf-8" }
    if ext == "zip" { return "application/zip" }
    if ext == "docx" { return "application/vnd.openxmlformats-officedocument.wordprocessingml.document" }
    if ext == "xlsx" { return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
    if ext == "odt" { return "application/vnd.oasis.opendocument.text" }
    if ext == "ods" { return "application/vnd.oasis.opendocument.spreadsheet" }
    return "application/octet-stream"
}

fn tree_mime_inline(mime: str) -> i64 {
    if str_starts_with(mime, "image/") { return 1 }
    if str_starts_with(mime, "text/") { return 1 }
    if mime == "application/pdf" { return 1 }
    return 0
}
