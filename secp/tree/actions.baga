// tree/actions.baga — file API: list / stat / mkdir / put / get / thumb / delete / move / usage.
// Paths come as ?path= query params because the fmrbaga router matches
// per-segment params only (no wildcards yet — gaps G5). Real path URLs
// arrive with the WebDAV gateway (davbaga, Phase 4).
//
// Споделеното с останалите файлове (auth/mime, store flow, thumbnails) е в
// auth.baga и store.baga; версиите и zip-ът са в versions_files.baga.

import "auth.baga"
import "acl_model.baga"
import "store.baga"
import "model.baga"
import "versions.baga"
import "text.baga"
import "../data/blobs.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "officebaga/office.baga"
import "pathbaga/path.baga"
import "querybaga/query.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// ---------- handlers ----------

fn act_fs_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    // Пътят влиза в auth-а: изричните права (ACL) може да стеснят или
    // разширят ролята точно за този път.
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let mut d = db
    if path != "/" {
        let nq = tree_find(d, t.ws, path)?
        if orm_ok_q(nq) == 0 {
            return act_err(orm_db_q(nq), 500, orm_err_q(nq))
        }
        if orm_nrows(nq) < 1 {
            return act_404(orm_db_q(nq), "path not found")
        }
        if orm_cell_by_i64(nq, 0, "is_dir") == 0 {
            return act_err(orm_db_q(nq), 400, "not a directory")
        }
        d = orm_db_q(nq)
    }
    let q = tree_children(d, t.ws, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    // Изричните права може да заключват ПОДпапки, а родителят да е отворен.
    // Без този филтър списъкът издава имената на заключените деца (и UI-ът
    // показва папка, която дава 403 при отваряне). Редовете се теглят веднъж
    // и се проверяват в паметта — същият модел като в търсенето.
    let mut protect: i64 = 0
    if t.role == "admin" || t.role == "owner" {
        protect = 1
    }
    let acl = tree_acl_subject_rows(d, t.ws, t.owner, t.role)?
    if acl.err != "" {
        return act_err(acl.db, 500, acl.err)
    }
    d = acl.db
    let mut arr = jarr_new()
    let mut kept: i64 = 0
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        let cp = orm_cell_by(q, i, "path")
        if acl_effective(acl.paths, acl.levels, acl.inherits, cp, t.level, protect) >= acl_level_read() {
            arr = jarr_obj(arr, tree_node_json(q, i))
            kept = kept + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "path", path)
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", kept)
    return act_ok(d, o)
}

fn act_fs_stat(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "path not found")
    }
    return act_ok(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_mkdir(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 2, path)?
    if t.ok == 0 {
        return t.out
    }
    if path == "/" {
        return act_err(db, 400, "root exists")
    }
    let err = tree_mkdir_p(db, t.ws, t.owner, path)?
    if err != "" {
        return act_err(db, 409, err)
    }
    let q = tree_find(db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "mkdir ok but node missing")
    }
    return act_created(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_put(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 2, path)?
    if t.ok == 0 {
        return t.out
    }
    if path == "/" {
        return act_err(db, 400, "cannot overwrite root")
    }
    let body = http_body_bytes(ctx.req)
    let size = bytes_len(body)
    if size < 1 {
        return act_err(db, 400, "empty body")
    }
    let maxf = tree_max_file_bytes()?
    if size > maxf {
        return act_err(db, 413, "file too large")
    }
    return tree_store_file(db, t.ws, t.owner, path, body, 1)?
}

fn act_fs_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let hash = orm_cell_by(q, 0, "hash")
    let name = orm_cell_by(q, 0, "name")
    let body = data_blob_get(hash)?
    if bytes_len(body) == 0 && orm_cell_by_i64(q, 0, "size") > 0 {
        return act_err(orm_db_q(q), 500, "blob missing")
    }
    let mime = tree_mime(path)
    let mut r = http_response_bytes(200, body)
    r = http_set_header(r, "Content-Type", mime)
    r = http_set_header(r, "ETag", hash)
    let mut disp = "attachment"
    if tree_mime_inline(mime) == 1 {
        disp = "inline"
    }
    r = http_set_header(r, "Content-Disposition", concat(concat(disp, "; filename=\""), concat(name, "\"")))
    return fmr_out(r, orm_db_q(q))
}

// Text preview for the file manager. Office files go through officebaga.
// Images stay on /v1/fs/file — this returns kind "image" without the bytes.
fn tree_preview_cap(text: str) -> str {
    if len(text) <= 20000 {
        return text
    }
    return concat(substr(text, 0, 20000), "\n…")
}

fn tree_office_text(body: bytes) -> str {
    let opened = office_open_bytes(body)
    if opened.ok == 0 {
        return ""
    }
    let md = office_to_markdown_rich(opened.doc)
    if md != "" {
        return md
    }
    return office_plain_text(opened.doc)
}

fn act_fs_preview(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let ext = tree_ext(path)
    let mut kind = "empty"
    let mut text = ""
    if ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif" || ext == "webp" || ext == "bmp" {
        kind = "image"
    } else {
        if ext == "pdf" {
            // pdfbaga is a writer; the browser renders the blob natively.
            kind = "pdf"
        } else {
            if ext == "zip" {
                // entries are listed via /v1/fs/zip/list
                kind = "zip"
            } else {
                let hash = orm_cell_by(q, 0, "hash")
                let body = data_blob_get(hash)?
                if bytes_len(body) == 0 && orm_cell_by_i64(q, 0, "size") > 0 {
                    return act_err(orm_db_q(q), 500, "blob missing")
                }
                if ext == "md" {
                    kind = "markdown"
                    text = str_of_bytes(body)
                }
                if ext == "csv" {
                    kind = "csv"
                    text = str_of_bytes(body)
                }
                if ext == "xlsx" || ext == "xls" || ext == "ods" {
                    // TSV rows → table in the UI
                    let opened = office_open_bytes(body)
                    if opened.ok == 1 {
                        text = office_plain_text(opened.doc)
                    }
                    if text != "" {
                        kind = "sheet"
                    }
                }
                if ext == "docx" || ext == "doc" || ext == "odt" {
                    text = tree_office_text(body)
                    if text != "" {
                        kind = "markdown"
                    }
                }
                if ext == "txt" || ext == "json" || ext == "html" {
                    text = str_of_bytes(body)
                    if text != "" {
                        kind = "text"
                    }
                }
                if text != "" && (kind == "markdown" || kind == "csv" || kind == "sheet" || kind == "text") {
                    text = tree_preview_cap(text)
                }
            }
        }
    }
    let mut o = jobj_new()
    o = jobj_str(o, "name", name)
    o = jobj_str(o, "kind", kind)
    o = jobj_str(o, "text", text)
    return act_ok(orm_db_q(q), o)
}

fn act_fs_thumb(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 1, path)?
    if t.ok == 0 {
        return t.out
    }
    let q = tree_find(t.out.db, t.ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    let thumb = orm_cell_by(q, 0, "thumb_hash")
    if thumb == "" {
        return act_404(orm_db_q(q), "no thumbnail")
    }
    let body = data_blob_get(thumb)?
    if bytes_len(body) == 0 {
        return act_err(orm_db_q(q), 500, "thumb blob missing")
    }
    let mut r = http_response_bytes(200, body)
    r = http_set_header(r, "Content-Type", "image/png")
    r = http_set_header(r, "Cache-Control", "private, max-age=3600")
    return fmr_out(r, orm_db_q(q))
}

fn act_fs_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let path = tree_qpath(ctx, "path")
    let t = tree_auth(ctx, db, 2, path)?
    if t.ok == 0 {
        return t.out
    }
    if path == "/" {
        return act_err(db, 400, "cannot delete root")
    }
    // collect blob hashes before deleting rows (nodes + their versions)
    let sub = tree_subtree(db, t.ws, path)?
    if orm_ok_q(sub) == 0 {
        return act_err(orm_db_q(sub), 500, orm_err_q(sub))
    }
    if orm_nrows(sub) < 1 {
        return act_404(orm_db_q(sub), "path not found")
    }
    let hashes = vec_new()
    let mut d = orm_db_q(sub)
    let mut i: i64 = 0
    while i < orm_nrows(sub) {
        let h = orm_cell_by(sub, i, "hash")
        if h != "" {
            vec_push(hashes, h)
        }
        let th = orm_cell_by(sub, i, "thumb_hash")
        if th != "" {
            vec_push(hashes, th)
        }
        let nid = orm_cell_by_i64(sub, i, "id")
        let vh = tree_ver_hashes(d, nid)?
        if orm_ok_q(vh) == 0 {
            return act_err(orm_db_q(vh), 500, orm_err_q(vh))
        }
        let mut vi: i64 = 0
        while vi < orm_nrows(vh) {
            let vhash = orm_cell_by(vh, vi, "hash")
            if vhash != "" {
                vec_push(hashes, vhash)
            }
            vi = vi + 1
        }
        let vd = tree_ver_drop_node(orm_db_q(vh), nid)?
        if orm_ok(vd) == 0 {
            return act_err(orm_db_exec(vd), 500, orm_err_exec(vd))
        }
        d = orm_db_exec(vd)
        // текстовият индекс не е с FK (boila няма ON DELETE) — трием ръчно
        tree_text_drop(d, nid)?
        i = i + 1
    }
    let del = tree_delete_subtree(d, t.ws, path)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    d = orm_db_exec(del)
    // Изричните права следват живота на възела: ако на същия път се създаде
    // нов файл, старите ACL редове не бива тихо да важат за него.
    if tree_acl_drop_subtree(d, t.ws, path) < 0 {
        return act_err(d, 500, "delete acl failed")
    }
    i = 0
    while i < vec_len(hashes) {
        tree_ver_gc(d, vec_get(hashes, i))?
        i = i + 1
    }
    return act_no_content(d)
}

fn act_fs_move(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let from = tree_qpath(ctx, "from")
    let to = tree_qpath(ctx, "to")
    // Две проверки: можеш ли да махнеш от `from` И да създадеш в `to`.
    // Без второто viewer с write само в /public би преместил файл в
    // /private, където няма права.
    let t = tree_auth(ctx, db, 2, from)?
    if t.ok == 0 {
        return t.out
    }
    let t2 = tree_auth(ctx, t.out.db, 2, to)?
    if t2.ok == 0 {
        return t2.out
    }
    let mut d = t2.out.db
    if from == "/" || to == "/" {
        return act_err(d, 400, "cannot move root")
    }
    if from == to {
        return act_err(d, 400, "same path")
    }
    // no moving a dir into itself
    if str_starts_with(to, concat(from, "/")) {
        return act_err(d, 409, "cannot move into own subtree")
    }
    let dst = tree_find(d, t.ws, to)?
    if orm_ok_q(dst) == 0 {
        return act_err(orm_db_q(dst), 500, orm_err_q(dst))
    }
    if orm_nrows(dst) > 0 {
        return act_err(orm_db_q(dst), 409, "destination exists")
    }
    d = orm_db_q(dst)
    let sub = tree_subtree(d, t.ws, from)?
    if orm_ok_q(sub) == 0 {
        return act_err(orm_db_q(sub), 500, orm_err_q(sub))
    }
    if orm_nrows(sub) < 1 {
        return act_404(orm_db_q(sub), "path not found")
    }
    d = orm_db_q(sub)
    // target parent must exist (mkdir -p it, like put)
    let perr = tree_mkdir_p(d, t.ws, t.owner, tree_parent_of(to))?
    if perr != "" {
        return act_err(d, 409, perr)
    }
    // rewrite paths row by row (small trees; bulk SQL rewrite lands with versions)
    let mut i: i64 = 0
    while i < orm_nrows(sub) {
        let old_path = orm_cell_by(sub, i, "path")
        let new_path = concat(to, tree_tail(old_path, len(from)))
        let id = orm_cell_by_i64(sub, i, "id")
        let upd = tree_update_path(d, id, new_path, tree_parent_of(new_path), tree_name_of(new_path))?
        if orm_ok(upd) == 0 {
            return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
        }
        d = orm_db_exec(upd)
        i = i + 1
    }
    // ACL редовете също пътуват с поддървото — иначе правата остават на
    // стария (вече несъществуващ) път, а новият е без тях.
    let am = tree_acl_move_subtree(d, t.ws, from, to)?
    if am.err != "" {
        return act_err(am.db, 500, am.err)
    }
    d = am.db
    let q = tree_find(d, t.ws, to)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "move ok but node missing")
    }
    return act_ok(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_usage(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db, 1, "")?
    if t.ok == 0 {
        return t.out
    }
    let usage = tree_usage(db, t.ws)?
    if orm_ok_c(usage) == 0 {
        return act_err(orm_db_c(usage), 500, orm_err_c(usage))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "used_bytes", orm_count_n(usage))
    o = jobj_i64(o, "quota_bytes", tree_quota_bytes()?)
    o = jobj_i64(o, "workspace_id", t.ws)
    return act_ok(orm_db_c(usage), o)
}
