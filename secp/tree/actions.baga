// tree/actions.baga — file API: list / stat / mkdir / put / get / thumb / delete / move / usage.
// Paths come as ?path= query params because the fmrbaga router matches
// per-segment params only (no wildcards yet — gaps G5). Real path URLs
// arrive with the WebDAV gateway (davbaga, Phase 4).

import "model.baga"
import "versions.baga"
import "../data/blobs.baga"
import "../idm/user_model.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "httpdbaga/http.baga"
import "imgbaga/img.baga"
import "imgbaga/ops.baga"
import "officebaga/office.baga"
import "zipbaga/archive.baga"
import "pathbaga/path.baga"
import "querybaga/query.baga"
import "std/crypto/sha256.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// ---------- config ----------

fn tree_max_file_bytes() -> i64 !IO {
    let raw = env("SECP_MAX_FILE_MB")?
    if raw == "" {
        return 104857600  // 100 MiB
    }
    let n = parse_int(raw)
    if n < 1 {
        return 104857600
    }
    return n * 1048576
}

fn tree_quota_bytes() -> i64 !IO {
    let raw = env("SECP_QUOTA_MB")?
    if raw == "" {
        return 1073741824  // 1 GiB
    }
    let n = parse_int(raw)
    if n < 1 {
        return 1073741824
    }
    return n * 1048576
}

// Snapshots kept per node (oldest beyond that are dropped + GC'd).
fn tree_versions_keep() -> i64 !IO {
    let raw = env("SECP_VERSIONS_MAX")?
    if raw == "" {
        return 50
    }
    let n = parse_int(raw)
    if n < 1 {
        return 50
    }
    return n
}

// ---------- auth: bearer → owner id ----------

struct TreeAuth {
    ok: i64,
    owner: i64,
    out: FmrOut
}

// Query values arrive percent-encoded (Next encodes the path). httpdbaga
// returns them raw; decode here before tree_norm.
fn tree_qpath(ctx: FmrCtx, name: str) -> str {
    return tree_norm(query_decode_val(fmr_query(ctx, name)))
}

fn tree_auth(ctx: FmrCtx, db: OrmDb) -> TreeAuth !IO !Net {
    let a = act_require_auth(ctx, db)
    if a.ok == 0 {
        return TreeAuth { ok: 0, owner: 0, out: a.out }
    }
    let q = idm_user_find_by_email(db, a.ctx.user_sub)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        let mut d = db
        if orm_ok_q(q) == 1 {
            d = orm_db_q(q)
        }
        return TreeAuth { ok: 0, owner: 0, out: act_err(d, 401, "unknown user") }
    }
    return TreeAuth { ok: 1, owner: orm_cell_by_i64(q, 0, "id"), out: fmr_out(http_response(200, ""), orm_db_q(q)) }
}

// ---------- mime ----------

// path_ext keeps the leading dot (".docx"). Comparisons want "docx".
fn tree_ext(path: str) -> str {
    let mut ext = path_ext(path)
    if str_starts_with(ext, ".") {
        ext = substr(ext, 1, len(ext))
    }
    return to_lower(ext)
}

fn tree_mime(path: str) -> str {
    let ext = tree_ext(path)
    if ext == "png" { return "image/png" }
    if ext == "jpg" { return "image/jpeg" }
    if ext == "jpeg" { return "image/jpeg" }
    if ext == "gif" { return "image/gif" }
    if ext == "webp" { return "image/webp" }
    if ext == "bmp" { return "image/bmp" }
    if ext == "ico" { return "image/x-icon" }
    if ext == "svg" { return "image/svg+xml" }
    if ext == "pdf" { return "application/pdf" }
    if ext == "txt" { return "text/plain; charset=utf-8" }
    if ext == "md" { return "text/markdown; charset=utf-8" }
    if ext == "csv" { return "text/csv; charset=utf-8" }
    if ext == "json" { return "application/json" }
    if ext == "html" { return "text/html; charset=utf-8" }
    if ext == "zip" { return "application/zip" }
    if ext == "docx" { return "application/vnd.openxmlformats-officedocument.wordprocessingml.document" }
    if ext == "xlsx" { return "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
    if ext == "odt" { return "application/vnd.oasis.opendocument.text" }
    if ext == "ods" { return "application/vnd.oasis.opendocument.spreadsheet" }
    return "application/octet-stream"
}

fn tree_mime_inline(mime: str) -> i64 {
    if str_starts_with(mime, "image/") { return 1 }
    if str_starts_with(mime, "text/") { return 1 }
    if mime == "application/pdf" { return 1 }
    return 0
}

// ---------- thumbnails ----------

// 256px-max PNG thumbnail into the blob store; "" when not an image.
fn tree_make_thumb(content: bytes) -> str !IO {
    if bytes_len(content) > 20971520 {
        return ""
    }
    let info = img_info(content)
    if info.ok == 0 {
        return ""
    }
    if info.w < 1 || info.h < 1 {
        return ""
    }
    if info.w <= 256 && info.h <= 256 {
        return ""  // small enough — clients use the file itself
    }
    let im = img_load(content)
    if im.ok == 0 {
        return ""
    }
    let mut tw: i64 = 256
    let mut th: i64 = 256
    if info.w >= info.h {
        th = info.h * 256 / info.w
    } else {
        tw = info.w * 256 / info.h
    }
    if tw < 1 { tw = 1 }
    if th < 1 { th = 1 }
    let rim = img_resize_bilinear(im, tw, th)
    if rim.ok == 0 {
        return ""
    }
    let png = img_encode(rim, img_fmt_png())
    if bytes_len(png) == 0 {
        return ""
    }
    return data_blob_put(png)?
}

// ---------- mkdir -p ----------

// Create missing dir nodes along `path` (each level). Returns "" on success.
fn tree_mkdir_p(db: OrmDb, owner: i64, path: str) -> str !IO !Net {
    if path == "/" {
        return ""
    }
    let parts = str_split(path, "/")
    let mut cur = ""
    let mut parent = "/"
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let seg = vec_get(parts, i)
        if seg != "" {
            cur = concat(cur, "/")
            cur = concat(cur, seg)
            let q = tree_find(db, owner, cur)?
            if orm_ok_q(q) == 0 {
                return orm_err_q(q)
            }
            if orm_nrows(q) > 0 {
                if orm_cell_by_i64(q, 0, "is_dir") == 0 {
                    return concat("not a directory: ", cur)
                }
            } else {
                let ins = tree_insert(orm_db_q(q), owner, cur, parent, seg, 1, 0, "", "")?
                if orm_ok(ins) == 0 {
                    return orm_err_exec(ins)
                }
            }
            parent = cur
        }
        i = i + 1
    }
    return ""
}

// ---------- blob GC for replaced/deleted content ----------
// tree_ver_gc (versions.baga): a blob lives while any node OR version refs it.

// ---------- handlers ----------

fn act_fs_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let mut d = db
    let path = tree_qpath(ctx, "path")
    if path != "/" {
        let nq = tree_find(d, t.owner, path)?
        if orm_ok_q(nq) == 0 {
            return act_err(orm_db_q(nq), 500, orm_err_q(nq))
        }
        if orm_nrows(nq) < 1 {
            return act_404(orm_db_q(nq), "path not found")
        }
        if orm_cell_by_i64(nq, 0, "is_dir") == 0 {
            return act_err(orm_db_q(nq), 400, "not a directory")
        }
        d = orm_db_q(nq)
    }
    let q = tree_children(d, t.owner, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, tree_node_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "path", path)
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return act_ok(orm_db_q(q), o)
}

fn act_fs_stat(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "path not found")
    }
    return act_ok(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_mkdir(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    if path == "/" {
        return act_err(db, 400, "root exists")
    }
    let err = tree_mkdir_p(db, t.owner, path)?
    if err != "" {
        return act_err(db, 409, err)
    }
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "mkdir ok but node missing")
    }
    return act_created(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_put(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    if path == "/" {
        return act_err(db, 400, "cannot overwrite root")
    }
    let body = http_body_bytes(ctx.req)
    let size = bytes_len(body)
    if size < 1 {
        return act_err(db, 400, "empty body")
    }
    let maxf = tree_max_file_bytes()?
    if size > maxf {
        return act_err(db, 413, "file too large")
    }
    let mut d = db
    // quota: usage + new - replaced <= quota
    return tree_store_file(db, t.owner, path, body, 1)?
}

// Shared store flow (PUT file, doc save): quota → mkdir -p → blob →
// node upsert → GC of replaced blobs. thumbs=1 probes for image thumbs.
fn tree_store_file(db: OrmDb, owner: i64, path: str, body: bytes, thumbs: i64) -> FmrOut !IO !Net {
    let size = bytes_len(body)
    let mut d = db
    // quota: usage + new - replaced <= quota
    let existing = tree_find(d, owner, path)?
    if orm_ok_q(existing) == 0 {
        return act_err(orm_db_q(existing), 500, orm_err_q(existing))
    }
    let mut old_size: i64 = 0
    let mut old_hash = ""
    let mut old_thumb = ""
    let mut existing_id: i64 = 0
    if orm_nrows(existing) > 0 {
        if orm_cell_by_i64(existing, 0, "is_dir") == 1 {
            return act_err(orm_db_q(existing), 409, "is a directory")
        }
        old_size = orm_cell_by_i64(existing, 0, "size")
        old_hash = orm_cell_by(existing, 0, "hash")
        old_thumb = orm_cell_by(existing, 0, "thumb_hash")
        existing_id = orm_cell_by_i64(existing, 0, "id")
    }
    d = orm_db_q(existing)
    let usage = tree_usage(d, owner)?
    if orm_ok_c(usage) == 0 {
        return act_err(orm_db_c(usage), 500, orm_err_c(usage))
    }
    let quota = tree_quota_bytes()?
    if orm_count_n(usage) + size - old_size > quota {
        return act_err(orm_db_c(usage), 413, "quota exceeded")
    }
    d = orm_db_c(usage)
    // parents (mkdir -p), blob, thumbnail
    let perr = tree_mkdir_p(d, owner, tree_parent_of(path))?
    if perr != "" {
        return act_err(d, 409, perr)
    }
    let hash = data_blob_put(body)?
    if hash == "" {
        return act_err(d, 500, "blob write failed")
    }
    let mut thumb = ""
    if thumbs == 1 {
        thumb = tree_make_thumb(body)?
    }
    if existing_id > 0 {
        // Phase 5: snapshot the displaced content as a version first, so
        // the old blob stays referenced through the overwrite.
        if old_hash != "" && old_hash != hash {
            let snap = tree_ver_snapshot(d, existing_id, owner, path, old_size, old_hash)?
            if orm_ok(snap) == 0 {
                return act_err(orm_db_exec(snap), 500, orm_err_exec(snap))
            }
            d = orm_db_exec(snap)
        }
        let upd = tree_update_file(d, existing_id, size, hash, thumb)?
        if orm_ok(upd) == 0 {
            return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
        }
        d = orm_db_exec(upd)
        if old_hash != "" && old_hash != hash {
            let cap = tree_ver_cap(d, existing_id, tree_versions_keep()?)?
            if orm_ok_q(cap) == 0 {
                return act_err(orm_db_q(cap), 500, orm_err_q(cap))
            }
            d = orm_db_q(cap)
        }
        tree_ver_gc(d, old_hash)?
        tree_ver_gc(d, old_thumb)?
    } else {
        let ins = tree_insert(d, owner, path, tree_parent_of(path), tree_name_of(path), 0, size, hash, thumb)?
        if orm_ok(ins) == 0 {
            return act_err(orm_db_exec(ins), 500, orm_err_exec(ins))
        }
        d = orm_db_exec(ins)
    }
    let q = tree_find(d, owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "write ok but node missing")
    }
    let mut o = tree_node_json(q, 0)
    o = jobj_str(o, "etag", hash)
    return act_ok(orm_db_q(q), o)
}

fn act_fs_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let hash = orm_cell_by(q, 0, "hash")
    let name = orm_cell_by(q, 0, "name")
    let body = data_blob_get(hash)?
    if bytes_len(body) == 0 && orm_cell_by_i64(q, 0, "size") > 0 {
        return act_err(orm_db_q(q), 500, "blob missing")
    }
    let mime = tree_mime(path)
    let mut r = http_response_bytes(200, body)
    r = http_set_header(r, "Content-Type", mime)
    r = http_set_header(r, "ETag", hash)
    let mut disp = "attachment"
    if tree_mime_inline(mime) == 1 {
        disp = "inline"
    }
    r = http_set_header(r, "Content-Disposition", concat(concat(disp, "; filename=\""), concat(name, "\"")))
    return fmr_out(r, orm_db_q(q))
}

// Text preview for the file manager. Office files go through officebaga.
// Images stay on /v1/fs/file — this returns kind "image" without the bytes.
fn tree_preview_cap(text: str) -> str {
    if len(text) <= 20000 {
        return text
    }
    return concat(substr(text, 0, 20000), "\n…")
}

fn tree_office_text(body: bytes) -> str {
    let opened = office_open_bytes(body)
    if opened.ok == 0 {
        return ""
    }
    let md = office_to_markdown_rich(opened.doc)
    if md != "" {
        return md
    }
    return office_plain_text(opened.doc)
}

fn act_fs_preview(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let ext = tree_ext(path)
    let mut kind = "empty"
    let mut text = ""
    if ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif" || ext == "webp" || ext == "bmp" {
        kind = "image"
    } else {
        if ext == "pdf" {
            // pdfbaga is a writer; the browser renders the blob natively.
            kind = "pdf"
        } else {
            if ext == "zip" {
                // entries are listed via /v1/fs/zip/list
                kind = "zip"
            } else {
            let hash = orm_cell_by(q, 0, "hash")
            let body = data_blob_get(hash)?
            if bytes_len(body) == 0 && orm_cell_by_i64(q, 0, "size") > 0 {
                return act_err(orm_db_q(q), 500, "blob missing")
            }
            if ext == "md" {
                kind = "markdown"
                text = str_of_bytes(body)
            }
            if ext == "csv" {
                kind = "csv"
                text = str_of_bytes(body)
            }
            if ext == "xlsx" || ext == "xls" || ext == "ods" {
                // TSV rows → table in the UI
                let opened = office_open_bytes(body)
                if opened.ok == 1 {
                    text = office_plain_text(opened.doc)
                }
                if text != "" {
                    kind = "sheet"
                }
            }
            if ext == "docx" || ext == "doc" || ext == "odt" {
                text = tree_office_text(body)
                if text != "" {
                    kind = "markdown"
                }
            }
            if ext == "txt" || ext == "json" || ext == "html" {
                text = str_of_bytes(body)
                if text != "" {
                    kind = "text"
                }
            }
            if text != "" && (kind == "markdown" || kind == "csv" || kind == "sheet" || kind == "text") {
                text = tree_preview_cap(text)
            }
        }
        }
    }
    let mut o = jobj_new()
    o = jobj_str(o, "name", name)
    o = jobj_str(o, "kind", kind)
    o = jobj_str(o, "text", text)
    return act_ok(orm_db_q(q), o)
}

fn act_fs_thumb(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    let thumb = orm_cell_by(q, 0, "thumb_hash")
    if thumb == "" {
        return act_404(orm_db_q(q), "no thumbnail")
    }
    let body = data_blob_get(thumb)?
    if bytes_len(body) == 0 {
        return act_err(orm_db_q(q), 500, "thumb blob missing")
    }
    let mut r = http_response_bytes(200, body)
    r = http_set_header(r, "Content-Type", "image/png")
    r = http_set_header(r, "Cache-Control", "private, max-age=3600")
    return fmr_out(r, orm_db_q(q))
}

fn act_fs_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    if path == "/" {
        return act_err(db, 400, "cannot delete root")
    }
    // collect blob hashes before deleting rows (nodes + their versions)
    let sub = tree_subtree(db, t.owner, path)?
    if orm_ok_q(sub) == 0 {
        return act_err(orm_db_q(sub), 500, orm_err_q(sub))
    }
    if orm_nrows(sub) < 1 {
        return act_404(orm_db_q(sub), "path not found")
    }
    let hashes = vec_new()
    let mut d = orm_db_q(sub)
    let mut i: i64 = 0
    while i < orm_nrows(sub) {
        let h = orm_cell_by(sub, i, "hash")
        if h != "" {
            vec_push(hashes, h)
        }
        let th = orm_cell_by(sub, i, "thumb_hash")
        if th != "" {
            vec_push(hashes, th)
        }
        let nid = orm_cell_by_i64(sub, i, "id")
        let vh = tree_ver_hashes(d, nid)?
        if orm_ok_q(vh) == 0 {
            return act_err(orm_db_q(vh), 500, orm_err_q(vh))
        }
        let mut vi: i64 = 0
        while vi < orm_nrows(vh) {
            let vhash = orm_cell_by(vh, vi, "hash")
            if vhash != "" {
                vec_push(hashes, vhash)
            }
            vi = vi + 1
        }
        let vd = tree_ver_drop_node(orm_db_q(vh), nid)?
        if orm_ok(vd) == 0 {
            return act_err(orm_db_exec(vd), 500, orm_err_exec(vd))
        }
        d = orm_db_exec(vd)
        i = i + 1
    }
    let del = tree_delete_subtree(d, t.owner, path)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    d = orm_db_exec(del)
    i = 0
    while i < vec_len(hashes) {
        tree_ver_gc(d, vec_get(hashes, i))?
        i = i + 1
    }
    return act_no_content(d)
}

fn act_fs_move(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let from = tree_qpath(ctx, "from")
    let to = tree_qpath(ctx, "to")
    if from == "/" || to == "/" {
        return act_err(db, 400, "cannot move root")
    }
    if from == to {
        return act_err(db, 400, "same path")
    }
    // no moving a dir into itself
    if str_starts_with(to, concat(from, "/")) {
        return act_err(db, 409, "cannot move into own subtree")
    }
    let dst = tree_find(db, t.owner, to)?
    if orm_ok_q(dst) == 0 {
        return act_err(orm_db_q(dst), 500, orm_err_q(dst))
    }
    if orm_nrows(dst) > 0 {
        return act_err(orm_db_q(dst), 409, "destination exists")
    }
    let mut d = orm_db_q(dst)
    let sub = tree_subtree(d, t.owner, from)?
    if orm_ok_q(sub) == 0 {
        return act_err(orm_db_q(sub), 500, orm_err_q(sub))
    }
    if orm_nrows(sub) < 1 {
        return act_404(orm_db_q(sub), "path not found")
    }
    d = orm_db_q(sub)
    // target parent must exist (mkdir -p it, like put)
    let perr = tree_mkdir_p(d, t.owner, tree_parent_of(to))?
    if perr != "" {
        return act_err(d, 409, perr)
    }
    // rewrite paths row by row (small trees; bulk SQL rewrite lands with versions)
    let mut i: i64 = 0
    while i < orm_nrows(sub) {
        let old_path = orm_cell_by(sub, i, "path")
        let new_path = concat(to, tree_tail(old_path, len(from)))
        let id = orm_cell_by_i64(sub, i, "id")
        let upd = tree_update_path(d, id, new_path, tree_parent_of(new_path), tree_name_of(new_path))?
        if orm_ok(upd) == 0 {
            return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
        }
        d = orm_db_exec(upd)
        i = i + 1
    }
    let q = tree_find(d, t.owner, to)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "move ok but node missing")
    }
    return act_ok(orm_db_q(q), tree_node_json(q, 0))
}

fn act_fs_usage(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let usage = tree_usage(db, t.owner)?
    if orm_ok_c(usage) == 0 {
        return act_err(orm_db_c(usage), 500, orm_err_c(usage))
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "used_bytes", orm_count_n(usage))
    o = jobj_i64(o, "quota_bytes", tree_quota_bytes()?)
    return act_ok(orm_db_c(usage), o)
}

// ---------- office editor: load / save ----------

// Editable kinds. Legacy OLE (.doc/.xls) is read-only; empty = not editable.
fn tree_doc_kind(ext: str) -> str {
    if ext == "docx" || ext == "odt" || ext == "txt" || ext == "md" {
        return "doc"
    }
    if ext == "xlsx" || ext == "ods" || ext == "csv" {
        return "sheet"
    }
    if ext == "doc" || ext == "xls" {
        return "legacy"
    }
    return ""
}

fn tree_doc_title(name: str, ext: str) -> str {
    let cut = len(ext) + 1
    if len(name) <= cut {
        return name
    }
    return substr(name, 0, len(name) - cut)
}

// `/dir/name.conflict-<hash8>.ext` — concurrent edits land here (Cells-style
// conflict copies), never silently overwriting the other writer's content.
fn tree_conflict_path(path: str, hash: str) -> str {
    let dir = tree_parent_of(path)
    let name = tree_name_of(path)
    let ext = path_ext(path)
    let mut stem = name
    if len(ext) > 0 && len(name) > len(ext) {
        stem = substr(name, 0, len(name) - len(ext))
    }
    let mut p = concat(stem, ".conflict-")
    p = concat(p, substr(hash, 0, 8))
    p = concat(p, ext)
    if dir == "/" {
        return concat("/", p)
    }
    return concat(concat(dir, "/"), p)
}

fn act_doc_load(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 400, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let ext = tree_ext(path)
    let kind = tree_doc_kind(ext)
    if kind == "" {
        return act_err(orm_db_q(q), 400, "not an editable document")
    }
    let hash = orm_cell_by(q, 0, "hash")
    let body = data_blob_get(hash)?
    if bytes_len(body) == 0 && orm_cell_by_i64(q, 0, "size") > 0 {
        return act_err(orm_db_q(q), 500, "blob missing")
    }
    let mut text = ""
    if ext == "txt" || ext == "md" || ext == "csv" {
        text = str_of_bytes(body)
    }
    if ext == "docx" || ext == "odt" || ext == "doc" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            if ext == "docx" {
                text = office_to_markdown_rich(opened.doc)
            } else {
                text = office_to_markdown(opened.doc)
            }
        }
    }
    if ext == "xlsx" || ext == "ods" || ext == "xls" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            text = office_plain_text(opened.doc)
        }
    }
    let mut o = jobj_new()
    o = jobj_str(o, "name", name)
    o = jobj_str(o, "path", path)
    o = jobj_str(o, "kind", kind)
    o = jobj_str(o, "format", ext)
    o = jobj_str(o, "etag", hash)
    o = jobj_str(o, "text", text)
    return act_ok(orm_db_q(q), o)
}

fn act_doc_save(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return t.out
    }
    let path = tree_qpath(ctx, "path")
    if path == "/" {
        return act_err(db, 400, "cannot overwrite root")
    }
    let ext = tree_ext(path)
    let kind = tree_doc_kind(ext)
    if kind == "" {
        return act_err(db, 400, "not an editable document")
    }
    if kind == "legacy" {
        return act_err(db, 400, "legacy format: convert to .docx/.xlsx first")
    }
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(db, "path not found")
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return act_err(orm_db_q(q), 409, "is a directory")
    }
    let name = orm_cell_by(q, 0, "name")
    let text = str_of_bytes(http_body_bytes(ctx.req))
    let title = tree_doc_title(name, ext)
    let mut out = bytes_of_str("")
    if ext == "docx" {
        out = office_md_to_docx_bytes(text)
    }
    if ext == "odt" {
        out = office_odt_bytes(title, office_md_to_plain(text))
    }
    if ext == "xlsx" {
        out = office_xlsx_bytes(text)
    }
    if ext == "ods" {
        out = office_ods_bytes(text)
    }
    if ext == "txt" || ext == "md" || ext == "csv" {
        out = bytes_of_str(text)
    }
    if bytes_len(out) < 1 {
        return act_err(orm_db_q(q), 500, "document conversion failed")
    }
    // ETag check: the editor sends the hash it loaded; a mismatch means
    // someone else saved meanwhile → conflict copy, not an overwrite.
    let want = query_decode_val(fmr_query(ctx, "etag"))
    if want != "" && want != orm_cell_by(q, 0, "hash") {
        let cpath = tree_conflict_path(path, sha256_b_hex(out))
        let stored = tree_store_file(orm_db_q(q), t.owner, cpath, out, 0)?
        if stored.resp.status >= 200 && stored.resp.status < 300 {
            return act_err(stored.db, 409, concat("файлът е променен междувременно; записано като ", cpath))
        }
        return stored
    }
    return tree_store_file(orm_db_q(q), t.owner, path, out, 0)?
}

// ---------- versions (Phase 5) ----------

// Shared lookup: node by path + version id param. ok=0 → out is the
// error response; on ok, node_id/ver_id are set (ver row still to fetch).
struct TreeVerReq {
    ok: i64,
    owner: i64,
    node_id: i64,
    ver_id: i64,
    db: OrmDb,
    out: FmrOut
}

fn tree_ver_req(ctx: FmrCtx, db: OrmDb, need_ver: i64) -> TreeVerReq !IO !Net {
    let bad = TreeVerReq { ok: 0, owner: 0, node_id: 0, ver_id: 0, db: db, out: fmr_out(http_response(500, ""), db) }
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return TreeVerReq { ok: 0, owner: 0, node_id: 0, ver_id: 0, db: db, out: t.out }
    }
    let path = tree_qpath(ctx, "path")
    let mut ver_id: i64 = 0
    if need_ver == 1 {
        ver_id = parse_int(query_decode_val(fmr_query(ctx, "version")))
        if ver_id < 1 {
            return TreeVerReq { ok: 0, owner: t.owner, node_id: 0, ver_id: 0, db: db, out: act_err(db, 400, "bad version id") }
        }
    }
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 {
        return TreeVerReq { ok: 0, owner: t.owner, node_id: 0, ver_id: 0, db: orm_db_q(q), out: act_err(orm_db_q(q), 500, orm_err_q(q)) }
    }
    if orm_nrows(q) < 1 {
        return TreeVerReq { ok: 0, owner: t.owner, node_id: 0, ver_id: 0, db: orm_db_q(q), out: act_404(orm_db_q(q), "path not found") }
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return TreeVerReq { ok: 0, owner: t.owner, node_id: 0, ver_id: 0, db: orm_db_q(q), out: act_err(orm_db_q(q), 400, "is a directory") }
    }
    let nid = orm_cell_by_i64(q, 0, "id")
    let mut r = bad
    r.ok = 1
    r.owner = t.owner
    r.node_id = nid
    r.ver_id = ver_id
    r.db = orm_db_q(q)
    return r
}

fn act_fs_versions(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let r = tree_ver_req(ctx, db, 0)?
    if r.ok == 0 {
        return r.out
    }
    let q = tree_ver_list(r.db, r.node_id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, tree_ver_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "path", tree_qpath(ctx, "path"))
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return act_ok(orm_db_q(q), o)
}

fn act_fs_version_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let r = tree_ver_req(ctx, db, 1)?
    if r.ok == 0 {
        return r.out
    }
    let v = tree_ver_find(r.db, r.node_id, r.ver_id)?
    if orm_ok_q(v) == 0 {
        return act_err(orm_db_q(v), 500, orm_err_q(v))
    }
    if orm_nrows(v) < 1 {
        return act_404(orm_db_q(v), "version not found")
    }
    let hash = orm_cell_by(v, 0, "hash")
    let body = data_blob_get(hash)?
    if bytes_len(body) == 0 && orm_cell_by_i64(v, 0, "size") > 0 {
        return act_err(orm_db_q(v), 500, "blob missing")
    }
    let path = tree_qpath(ctx, "path")
    let mut resp = http_response_bytes(200, body)
    resp = http_set_header(resp, "Content-Type", tree_mime(path))
    resp = http_set_header(resp, "ETag", hash)
    resp = http_set_header(resp, "Content-Disposition", concat("attachment; filename=\"", concat(tree_name_of(path), "\"")))
    return fmr_out(resp, orm_db_q(v))
}

// Restore: snapshot the current content, then point the node at the
// version's blob. The version row stays (history is append-only).
fn act_fs_version_restore(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let r = tree_ver_req(ctx, db, 1)?
    if r.ok == 0 {
        return r.out
    }
    let path = tree_qpath(ctx, "path")
    let mut d = r.db
    let cur = tree_find(d, r.owner, path)?
    if orm_ok_q(cur) == 0 || orm_nrows(cur) < 1 {
        return act_404(d, "path not found")
    }
    let cur_hash = orm_cell_by(cur, 0, "hash")
    let cur_size = orm_cell_by_i64(cur, 0, "size")
    let cur_thumb = orm_cell_by(cur, 0, "thumb_hash")
    d = orm_db_q(cur)
    let v = tree_ver_find(d, r.node_id, r.ver_id)?
    if orm_ok_q(v) == 0 {
        return act_err(orm_db_q(v), 500, orm_err_q(v))
    }
    if orm_nrows(v) < 1 {
        return act_404(orm_db_q(v), "version not found")
    }
    let v_hash = orm_cell_by(v, 0, "hash")
    let v_size = orm_cell_by_i64(v, 0, "size")
    d = orm_db_q(v)
    if v_hash == cur_hash {
        let q = tree_find(d, r.owner, path)?
        return act_ok(orm_db_q(q), tree_node_json(q, 0))
    }
    let body = data_blob_get(v_hash)?
    if bytes_len(body) == 0 && v_size > 0 {
        return act_err(d, 500, "blob missing")
    }
    // displace current content → snapshot it first (keeps the blob alive)
    if cur_hash != "" {
        let snap = tree_ver_snapshot(d, r.node_id, r.owner, path, cur_size, cur_hash)?
        if orm_ok(snap) == 0 {
            return act_err(orm_db_exec(snap), 500, orm_err_exec(snap))
        }
        d = orm_db_exec(snap)
    }
    let thumb = tree_make_thumb(body)?
    let upd = tree_update_file(d, r.node_id, v_size, v_hash, thumb)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    d = orm_db_exec(upd)
    let cap = tree_ver_cap(d, r.node_id, tree_versions_keep()?)?
    if orm_ok_q(cap) == 0 {
        return act_err(orm_db_q(cap), 500, orm_err_q(cap))
    }
    d = orm_db_q(cap)
    tree_ver_gc(d, cur_thumb)?
    let q = tree_find(d, r.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(d, 500, "restore ok but node missing")
    }
    let mut o = tree_node_json(q, 0)
    o = jobj_str(o, "etag", v_hash)
    return act_ok(orm_db_q(q), o)
}

// ---------- zip browsing (Phase 5) ----------

// Shared: auth + node lookup + zip_open_bytes over the blob.
struct TreeZipReq {
    ok: i64,
    db: OrmDb,
    zip: ZipArchive,
    out: FmrOut
}

fn tree_zip_req(ctx: FmrCtx, db: OrmDb) -> TreeZipReq !IO !Net {
    let t = tree_auth(ctx, db)?
    if t.ok == 0 {
        return TreeZipReq { ok: 0, db: db, zip: zip_empty_err(""), out: t.out }
    }
    let path = tree_qpath(ctx, "path")
    let q = tree_find(db, t.owner, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return TreeZipReq { ok: 0, db: orm_db_q(q), zip: zip_empty_err(""), out: act_404(orm_db_q(q), "path not found") }
    }
    if orm_cell_by_i64(q, 0, "is_dir") == 1 {
        return TreeZipReq { ok: 0, db: orm_db_q(q), zip: zip_empty_err(""), out: act_err(orm_db_q(q), 400, "is a directory") }
    }
    let body = data_blob_get(orm_cell_by(q, 0, "hash"))?
    let z = zip_open_bytes(body)
    if z.ok == 0 {
        return TreeZipReq { ok: 0, db: orm_db_q(q), zip: z, out: act_err(orm_db_q(q), 400, z.err) }
    }
    return TreeZipReq { ok: 1, db: orm_db_q(q), zip: z, out: fmr_out(http_response(200, ""), orm_db_q(q)) }
}

fn act_fs_zip_list(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let r = tree_zip_req(ctx, db)?
    if r.ok == 0 {
        return r.out
    }
    let mut arr = jarr_new()
    let n = zip_count(r.zip)
    let mut i: i64 = 0
    while i < n {
        let nm = zip_name(r.zip, i)
        let mut o = jobj_new()
        o = jobj_str(o, "name", nm)
        o = jobj_i64(o, "size", vec_get(r.zip.uncomp_sizes, i))
        let mut is_dir: i64 = 0
        if str_ends_with(nm, "/") {
            is_dir = 1
        }
        o = jobj_i64(o, "is_dir", is_dir)
        arr = jarr_obj(arr, o)
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "path", tree_qpath(ctx, "path"))
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", n)
    return act_ok(r.db, o)
}

fn act_fs_zip_get(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let r = tree_zip_req(ctx, db)?
    if r.ok == 0 {
        return r.out
    }
    let entry = query_decode_val(fmr_query(ctx, "entry"))
    if entry == "" {
        return act_err(r.db, 400, "missing entry")
    }
    let part = zip_read(r.zip, entry)
    if part.ok == 0 {
        return act_404(r.db, part.err)
    }
    let mut resp = http_response_bytes(200, part.data)
    resp = http_set_header(resp, "Content-Type", tree_mime(entry))
    resp = http_set_header(resp, "Content-Disposition", concat("attachment; filename=\"", concat(tree_name_of(concat("/", entry)), "\"")))
    return fmr_out(resp, r.db)
}
