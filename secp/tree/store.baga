// tree/store.baga — shared plumbing за файловите действия: конфигурация от
// средата, mkdir -p по виртуалните пътища и общият store flow (квота → blob →
// node upsert → GC на изместените blob-ове).
//
// Изнесено от actions.baga, за да останат файловете под 600 реда (filesize gate)
// и за да го ползват всички handler-и (doc save, в бъдеще upload от WebDAV).

import "model.baga"
import "versions.baga"
import "activity_model.baga"
import "text.baga"
import "../data/blobs.baga"
import "../data/crypt.baga"
import "ormbaga/orm.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "imgbaga/img.baga"
import "imgbaga/ops.baga"
import "std/str/str.baga"
import "std/os/os.baga"

// ---------- config ----------

fn tree_max_file_bytes() -> i64 !IO {
    let raw = env("SECP_MAX_FILE_MB")?
    if raw == "" {
        return 104857600  // 100 MiB
    }
    let n = parse_int(raw)
    if n < 1 {
        return 104857600
    }
    return n * 1048576
}

fn tree_quota_bytes() -> i64 !IO {
    let raw = env("SECP_QUOTA_MB")?
    if raw == "" {
        return 1073741824  // 1 GiB
    }
    let n = parse_int(raw)
    if n < 1 {
        return 1073741824
    }
    return n * 1048576
}

// Snapshots kept per node (oldest beyond that are dropped + GC'd).
fn tree_versions_keep() -> i64 !IO {
    let raw = env("SECP_VERSIONS_MAX")?
    if raw == "" {
        return 50
    }
    let n = parse_int(raw)
    if n < 1 {
        return 50
    }
    return n
}

// ---------- thumbnails ----------

struct ThumbOut {
    db: OrmDb,
    hash: str
}

// 256px-max PNG thumbnail into the blob store; hash "" when not an image.
fn tree_make_thumb(db: OrmDb, ws: i64, content: bytes) -> ThumbOut !IO !Net !Random !Time {
    if bytes_len(content) > 20971520 {
        return ThumbOut { db: db, hash: "" }
    }
    let info = img_info(content)
    if info.ok == 0 {
        return ThumbOut { db: db, hash: "" }
    }
    if info.w < 1 || info.h < 1 {
        return ThumbOut { db: db, hash: "" }
    }
    if info.w <= 256 && info.h <= 256 {
        return ThumbOut { db: db, hash: "" }
    }
    let im = img_load(content)
    if im.ok == 0 {
        return ThumbOut { db: db, hash: "" }
    }
    let mut tw: i64 = 256
    let mut th: i64 = 256
    if info.w >= info.h {
        th = info.h * 256 / info.w
    } else {
        tw = info.w * 256 / info.h
    }
    if tw < 1 { tw = 1 }
    if th < 1 { th = 1 }
    let rim = img_resize_bilinear(im, tw, th)
    if rim.ok == 0 {
        return ThumbOut { db: db, hash: "" }
    }
    let png = img_encode(rim, img_fmt_png())
    if bytes_len(png) == 0 {
        return ThumbOut { db: db, hash: "" }
    }
    let saved = data_save(db, ws, png)?
    return ThumbOut { db: saved.db, hash: saved.hash }
}

// ---------- mkdir -p ----------

// Create missing dir nodes along `path` (each level). Returns "" on success.
// `owner` е само за одита (кой я е създал) — скоупът е workspace-ът.
fn tree_mkdir_p(db: OrmDb, ws: i64, owner: i64, path: str) -> str !IO !Net {
    if path == "/" {
        return ""
    }
    let parts = str_split(path, "/")
    let mut cur = ""
    let mut parent = "/"
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let seg = vec_get(parts, i)
        if seg != "" {
            cur = concat(cur, "/")
            cur = concat(cur, seg)
            let q = tree_find(db, ws, cur)?
            if orm_ok_q(q) == 0 {
                return orm_err_q(q)
            }
            if orm_nrows(q) > 0 {
                if orm_cell_by_i64(q, 0, "is_dir") == 0 {
                    return concat("not a directory: ", cur)
                }
            } else {
                let ins = tree_insert(orm_db_q(q), ws, owner, cur, parent, seg, 1, 0, "", "")?
                if orm_ok(ins) == 0 {
                    return orm_err_exec(ins)
                }
            }
            parent = cur
        }
        i = i + 1
    }
    return ""
}

// ---------- node upsert (QUOTA → blob → row) ----------

// Shared store flow (PUT file, doc save): quota → mkdir -p → blob →
// node upsert → GC of replaced blobs. thumbs=1 probes for image thumbs.
fn tree_store_file(db: OrmDb, ws: i64, owner: i64, path: str, body: bytes, thumbs: i64) -> FmrOut !IO !Net !Time !Random {
    let size = bytes_len(body)
    let mut d = db
    // quota: usage + new - replaced <= quota
    let existing = tree_find(d, ws, path)?
    if orm_ok_q(existing) == 0 {
        return act_err(orm_db_q(existing), 500, orm_err_q(existing))
    }
    let mut old_size: i64 = 0
    let mut old_hash = ""
    let mut old_thumb = ""
    let mut existing_id: i64 = 0
    if orm_nrows(existing) > 0 {
        if orm_cell_by_i64(existing, 0, "is_dir") == 1 {
            return act_err(orm_db_q(existing), 409, "is a directory")
        }
        old_size = orm_cell_by_i64(existing, 0, "size")
        old_hash = orm_cell_by(existing, 0, "hash")
        old_thumb = orm_cell_by(existing, 0, "thumb_hash")
        existing_id = orm_cell_by_i64(existing, 0, "id")
    }
    d = orm_db_q(existing)
    let usage = tree_usage(d, ws)?
    if orm_ok_c(usage) == 0 {
        return act_err(orm_db_c(usage), 500, orm_err_c(usage))
    }
    let quota = tree_quota_bytes()?
    if orm_count_n(usage) + size - old_size > quota {
        return act_err(orm_db_c(usage), 413, "quota exceeded")
    }
    d = orm_db_c(usage)
    // parents (mkdir -p), blob, thumbnail
    let perr = tree_mkdir_p(d, ws, owner, tree_parent_of(path))?
    if perr != "" {
        return act_err(d, 409, perr)
    }
    let saved = data_save(d, ws, body)?
    if saved.hash == "" {
        return act_err(saved.db, 500, saved.err)
    }
    d = saved.db
    let hash = saved.hash
    let mut thumb = ""
    if thumbs == 1 {
        let th = tree_make_thumb(d, ws, body)?
        d = th.db
        thumb = th.hash
    }
    if existing_id > 0 {
        // Phase 5: snapshot the displaced content as a version first, so
        // the old blob stays referenced through the overwrite.
        if old_hash != "" && old_hash != hash {
            let snap = tree_ver_snapshot(d, existing_id, ws, owner, path, old_size, old_hash)?
            if orm_ok(snap) == 0 {
                return act_err(orm_db_exec(snap), 500, orm_err_exec(snap))
            }
            d = orm_db_exec(snap)
        }
        let upd = tree_update_file(d, existing_id, size, hash, thumb)?
        if orm_ok(upd) == 0 {
            return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
        }
        d = orm_db_exec(upd)
        if old_hash != "" && old_hash != hash {
            let cap = tree_ver_cap(d, existing_id, tree_versions_keep()?)?
            if orm_ok_q(cap) == 0 {
                return act_err(orm_db_q(cap), 500, orm_err_q(cap))
            }
            d = orm_db_q(cap)
        }
        tree_ver_gc(d, ws, old_hash)?
        tree_ver_gc(d, ws, old_thumb)?
    } else {
        let ins = tree_insert(d, ws, owner, path, tree_parent_of(path), tree_name_of(path), 0, size, hash, thumb)?
        if orm_ok(ins) == 0 {
            return act_err(orm_db_exec(ins), 500, orm_err_exec(ins))
        }
        d = orm_db_exec(ins)
    }
    let q = tree_find(d, ws, path)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(db, 500, "write ok but node missing")
    }
    let nid = orm_cell_by_i64(q, 0, "id")
    // Текстов индекс за търсене (Фаза 6): извличаме при запис. Задачата
    // extract-text (виж scheduler) прави същото за вече качените файлове.
    // Провалът тук не бива да съсипва записа — файлът вече е запазен.
    let ext = tree_ext(path)
    let xt = tree_extract_text(ext, body)?
    tree_text_put(orm_db_q(q), nid, ws, xt)?
    // Одит (Фаза 3): създаден или презаписан файл. `created`/`updated` се
    // различава по това дали редът е съществувал — това е точният факт,
    // който feed-ът трябва да покаже (не „upload").
    let mut verb = activity_verb_created()
    if existing_id > 0 {
        verb = activity_verb_updated()
    }
    let logged = tree_activity_log(orm_db_q(q), ws, owner, verb, nid, path, "")?
    d = logged.db
    let mut o = tree_node_json(q, 0)
    o = jobj_str(o, "etag", hash)
    return act_ok(d, o)
}