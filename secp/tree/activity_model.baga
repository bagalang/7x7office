// tree/activity_model.baga — достъп до таблицата activity (Фаза 3).
//
// Логиката (познат ли е verb-ът, тавани, странициране) е в activity_kinds.baga
// — ЧИСТ модул с тестове. Тук е само базата: запис, списък, чистене.
//
// Защо `ts` е epoch СЕКУНДИ (BIGINT), а не TIMESTAMPTZ: сравнението и
// подредбата трябва да са еднакви на Postgres и BoilaDB, а последният няма
// NOW() в заявка (същият аргумент като share_links, виж gaps G23). Часовникът
// идва от handler-а.
//
// Feed-ът е APPEND-ONLY: изтрит възел не трие историята си (иначе „кой
// изтри файла" изчезва точно когато е най-нужно). Чисти се само с
// пространството или изрично от админ.
//
// Името на актьора се джойнва в самата заявка (LEFT JOIN idm_users) — иначе
// списък от 50 реда прави 50 допълнителни заявки за имейл.

import "activity_kinds.baga"
import "model.baga"
import "../idm/user_model.baga"
import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "chronobaga/src/chrono.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/time/time.baga"

fn tree_activity_table() -> str {
    return "activity"
}

fn tree_activity_cols() -> str {
    return "id, workspace_id, actor_id, verb, node_id, path, meta, ts"
}

// Текущото време в epoch секунди (std/time дава милисекунди). Дублира
// share_now_s нарочно: двата модула не бива да зависят един от друг само
// заради един ред.
fn tree_activity_now_s() -> i64 !Time {
    return time_now_ms() / 1000
}

// ---------- писане ----------

fn tree_activity_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(id) AS count FROM activity")?
}

// Одитът е СПОМАГАТЕЛЕН, не основен: ако записът се провали, действието вече
// е свършено (файлът е качен, линкът е издаден) и не бива да се връща назад
// заради лог. Затова грешката се отпечатва и се връща ok=0 — викащият
// продължава с върнатата връзка. Така един счупен индекс не спира качването.
struct ActivityLogged {
    db: OrmDb,
    ok: i64
}

fn tree_activity_log(db: OrmDb, ws: i64, actor: i64, verb: str, node_id: i64,
        path: str, meta: str) -> ActivityLogged !IO !Net !Time {
    // Непознат verb не влиза в базата: иначе UI-ът го показва като суров
    // ключ, а по-лошо — бъдещ филтър би го счел за невалиден ред.
    if activity_verb_valid(verb) == 0 {
        eprintln(concat("activity: непознат verb: ", verb))
        return ActivityLogged { db: db, ok: 0 }
    }
    if ws < 1 {
        eprintln("activity: липсва workspace_id")
        return ActivityLogged { db: db, ok: 0 }
    }
    let ts = tree_activity_now_s()
    let ins = tree_activity_insert(db, ws, actor, verb, node_id, path, meta, ts)?
    if orm_ok(ins) == 0 {
        eprintln(concat(concat("activity: записът се провали (", verb), concat("): ", orm_err_exec(ins))))
        return ActivityLogged { db: orm_db_exec(ins), ok: 0 }
    }
    return ActivityLogged { db: orm_db_exec(ins), ok: 1 }
}

// Едно действие. `node_id` е 0, когато действието не е върху възел (напр.
// членство или самото пространство). `meta` се реже до тавана в чисткия
// модул — тук само се записва.
//
// ВАЖНО: провал на записа НЕ бива да съсипва основното действие (файлът е
// качен, линкът е издаден). Викащият решава; в handler-ите ползваме
// activity_best_effort.
fn tree_activity_insert(db: OrmDb, ws: i64, actor: i64, verb: str, node_id: i64,
        path: str, meta: str, ts: i64) -> OrmExec !IO !Net {
    let m = activity_meta_cap(meta)
    let cols = vec_new()
    vec_push(cols, "workspace_id")
    vec_push(cols, "actor_id")
    vec_push(cols, "verb")
    vec_push(cols, "node_id")
    vec_push(cols, "path")
    vec_push(cols, "meta")
    vec_push(cols, "ts")
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    vec_push(vals, int_to_str(actor))
    vec_push(vals, verb)
    vec_push(vals, int_to_str(node_id))
    vec_push(vals, path)
    vec_push(vals, m)
    vec_push(vals, int_to_str(ts))
    if tree_backend_boila()? == 1 {
        // boila няма SERIAL: id-то се дава с MAX(id)+1.
        let c = tree_activity_next_id(db)?
        if orm_ok_c(c) == 0 {
            return OrmEErr(OrmExecFail { err: orm_err_c(c), tag: "", db: orm_db_c(c) })
        }
        let cols2 = vec_new()
        vec_push(cols2, "id")
        let mut vals2 = vec_new()
        vec_push(vals2, int_to_str(orm_count_n(c) + 1))
        let mut i: i64 = 0
        while i < vec_len(cols) {
            vec_push(cols2, vec_get(cols, i))
            vec_push(vals2, vec_get(vals, i))
            i = i + 1
        }
        return orm_insert_strs(orm_db_c(c), tree_activity_table(), cols2, vals2)?
    }
    return orm_insert_strs(db, tree_activity_table(), cols, vals)?
}

// ---------- четене ----------

// Редове + актьори, слято в кода. boilaSQL не решава квалифицирани колони в
// WHERE, а `id` е двусмислена при JOIN с idm_users (Postgres я отказва),
// затова activity се чете без JOIN, а актьорите — с IN заявка после.
// Ролята на актьора не се тегли — feed-ът не е за права, а за действия;
// имейл/име стигат.
struct ActRows {
    db: OrmDb,
    err: str,
    n: i64,
    ids: Vec<i64>,
    ws_ids: Vec<i64>,
    actors: Vec<i64>,
    verbs: Vec<str>,
    node_ids: Vec<i64>,
    paths: Vec<str>,
    metas: Vec<str>,
    tss: Vec<i64>,
    emails: Vec<str>,
    names: Vec<str>
}

fn act_rows_fail(db: OrmDb, err: str) -> ActRows {
    return ActRows { db: db, err: err, n: 0, ids: vec_new(), ws_ids: vec_new(), actors: vec_new(), verbs: vec_new(), node_ids: vec_new(), paths: vec_new(), metas: vec_new(), tss: vec_new(), emails: vec_new(), names: vec_new() }
}

fn act_id_in_list(ids: Vec<i64>, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(ids) {
        if vec_get(ids, i) == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// email/name за всеки ред по actor_id. Една IN заявка за всички актьори;
// липсващ потребител (изтрит) дава празни полета — както LEFT JOIN NULL-а.
fn tree_activity_attach_actors(db: OrmDb, q: OrmQuery) -> ActRows !IO !Net {
    let mut rows = ActRows { db: db, err: "", n: orm_nrows(q), ids: vec_new(), ws_ids: vec_new(), actors: vec_new(), verbs: vec_new(), node_ids: vec_new(), paths: vec_new(), metas: vec_new(), tss: vec_new(), emails: vec_new(), names: vec_new() }
    let uniq: Vec<i64> = vec_new()
    let mut in_list = ""
    let mut i: i64 = 0
    while i < rows.n {
        let aid = orm_cell_by_i64(q, i, "actor_id")
        vec_push(rows.ids, orm_cell_by_i64(q, i, "id"))
        vec_push(rows.ws_ids, orm_cell_by_i64(q, i, "workspace_id"))
        vec_push(rows.actors, aid)
        vec_push(rows.verbs, orm_cell_by(q, i, "verb"))
        vec_push(rows.node_ids, orm_cell_by_i64(q, i, "node_id"))
        vec_push(rows.paths, orm_cell_by(q, i, "path"))
        vec_push(rows.metas, orm_cell_by(q, i, "meta"))
        vec_push(rows.tss, orm_cell_by_i64(q, i, "ts"))
        vec_push(rows.emails, "")
        vec_push(rows.names, "")
        if aid > 0 && act_id_in_list(uniq, aid) == 0 {
            vec_push(uniq, aid)
            if in_list != "" {
                in_list = concat(in_list, ",")
            }
            in_list = concat(in_list, int_to_str(aid))
        }
        i = i + 1
    }
    let mut d = orm_db_q(q)
    if in_list == "" {
        rows.db = d
        return rows
    }
    let uq = orm_query_params_str(d, concat("SELECT id, email, name FROM idm_users WHERE id IN (", concat(in_list, ")")), vec_new())?
    if orm_ok_q(uq) == 0 {
        return act_rows_fail(orm_db_q(uq), orm_err_q(uq))
    }
    d = orm_db_q(uq)
    let mut r: i64 = 0
    while r < rows.n {
        let aid = vec_get(rows.actors, r)
        let mut j: i64 = 0
        while j < orm_nrows(uq) {
            if orm_cell_by_i64(uq, j, "id") == aid {
                vec_set(rows.emails, r, orm_cell_by(uq, j, "email"))
                vec_set(rows.names, r, orm_cell_by(uq, j, "name"))
            }
            j = j + 1
        }
        r = r + 1
    }
    rows.db = d
    return rows
}

fn tree_activity_read(db: OrmDb, sql: str, vals: Vec<str>) -> ActRows !IO !Net {
    let q = orm_query_params_str(db, sql, vals)?
    if orm_ok_q(q) == 0 {
        return act_rows_fail(orm_db_q(q), orm_err_q(q))
    }
    return tree_activity_attach_actors(orm_db_q(q), q)?
}

fn tree_activity_select_from() -> str {
    return concat(concat("SELECT ", tree_activity_cols()), " FROM activity ")
}

// Последните `limit` действия в пространството, най-новите първи. Идемпотентно
// при еднакъв ts: подреждаме и по id (низходящо), за да е детерминирано.
fn tree_activity_list(db: OrmDb, ws: i64, limit: i64) -> ActRows !IO !Net {
    let n = int_to_str(activity_limit_clamp(limit))
    let sql = concat(concat(tree_activity_select_from(), "WHERE workspace_id = $1 ORDER BY ts DESC, id DESC LIMIT "), n)
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    return tree_activity_read(db, sql, vals)?
}

// Действията върху възел и поддървото му (за панела „История" на файл).
// Сравнението по сегменти: LIKE '/a/%' не хваща съсед /ab.
fn tree_activity_list_path(db: OrmDb, ws: i64, path: str, limit: i64) -> ActRows !IO !Net {
    let n = int_to_str(activity_limit_clamp(limit))
    let sql = concat(concat(tree_activity_select_from(), "WHERE workspace_id = $1 AND (path = $2 OR path LIKE $3) ORDER BY ts DESC, id DESC LIMIT "), n)
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    vec_push(vals, path)
    vec_push(vals, concat(path, "/%"))
    return tree_activity_read(db, sql, vals)?
}

// Действията на един потребител („какво е правил Иван"). Филтърът по
// път и по актьор са взаимно изключващи се в API-то — комбинирани правят
// рядко полезен ъгъл, а трета заявка не си струва поддръжката (v1).
fn tree_activity_list_actor(db: OrmDb, ws: i64, actor: i64, limit: i64) -> ActRows !IO !Net {
    let n = int_to_str(activity_limit_clamp(limit))
    // actor_id е число от заявката — интерполира се безопасно (виж acl_qid).
    let sql = concat(concat(tree_activity_select_from(), "WHERE workspace_id = $1 AND actor_id = "), concat(int_to_str(actor), concat(" ORDER BY ts DESC, id DESC LIMIT ", n)))
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    return tree_activity_read(db, sql, vals)?
}

// ---------- опашка (WS gateway, Фаза 3) ----------

// Най-големият id в пространството. Това е „курсорът" за нов клиент: като го
// върнем, клиентът знае, че оттам нататък чака нови събития, и не получава
// цялата история при свързване (иначе отварянето на таб = 200 реда и 200
// презареждания в UI-а).
//
// БЕЗ COALESCE: boilaDB няма COALESCE около агрегат (виж бележката в
// PLAN.md за `tree_usage`) — `pg_cell_i64` вече мапва NULL → 0, т.е. празната
// таблица дава 0, което е точно „нищо още".
fn tree_activity_max_id(db: OrmDb, ws: i64) -> OrmCount !IO !Net {
    let sql = concat("SELECT MAX(id) AS count FROM activity WHERE workspace_id = ", int_to_str(ws))
    return orm_count_sql(db, sql)?
}

// Редовете с id > `after`, най-старите първи (събитията вървят в реда, в
// който са се случили), най-много `limit`. После клиентът мести курсора на
// последния id — така едно пропуснато събитие не се губи, а се наваксва.
//
// Защо възходящо, а не низходящо като списъка: списъкът показва „последното",
// а опашката „какво ново". Обръщането на реда в една посока само ще накара
// клиента да го обърне обратно.
fn tree_activity_tail(db: OrmDb, ws: i64, after: i64, limit: i64) -> ActRows !IO !Net {
    // Таванът е activity_limit_max (200), същият като ws_tail_limit().
    // tree не тегли system/ws_events — иначе модулът зависи от gateway-а.
    let n = activity_limit_clamp(limit)
    let sql = concat(concat(tree_activity_select_from(), "WHERE workspace_id = $1 AND id > $2 ORDER BY id ASC LIMIT "), int_to_str(n))
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    vec_push(vals, int_to_str(after))
    return tree_activity_read(db, sql, vals)?
}

// id-то на последния ред в резултата (0 при празно). Клиентът мести курсора
// с него — не с брой редове, за да е идемпотентно при едновременни записи.
fn tree_activity_last_id(rows: ActRows) -> i64 {
    if rows.n < 1 {
        return 0
    }
    return vec_get(rows.ids, rows.n - 1)
}

// ---------- чистене ----------

// При изтриване на пространство (idm/ws_actions → tree_ws_purge). Редовете
// нямат FK на boila, затова се трият ръчно.
fn tree_activity_purge_ws(db: OrmDb, ws: i64) -> i64 !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(ws))
    let e = orm_exec_params_str(db, "DELETE FROM activity WHERE workspace_id = $1", vals)?
    if orm_ok(e) == 0 {
        return -1
    }
    return 0
}

// ---------- JSON ----------

fn tree_activity_ts_iso(ts: i64) -> str {
    if ts < 1 {
        return ""
    }
    let t = ts_from_unix(ts)
    if t.ok == 0 {
        return ""
    }
    return ts_to_iso(t.value)
}

// `meta` е свободен текст (обикновено JSON). Пращаме го суров само ако
// изглежда като JSON обект/масив — иначе клиентът би получил низ, който
// `JSON.parse` отхвърля. Празното се пропуска, за да не е `"meta": ""`.
fn tree_activity_meta_json(o: JObj, meta: str) -> JObj {
    if meta == "" {
        return o
    }
    if str_starts_with(meta, "{") == 1 || str_starts_with(meta, "[") == 1 {
        return jobj_raw(o, "meta", meta)
    }
    return jobj_str(o, "meta", meta)
}

fn tree_activity_to_json(rows: ActRows, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", vec_get(rows.ids, row))
    o = jobj_i64(o, "workspace_id", vec_get(rows.ws_ids, row))
    o = jobj_i64(o, "actor_id", vec_get(rows.actors, row))
    o = jobj_str(o, "actor_email", vec_get(rows.emails, row))
    o = jobj_str(o, "actor_name", vec_get(rows.names, row))
    o = jobj_str(o, "verb", vec_get(rows.verbs, row))
    o = jobj_i64(o, "node_id", vec_get(rows.node_ids, row))
    o = jobj_str(o, "path", vec_get(rows.paths, row))
    let meta = vec_get(rows.metas, row)
    o = tree_activity_meta_json(o, meta)
    let ts = vec_get(rows.tss, row)
    o = jobj_i64(o, "ts", ts)
    let iso = tree_activity_ts_iso(ts)
    if iso != "" {
        o = jobj_str(o, "at", iso)
    }
    return o
}

// Брой редове с този verb в пространството. verb идва само от
// activity_verbs() — непознат низ не се слага в SQL.
fn activity_verb_count(db: OrmDb, ws: i64, verb: str) -> OrmCount !IO !Net {
    if activity_verb_valid(verb) == 0 {
        return orm_count_sql(db, "SELECT 0 AS count")?
    }
    let mut sql = "SELECT COUNT(*) AS count FROM activity WHERE workspace_id = "
    sql = concat(sql, int_to_str(ws))
    sql = concat(sql, " AND verb = '")
    sql = concat(sql, verb)
    sql = concat(sql, "'")
    return orm_count_sql(db, sql)?
}
