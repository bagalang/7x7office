// tree/text.baga — извличане на текст от съдържание (за търсене).
// Общо за синхронния път (при качване/запис) и за фоновата задача
// extract-text (Фаза 6): подава се ext + bytes, връща се чист текст.
//
// Текстът е само за търсене — не е източник на истина. Затова се реже до
// разумен размер (SECP_TEXT_MAX_KB, подразбиране 256 KiB): ILIKE сканира
// цялата колона, а гигантски текст в базата не носи полза.

import "officebaga/office.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn tree_text_max_bytes() -> i64 !IO {
    let raw = env("SECP_TEXT_MAX_KB")?
    if raw == "" {
        return 262144
    }
    let n = parse_int(raw)
    if n < 1 {
        return 262144
    }
    return n * 1024
}

fn tree_text_cap(text: str, cap: i64) -> str {
    if len(text) <= cap {
        return text
    }
    return substr(text, 0, cap)
}

// "" когато форматът не е текстов/офис (снимки, pdf, zip, непознати).
fn tree_extract_text(ext: str, body: bytes) -> str !IO {
    if bytes_len(body) == 0 {
        return ""
    }
    let mut text = ""
    if ext == "txt" || ext == "md" || ext == "csv" || ext == "json" || ext == "html" || ext == "xml" {
        text = str_of_bytes(body)
    }
    if ext == "docx" || ext == "odt" || ext == "doc" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            text = office_to_markdown_rich(opened.doc)
            if text == "" {
                text = office_to_markdown(opened.doc)
            }
            if text == "" {
                text = office_plain_text(opened.doc)
            }
        }
    }
    if ext == "xlsx" || ext == "ods" || ext == "xls" {
        let opened = office_open_bytes(body)
        if opened.ok == 1 {
            text = office_plain_text(opened.doc)
        }
    }
    return tree_text_cap(text, tree_text_max_bytes()?)
}

// ---------- текстов индекс (tree_text) ----------

// owner/ws тук е скоупът на файла, не „кой го е качил": търсенето филтрира
// по workspace, за да не изтичат имена на файлове между пространства.
fn tree_text_find(db: OrmDb, node_id: i64) -> OrmQuery !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(node_id))
    return orm_query_params_str(db, "SELECT node_id, workspace_id, text FROM tree_text WHERE node_id = $1", vals)?
}

fn tree_text_drop(db: OrmDb, node_id: i64) -> i64 !IO !Net {
    let vals = vec_new()
    vec_push(vals, int_to_str(node_id))
    let e = orm_exec_params_str(db, "DELETE FROM tree_text WHERE node_id = $1", vals)?
    if orm_ok(e) == 0 {
        return -1
    }
    return 0
}

// Идемпотентно: при повторен запис текстът се презаписва. Записваме реда и
// при празен текст — иначе reindex не може да различи „вече индексиран, но
// без текст" от „още не е индексиран" и ще го нарежда вечно (виж gaps G14).
fn tree_text_put(db: OrmDb, node_id: i64, ws: i64, text: str) -> i64 !IO !Net {
    let ex = tree_text_find(db, node_id)?
    if orm_ok_q(ex) == 0 {
        return -1
    }
    if orm_nrows(ex) > 0 {
        let vals = vec_new()
        vec_push(vals, text)
        vec_push(vals, int_to_str(ws))
        vec_push(vals, int_to_str(node_id))
        // ВНИМАВАЙ: orm_update_by_id винаги бие по колона `id`, а тук PK е
        // `node_id` — затова е изричен UPDATE. workspace_id се обновява
        // също: файл, преместен между пространства (бъдеща функция), не
        // бива да оставя текста си в старото.
        let upd = orm_exec_params_str(orm_db_q(ex), "UPDATE tree_text SET text = $1, workspace_id = $2, updated_at = NOW() WHERE node_id = $3", vals)?
        if orm_ok(upd) == 0 {
            return -1
        }
        return 0
    }
    // boila няма DEFAULT/автоинкремент — id-то е ръчно, но тук PK е node_id.
    let cols = vec_new()
    vec_push(cols, "node_id")
    vec_push(cols, "workspace_id")
    vec_push(cols, "text")
    let vals = vec_new()
    vec_push(vals, int_to_str(node_id))
    vec_push(vals, int_to_str(ws))
    vec_push(vals, text)
    let ins = orm_insert_strs(orm_db_q(ex), "tree_text", cols, vals)?
    if orm_ok(ins) == 0 {
        return -1
    }
    return 0
}
